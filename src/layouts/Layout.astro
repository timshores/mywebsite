---
export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta
      name="description"
      content={description || "Tim Shores - Portfolio, resume, and current work"}
    >
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    >
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <a href="/" class="site-mark">Tim Shores</a>
        <nav aria-label="Main Navigation">
          <a href="/" class={`nav-tab ${currentPath === "/" ? "active" : ""}`}>About</a>
          <a href="/work" class={`nav-tab ${currentPath === "/work" ? "active" : ""}`}>Work</a>
          <a href="/contact" class={`nav-tab ${currentPath === "/contact" ? "active" : ""}`}>Contact</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --canvas: #f4f1e8;
    --paper: #fefcf7;
    --ink: #1f1f1c;
    --ink-soft: #524f45;
    --line: #d8d0c2;
    --accent: #b65c3d;
    --accent-2: #556a57;
    --card: rgba(255, 255, 255, 0.72);
    --shadow: rgba(31, 31, 28, 0.1);
  }

  body {
    font-family: "Space Grotesk", sans-serif;
    background:
      radial-gradient(circle at 10% 10%, #e8e0cf 0%, transparent 35%),
      radial-gradient(circle at 85% 20%, #e4efe8 0%, transparent 28%),
      var(--canvas);
    color: var(--ink);
    line-height: 1.6;
    min-height: 100vh;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0 1.5rem;
  }

  .site-mark {
    font-family: "Fraunces", serif;
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  nav {
    display: flex;
    gap: 0.5rem;
  }

  .nav-tab {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 500;
    border: 1px solid transparent;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    transition: all 0.2s ease;
  }

  .nav-tab:hover {
    border-color: var(--line);
    color: var(--ink);
    background: rgba(255, 255, 255, 0.45);
  }

  .nav-tab.active {
    color: #fff;
    background: linear-gradient(120deg, var(--accent) 0%, var(--accent-2) 100%);
  }

  main {
    border: 1px solid var(--line);
    background: var(--paper);
    border-radius: 22px;
    padding: 2rem;
    box-shadow: 0 20px 45px var(--shadow);
  }

  h1,
  h2,
  h3 {
    font-family: "Fraunces", serif;
    line-height: 1.15;
    color: var(--ink);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.7rem;
  }

  h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin: 2.25rem 0 1rem;
  }

  h3 {
    font-size: 1.2rem;
    margin-bottom: 0.45rem;
  }

  p {
    color: var(--ink-soft);
    margin-bottom: 0.9rem;
    max-width: 72ch;
  }

  a {
    color: var(--accent);
    font-weight: 500;
  }

  a:hover {
    color: var(--accent-2);
  }

  [data-expandable] {
    cursor: auto;
    user-select: text;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  [data-expandable]:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 4px;
  }

  [data-expandable].is-expanded {
    transform: translate(-6px, -6px) !important;
    border-color: var(--accent) !important;
    position: relative;
    z-index: 2;
    box-shadow:
      1px 1px 0 0 var(--accent),
      2px 2px 0 0 var(--accent),
      3px 3px 0 0 var(--accent),
      4px 4px 0 0 var(--accent),
      5px 5px 0 0 var(--accent),
      6px 6px 0 0 var(--accent),
      7px 7px 0 0 var(--accent),
      8px 8px 0 0 var(--accent),
      9px 9px 0 0 var(--accent),
      10px 10px 0 0 var(--accent) !important;
  }

  [data-expandable][data-keep-left-rail].is-expanded {
    border-left-color: var(--accent-2) !important;
  }

  @media (max-width: 760px) {
    .container {
      padding: 1rem;
    }

    .site-header {
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: 1rem;
    }

    nav {
      width: 100%;
      justify-content: space-between;
      gap: 0.35rem;
    }

    .nav-tab {
      flex: 1;
      text-align: center;
      padding: 0.5rem 0.7rem;
    }

    main {
      padding: 1.2rem;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const swappableImages = document.querySelectorAll("[data-image-swap]");
    for (const image of swappableImages) {
      if (!(image instanceof HTMLImageElement)) continue;
      const dotMatrixSrc = image.dataset.dotMatrixSrc || image.getAttribute("src") || "";
      const liveSrc = image.dataset.liveSrc || image.dataset.altSrc || "";

      if (!dotMatrixSrc || !liveSrc) continue;

      const samePath = (a, b) => {
        try {
          return new URL(a, window.location.href).pathname === new URL(b, window.location.href).pathname;
        } catch {
          return a === b;
        }
      };

      const syncPortraitMode = () => {
        const currentSrc = image.getAttribute("src") || "";
        const isDotMatrix = samePath(currentSrc, dotMatrixSrc);
        image.classList.toggle("is-dotmatrix", isDotMatrix);
        image.classList.toggle("is-live", !isDotMatrix);
      };

      syncPortraitMode();

      image.addEventListener("click", () => {
        const currentSrc = image.getAttribute("src") || "";
        const isDotMatrix = samePath(currentSrc, dotMatrixSrc);
        const nextSrc = isDotMatrix ? liveSrc : dotMatrixSrc;
        image.setAttribute("src", nextSrc);
        syncPortraitMode();
      });
    }

    const expandableNodes = document.querySelectorAll("[data-expandable]");
    for (const node of expandableNodes) {
      if (!(node instanceof HTMLElement)) continue;
      if (!node.hasAttribute("tabindex")) node.tabIndex = 0;
      if (!node.hasAttribute("role")) node.setAttribute("role", "button");
      if (!node.hasAttribute("aria-pressed")) node.setAttribute("aria-pressed", "false");
    }

    const setExpandedState = (node, expanded) => {
      node.classList.toggle("is-expanded", expanded);
      node.setAttribute("aria-pressed", expanded ? "true" : "false");
      if (!expanded) {
        for (const child of node.querySelectorAll("[data-expandable].is-expanded")) {
          if (!(child instanceof HTMLElement)) continue;
          child.classList.remove("is-expanded");
          child.setAttribute("aria-pressed", "false");
        }
      }
    };

    const shouldIgnoreEvent = (event) => {
      if (
        event.target instanceof Element &&
        event.target.closest("a, button, input, textarea, select, label")
      ) {
        return true;
      }
      const selection = window.getSelection?.();
      if (selection && !selection.isCollapsed) {
        return true;
      }
      return false;
    };

    document.addEventListener("click", (event) => {
      if (shouldIgnoreEvent(event)) return;
      const target = event.target instanceof Element
        ? event.target.closest("[data-expandable]")
        : null;
      if (!(target instanceof HTMLElement)) return;
      const next = !target.classList.contains("is-expanded");
      setExpandedState(target, next);
    });

    document.addEventListener("keydown", (event) => {
      if (!(event.target instanceof HTMLElement)) return;
      const target = event.target.closest("[data-expandable]");
      if (!(target instanceof HTMLElement)) return;
      if (event.key !== "Enter" && event.key !== " ") return;
      event.preventDefault();
      const next = !target.classList.contains("is-expanded");
      setExpandedState(target, next);
    });
  });
</script>
