---
export interface Props {
    title: string;
    description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description || "Tim Shores - Data Storyteller & Communication Strategist"}>
    <title>{title}</title>
</head>
<body>
    <div class="container">
        <nav>
            <a href="/" class={`nav-tab nav-tab-left ${(currentPath === '/' || currentPath === '') ? 'active' : ''}`}>About</a>
            <a href="/work" class={`nav-tab nav-tab-middle ${currentPath === '/work' ? 'active' : ''}`}>Work</a>
            <a href="/contact" class={`nav-tab nav-tab-right ${currentPath === '/contact' ? 'active' : ''}`}>Contact</a>
        </nav>

        <main>
            <slot />
        </main>
    </div>
</body>
</html>

<style is:global>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    :root {
        --manila: #F5E6D3;
        --manila-dark: #E8D5BE;
        --ink: #1a1a1a;
        --ink-light: #574a3a;
        --ink-fade: #6b5d4f;
        --accent: #D35545;
        --paper: #FDFBF7;
        --line: #E5DDD2;
        --card: #FAF7F2;
        
        /* Keeping your original color variables for compatibility */
        --color-border: var(--line);
        --color-card: var(--card);
        --color-text: var(--ink);
        --color-accent: var(--accent);
        --color-highlight: var(--manila);
    }

    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background: var(--paper);
        color: var(--ink);
        line-height: 1.6;
        overflow-x: hidden;
    }

    /* Container */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        min-height: 100vh;
        position: relative;
        padding-left: 140px; /* Space for margin line */
    }

    /* Red margin line - positioned where writing starts */
    .container::before {
        content: '';
        position: absolute;
        left: 100px;
        top: 0;
        bottom: 0;
        width: 1px;
        background: var(--accent);
        opacity: 0.4;
    }

    /* Navigation - modern take on folder tabs */
    nav {
        display: flex;
        gap: 0;
        margin: 3rem 0 0 0;
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--paper);
        padding-top: 1rem;
        padding-bottom: 5px;
    }

    .nav-tab {
        background: var(--manila);
        border: none;
        padding: 1rem 3rem;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--ink-light);
        position: relative;
        transition: all 0.2s ease;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        text-decoration: none;
        display: inline-block;
        flex: 1;
        text-align: center;
    }

    .nav-tab-left {
        clip-path: polygon(0 0, 100% 0, calc(100% - 40px) 100%, 40px 100%);
        margin-right: -40px;
    }

    .nav-tab-middle {
        clip-path: polygon(40px 0, calc(100% - 40px) 0, 100% 100%, 0 100%);
        margin-right: -40px;
    }

    .nav-tab-right {
        clip-path: polygon(0 0, 100% 0, calc(100% - 40px) 100%, 40px 100%);
    }

    .nav-tab:hover {
        background: var(--manila-dark);
        transform: translateY(-2px);
        color: var(--ink-light);
    }

    .nav-tab.active {
        background: var(--paper);
        color: var(--ink);
        z-index: 10;
        font-weight: 600;
    }

    /* Main content area */
    main {
        background: var(--paper);
        padding: 4rem 2rem;
        margin-top: -1px;
        position: relative;
        animation: fadeIn 0.4s ease;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Typography */
    h1 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
    }

    h2 {
        font-size: 1.875rem;
        font-weight: 600;
        margin: 2.5rem 0 1rem;
        color: var(--ink);
        border-bottom: 1px solid var(--line);
        padding-bottom: 0.5rem;
    }

    h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--ink);
    }

    p {
        margin-bottom: 1rem;
        color: var(--ink-light);
        max-width: 65ch;
        line-height: 1.6;
    }

    /* Links */
    a {
        color: var(--accent);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s ease;
    }

    a:hover {
        color: var(--ink);
        text-decoration: underline;
    }

    /* Highlight text */
    .highlight {
        position: relative;
        z-index: 1;
    }

    .highlight::after {
        content: '';
        position: absolute;
        left: -2px;
        right: -2px;
        bottom: 0;
        height: 40%;
        background: var(--manila);
        z-index: -1;
        opacity: 0.5;
    }

    /* Mobile responsive */
    @media (max-width: 768px) {
        .container {
            padding-left: 80px;
        }

        .container::before {
            left: 50px;
        }

        nav {
            flex-wrap: nowrap;
            gap: 0;
            margin: 1.5rem 0 0 0;
        }

        .nav-tab {
            padding: 0.75rem 2rem;
            font-size: 0.8rem;
        }

        .nav-tab-left {
            clip-path: polygon(0 0, 100% 0, calc(100% - 30px) 100%, 30px 100%);
            margin-right: -30px;
        }

        .nav-tab-middle {
            clip-path: polygon(30px 0, calc(100% - 30px) 0, 100% 100%, 0 100%);
            margin-right: -30px;
        }

        .nav-tab-right {
            clip-path: polygon(0 0, 100% 0, calc(100% - 30px) 100%, 30px 100%);
        }

        main {
            padding: 2rem 1rem;
        }

        h1 {
            font-size: 2rem;
        }
    }
</style>