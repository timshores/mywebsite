---
export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta
      name="description"
      content={description || "Tim Shores - Portfolio, resume, and current work"}
    >
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Karla:ital,wght@0,400..700;1,400..700&family=Besley:wght@400..700&display=swap"
      rel="stylesheet"
    >
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <a href="/" class="site-mark">Tim Shores</a>
        <nav aria-label="Main Navigation">
          <a href="/" class={`nav-tab ${currentPath === "/" ? "active" : ""}`}>About</a>
          <a href="/work" class={`nav-tab ${currentPath === "/work" ? "active" : ""}`}>Work</a>
          <a href="/portfolio" class={`nav-tab ${currentPath === "/portfolio" ? "active" : ""}`}>Portfolio</a>
          <a href="/contact" class={`nav-tab ${currentPath === "/contact" ? "active" : ""}`}>Contact</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --canvas: #f4f1e8;
    --paper: #fefcf7;
    --ink: #1f1f1c;
    --ink-soft: #524f45;
    --line: #d8d0c2;
    --accent: #b65c3d;
    --accent-2: #556a57;
    --card: rgba(255, 255, 255, 0.72);
    --shadow: rgba(31, 31, 28, 0.1);
  }

  body {
    font-family: "Karla", sans-serif;
    background:
      radial-gradient(circle at 10% 10%, #e8e0cf 0%, transparent 35%),
      radial-gradient(circle at 85% 20%, #e4efe8 0%, transparent 28%),
      var(--canvas);
    color: var(--ink);
    line-height: 1.6;
    min-height: 100vh;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0 1.5rem;
  }

  .site-mark {
    font-family: "Besley", serif;
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  nav {
    display: flex;
    gap: 0.5rem;
  }

  .nav-tab {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 500;
    border: 1px solid transparent;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    transition: all 0.2s ease;
  }

  .nav-tab:hover {
    border-color: var(--line);
    color: var(--ink);
    background: rgba(255, 255, 255, 0.45);
  }

  .nav-tab.active {
    color: #fff;
    background: linear-gradient(120deg, var(--accent) 0%, var(--accent-2) 100%);
  }

  main {
    border: 1px solid var(--line);
    background: var(--paper);
    border-radius: 22px;
    padding: 2rem;
    box-shadow: 0 20px 45px var(--shadow);
  }

  h1,
  h2,
  h3 {
    font-family: "Besley", serif;
    line-height: 1.15;
    color: var(--ink);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.7rem;
  }

  h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin: 2.25rem 0 1rem;
  }

  h3 {
    font-size: 1.2rem;
    margin-bottom: 0.45rem;
  }

  p {
    color: var(--ink-soft);
    margin-bottom: 0.9rem;
    max-width: 72ch;
  }

  a {
    color: var(--accent);
    font-weight: 500;
  }

  a:hover {
    color: var(--accent-2);
  }

  @media (max-width: 760px) {
    .container {
      padding: 1rem;
    }

    .site-header {
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: 1rem;
    }

    nav {
      width: 100%;
      justify-content: space-between;
      gap: 0.35rem;
    }

    .nav-tab {
      flex: 1;
      text-align: center;
      padding: 0.5rem 0.7rem;
    }

    main {
      padding: 1.2rem;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Links to other sites, and to files hosted here (PDFs, spreadsheets, documents),
    // open in a new tab, including links that scripts add later. Downloads, mailto: and
    // links that set a target stay as they are; data-same-tab opts a link out.
    const hostedFile = /\.(pdf|csv|xlsx?|docx?|pptx?|zip|json|txt)$/i;
    const openInNewTab = (a) => {
      if (!(a instanceof HTMLAnchorElement) || a.hasAttribute("target") || a.hasAttribute("download")
        || a.hasAttribute("data-same-tab")) return;
      let url;
      try { url = new URL(a.href); } catch { return; }
      if (!/^https?:$/.test(url.protocol)) return;
      if (url.origin === window.location.origin && !hostedFile.test(url.pathname)) return;
      a.target = "_blank";
      a.rel = [...new Set([...a.rel.split(/\s+/).filter(Boolean), "noopener", "noreferrer"])].join(" ");
    };
    document.querySelectorAll("a[href]").forEach(openInNewTab);
    new MutationObserver((records) => {
      for (const r of records) for (const n of r.addedNodes) {
        if (n instanceof HTMLAnchorElement) openInNewTab(n);
        else if (n instanceof Element) n.querySelectorAll("a[href]").forEach(openInNewTab);
      }
    }).observe(document.body, { childList: true, subtree: true });

    const swappableImages = document.querySelectorAll("[data-image-swap]");
    for (const image of swappableImages) {
      if (!(image instanceof HTMLImageElement)) continue;
      const dotMatrixSrc = image.dataset.dotMatrixSrc || image.getAttribute("src") || "";
      const liveSrc = image.dataset.liveSrc || image.dataset.altSrc || "";

      if (!dotMatrixSrc || !liveSrc) continue;

      const samePath = (a, b) => {
        try {
          return new URL(a, window.location.href).pathname === new URL(b, window.location.href).pathname;
        } catch {
          return a === b;
        }
      };

      const syncPortraitMode = () => {
        const currentSrc = image.getAttribute("src") || "";
        const isDotMatrix = samePath(currentSrc, dotMatrixSrc);
        image.classList.toggle("is-dotmatrix", isDotMatrix);
        image.classList.toggle("is-live", !isDotMatrix);
      };

      syncPortraitMode();

      image.addEventListener("click", () => {
        const currentSrc = image.getAttribute("src") || "";
        const isDotMatrix = samePath(currentSrc, dotMatrixSrc);
        const nextSrc = isDotMatrix ? liveSrc : dotMatrixSrc;
        image.setAttribute("src", nextSrc);
        syncPortraitMode();
      });
    }
  });
</script>
