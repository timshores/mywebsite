---
import Layout from "../../layouts/Layout.astro";
// Written by the pipeline (timshores/schools, export_explorer_data.py write_groups) and read only here,
// when the site is built, so the explorer itself doesn't carry the member lists
import groups from "../../data/massppe/groups.json";

// The explorer's own meta, read here at build only: cohort ranges, the town peer groups, the cities set
// apart, and the income fifths' cut points, so this page states the same lines the explorer draws
import explorer from "../../data/massppe/explorer.json";
import towns from "../../data/massppe/towns.json";
import mapData from "../../data/massppe/map.json";

type Group = { id: string; name: string; scope: string; members: { id: string; name: string }[] };
const all = groups as Record<"districts" | "towns", Group[]>;

// Sources, linked where a note names them
const a = (href: string, text: string) => `<a href="${href}">${text}</a>`;
const HUB = a("https://educationtocareer.data.mass.gov/d/er3w-dyti", "District Expenditures by Spending Category");
const E2C = a("https://educationtocareer.data.mass.gov/", "Education-to-Career data");
const C70 = a("https://www.doe.mass.edu/finance/chapter70/default.html", "Chapter 70 district profiles");
const REPORT = a("/artifacts/western-ma-ppe-report-fy2025.pdf", "the Western MA per-pupil expenditure report");
const GATEWAY = a("https://www.mass.gov/doc/gatewaycitiesdocx/download", "the Commonwealth's list");
const RURAL_AID = a("https://www.doe.mass.edu/finance/chapter70/foundation/fy2026-rural-school-aid.html", "DESE's rural school aid");
const MAPC = a("https://www.mapc.org/wp-content/uploads/2017/09/Massachusetts-Community-Types-Summary-July_2008.pdf", "community types");
const RURAL_PLAN = a("https://berkshireplanning.org/wp-content/uploads/program_documents/brpc_initiative/massachusetts-rural-policy-plan/default/Rural_Policy_Plan_Launch_Presentation.pdf", "Rural Policy Plan");
const LAND = a("https://www2.census.gov/geo/tiger/GENZ2023/shp/cb_2023_25_cousub_500k.zip", "2023 cartographic boundaries");
const FORMULA = a("https://www.doe.mass.edu/finance/chapter70/fy2027/chapter-2027.xlsm", "FY2027 Chapter 70 formula");
const POP = a("https://www.census.gov/programs-surveys/popest.html", "population estimates");
const DLS = a("https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=ScheduleA.GenFund_MAIN", "Schedule A");

// The numbers in the notes, from the data
const meta = explorer.meta;
const latest = meta.latest;
const num = (n: number) => n.toLocaleString("en-US");
const usd = (n: number) => `$${num(n)}`;
const SIZES = ["TINY", "SMALL", "MEDIUM", "LARGE", "XLARGE"] as const;
const sizes = SIZES.map((k) => {
  const c = (meta.cohorts as Record<string, { label: string; range: (number | null)[] | null }>)[k];
  const [lo, hi] = c.range!;
  const name = c.label.split(" (")[0];
  return `${name} ${lo === 0 ? `up to ${num(hi!)}` : hi == null ? `over ${num(lo! - 1)}` : `${num(lo!)}–${num(hi)}`}`;
}).join(", ");
const and = (xs: string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}`);
const pct = (x: number) => `${Math.round(x * 100)}%`;
// The very large districts, largest first, and their share of the pupils in traditional districts
type ListedDistrict = { id: string; name: string; type: string; cohort: string | null; region: string | null; fte: number };
const traditional = (explorer.districts as ListedDistrict[]).filter((d) => d.type === "traditional");
const big = traditional.filter((d) => d.cohort === "XLARGE").sort((x, y) => y.fte - x.fte);
const pupils = traditional.reduce((n, d) => n + d.fte, 0);
const bigShare = pct(big.reduce((n, d) => n + d.fte, 0) / pupils);
const largestShare = pct(big[0].fte / pupils);
const pooledN = traditional.length - big.length;
const regionNames = meta.regions as Record<string, string>;
// Which of them each region leaves out, in the explorer's order of regions
const byRegion = Object.entries(regionNames).map(([rk, rl]) => [rl, big.filter((d) => d.region === rk).map((d) => d.name)] as const)
  .filter(([, names]) => names.length).map(([rl, names]) => `${and(names)} in ${rl === "Boston area" ? "the Boston area" : rl}`).join("; ");
// The cities set apart on the Towns tab, and their share of the state's residents
const apart = towns.meta.apart as string[];
const townFiles = import.meta.glob<{ default: { towns: { kind: string; name: string; pop: (number | null)[] }[] } }>(
  "../../data/massppe/towns/*.json", { eager: true });
const latestPop = Object.values(townFiles).flatMap((f) => f.default.towns).filter((t) => t.kind === "town")
  .map((t) => ({ name: t.name, pop: t.pop[t.pop.length - 1] ?? 0 }));
const residents = latestPop.reduce((n, t) => n + t.pop, 0);
const apartShare = pct(latestPop.filter((t) => apart.includes(t.name)).reduce((n, t) => n + t.pop, 0) / residents);
const peers = (towns.meta.peers as { label: string }[]).map((p) => p.label.replace(/ residents$/, "")).join("; ");
const fifths = mapData.meta.fifths as { towns: number[]; districts: number[]; year: number };
const fifthText = (c: number[]) => `lowest, under ${usd(c[0])}; second, ${usd(c[0])}–${usd(c[1] - 1)}; middle, ` +
  `${usd(c[1])}–${usd(c[2] - 1)}; fourth, ${usd(c[2])}–${usd(c[3] - 1)}; highest, ${usd(c[3])} and up`;
const spread = (view: "districts" | "towns", scope: string) => {
  const ns = all[view].filter((g) => g.scope === scope).map((g) => g.members.length);
  const lo = Math.min(...ns), hi = Math.max(...ns);
  return { total: ns.reduce((x, y) => x + y, 0), per: lo === hi ? `${lo}` : `${lo} or ${hi}` };
};
const dFifth = spread("districts", "fifth");
const tFifth = spread("towns", "fifth");
const gatewayN = all.districts.find((g) => g.scope === "group")?.members.length ?? 26;

// The explorer's averages by kind, in the order its menus list them, each with how it's drawn and from what;
// a kind not named here still shows
const KINDS: Record<"districts" | "towns", [string, string, string][]> = {
  districts: [
    ["state", "Statewide", `Two statewide averages of the traditional districts, those run by a city or town, or by ` +
      `several towns together, rather than vocational schools or charter schools: one without the ${big.length} very ` +
      `large ones, those with more than 10,000 in-district pupils, and one with them. The ${big.length} are ` +
      `${and(big.map((d) => d.name))}. Together they teach ${bigShare} of the pupils in traditional districts, so in an ` +
      `average weighted by pupils they carry ${bigShare} of its weight between them, ${big[0].name} ${largestShare} on ` +
      `its own. The average without them, the explorer's usual comparison, follows ${REPORT}, which left Springfield ` +
      `out of its Western MA average; it covers the other ${pooledN}. The average with them covers all ` +
      `${traditional.length}. The ${big.length} also have an average of their own: Very large, under Cohorts. ` +
      `Spending averages weight each district by its in-district pupils (full-time ` +
      `equivalents); Chapter 70 averages, by foundation enrollment. The figures come from the state's Department of ` +
      `Elementary and Secondary Education (DESE): its ${HUB} and its ${C70}.`],
    ["region", "Regions", "The six regions of the state's Executive Office of Health and Human Services (EOHHS), each " +
      `district in the one DESE assigns it in its ${E2C}. Each region's average covers its traditional districts but ` +
      "not its very large ones, those with more than 10,000 pupils, which would weigh heavily in an average weighted by " +
      `pupils: ${byRegion}.`],
    ["cohort", "Cohorts", `Traditional districts by FY${latest} in-district pupils: ${sizes}. The boundaries are those ` +
      `${REPORT} set from FY2024 Western MA enrollment. Vocational and technical districts and charter schools are ` +
      `cohorts of their own. Very large is the ${big.length} named under Statewide. Enrollment comes from DESE's ${HUB}.`],
    ["region-cohort", "Cohorts by region", "Each cohort within each region, where at least three districts share both. " +
      "Where they don't, “Its cohort in its region” compares with the cohort statewide."],
    ["group", "Gateway Cities", `The ${gatewayN} cities on ${GATEWAY} of Gateway Cities, from 2014. State law (M.G.L. ` +
      "c. 23A, § 3A) defines one as a city of 35,000 to 250,000 residents whose median household income and share of " +
      "adults with a bachelor's degree are both below the state's. Their districts are in their size cohorts too."],
    ["type", "Community types", "Rural: 35 or fewer students per square mile, counting a district's foundation " +
      `enrollment over its towns' land area. It's the test for ${RURAL_AID} (which also requires income below the ` +
      "state average), and DESE splits it in three tiers: 11 or fewer, over 11 to 21, and over 21 to 35. Inner Core: " +
      "Boston and its densest neighbors, the Metropolitan Area Planning Council's Metropolitan Core Communities and " +
      `Streetcar Suburbs in its ${MAPC}. Gateway Cities outside the Inner Core: the other 22. Suburban and other: the ` +
      `rest, which the state doesn't name. Land areas come from the Census Bureau's ${LAND}.`],
    ["fifth", "Income fifths", `The ${dFifth.total} traditional districts ranked by their towns' combined income per ` +
      `resident, ${dFifth.per} to a fifth: ${fifthText(fifths.districts)}. Income per resident is the residents' ` +
      `income the ${FORMULA} uses, from ${fifths.year} state tax returns, divided by the Census Bureau's ` +
      `${POP.replace("estimates", "estimate")} for July ${fifths.year}.`],
  ],
  towns: [
    ["state", "Statewide", `Two statewide averages: one without the ${apart.length} cities whose school districts have ` +
      `more than 10,000 pupils, and one with them. The ${apart.length} are ${and(apart)}. They're home to ` +
      `${apartShare} of the state's residents, so in an average that pools dollars and residents they carry ` +
      `${apartShare} of its weight. The average without them, the explorer's usual comparison, covers the other ` +
      `${latestPop.length - apart.length}; the average with them, all ${latestPop.length}. Each average pools its towns: their ` +
      `combined dollars over their combined residents. Budgets come from the Division of Local Services' ${DLS}, and ` +
      `population from the Census Bureau's ${POP}.`],
    ["region", "Regions", "The same six EOHHS regions: a town's region is its school district's, or, for the few towns " +
      "without one, its county's. Each region's average leaves out its cities whose school districts have more than " +
      `10,000 pupils: ${byRegion}.`],
    ["peer", "Peer groups by population", `Towns by the Census Bureau's estimate of their population on July 1, ` +
      `${towns.meta.peer_year}: ${peers}. The ${apart.length} cities whose school districts have more than 10,000 ` +
      "pupils are in none."],
    ["region-peer", "Peer groups by population and region", "Each peer group within each region, where at least three " +
      "towns share both. Where they don't, “Its peer group in its region” compares with the peer group statewide."],
    ["group", "Gateway Cities", `The same ${gatewayN} cities, including those whose school districts have ` +
      "more than 10,000 pupils."],
    ["type", "Community types", `Rural: under 500 residents per square mile, the line in the ${RURAL_PLAN} for the ` +
      "Commonwealth's Rural Policy Advisory Commission. Inner Core, Gateway Cities outside the Inner Core, and Suburban " +
      `and other are defined as they are for districts, above. Land areas come from the Census Bureau's ${LAND}.`],
    ["fifth", "Income fifths", `All ${tFifth.total} cities and towns ranked by income per resident, ${tFifth.per} to a ` +
      `fifth: ${fifthText(fifths.towns)}. Income per resident is figured as it is for districts, above.`],
  ],
};
const VIEWS = [
  { key: "districts" as const, title: "School districts", one: "district", many: "districts", href: (id: string) => `/muni-spending/?d=${id}` },
  { key: "towns" as const, title: "Cities and towns", one: "town", many: "towns", href: (id: string) => `/muni-spending/?view=towns&t=${id}` },
];
const sections = VIEWS.map((v) => {
  const mine = all[v.key];
  const named = new Set(KINDS[v.key].map(([scope]) => scope));
  const kinds = [...KINDS[v.key], ...[...new Set(mine.map((g) => g.scope))].filter((s) => !named.has(s)).map((s) => [s, "Other", ""])]
    .map(([scope, title, note]) => ({ title, note, groups: mine.filter((g) => g.scope === scope) }))
    .filter((k) => k.groups.length);
  return { ...v, kinds };
});
---

<Layout title="Groups and their members - Tim Shores"
  description="Every average the Massachusetts municipal spending explorer compares with, and the districts and towns in each">
  <p class="back"><a href="/muni-spending/">Municipal spending explorer</a></p>
  <h1>Groups and their members</h1>
  <p class="lede">
    This page lists the averages the explorer compares with: how each kind is drawn, from which sources, and the
    districts and towns in each. The explorer's <a href="/muni-spending/?view=data">Data tab</a> has the rest of its
    sources. All the groups and their members are in one <a href="/muni-spending/data/groups.csv" download>CSV file</a>.
  </p>
  <!-- Stays at the top as the page scrolls: the sections, and the dial that hides the explanations -->
  <div class="bar">
    <nav class="jump" aria-label="Sections">
      {sections.map((v) => <a href={`#${v.key}`}>{v.title}</a>)}
    </nav>
    <button type="button" class="dial" id="notes-dial" role="switch" aria-checked="true">
      <span class="dial-label">Explanations</span>
      <span class="dial-face" aria-hidden="true"><span class="dial-pointer"></span></span>
      <span class="dial-state" aria-hidden="true">On</span>
    </button>
  </div>

  {sections.map((v) => (
    <section id={v.key} class="view">
      <h2>{v.title}</h2>
      {v.kinds.map((k) => (
        <>
          <h3>{k.title}</h3>
          {k.note && <p class="note" set:html={k.note} />}
          {k.groups.map((g) => (
            <details id={g.id}>
              <summary>
                <span class="name">{g.name}</span>
                <span class="count">{g.members.length} {g.members.length === 1 ? v.one : v.many}</span>
              </summary>
              <ul class="members">
                {g.members.map((m) => <li><a href={v.href(m.id)}>{m.name}</a></li>)}
              </ul>
            </details>
          ))}
        </>
      ))}
    </section>
  ))}
</Layout>

<script is:inline>
  // A link to one group (the explorer's, beside Compare with) opens it
  const openTarget = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
      target.scrollIntoView({ block: "start" });
    }
  };
  openTarget();
  window.addEventListener("hashchange", openTarget);

  // Explanations on or off: off leaves the headings and the groups
  const dial = document.getElementById("notes-dial");
  dial.addEventListener("click", () => {
    const on = dial.getAttribute("aria-checked") !== "true";
    dial.setAttribute("aria-checked", String(on));
    dial.querySelector(".dial-state").textContent = on ? "On" : "Off";
    document.body.classList.toggle("notes-off", !on);
  });
</script>

<style>
  .back {
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }

  .back a::before {
    content: "← ";
  }

  .lede {
    max-width: none;
  }

  /* The bar: section links at the left, the dial at the right, held at the top of the screen */
  .bar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    margin: 0.4rem 0 0.5rem;
    padding: 0.5rem 0;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .jump {
    display: flex;
    gap: 1.25rem;
    font-size: 0.95rem;
  }

  /* The dial: a knob turned right for on, left for off, as on the explorer's Detail dial */
  .dial {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: none;
    border: 0;
    padding: 0.25rem 0.35rem;
    cursor: pointer;
  }

  .dial:hover {
    color: var(--ink);
  }

  .dial:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
    border-radius: 6px;
  }

  .dial-face {
    position: relative;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1.5px solid var(--ink-soft);
    background: radial-gradient(circle at 40% 35%, #fff 0%, #efe8dc 75%);
    box-shadow: 0 1px 2px rgba(31, 31, 28, 0.25);
    transform: rotate(50deg);
    transition: transform 0.25s ease;
  }

  .dial-pointer {
    position: absolute;
    top: 2px;
    left: 50%;
    width: 3px;
    height: 9px;
    border-radius: 2px;
    background: var(--accent);
    transform: translateX(-50%);
  }

  .dial[aria-checked="false"] .dial-face {
    transform: rotate(-50deg);
  }

  .dial[aria-checked="false"] .dial-pointer {
    background: var(--ink-soft);
  }

  .dial-state {
    min-width: 1.6em;
    text-align: left;
  }

  @media (prefers-reduced-motion: reduce) {
    .dial-face {
      transition: none;
    }
  }

  :global(body.notes-off) .note {
    display: none;
  }

  /* Headings jumped to land below the bar, which wraps to two lines on a phone */
  .view,
  details {
    scroll-margin-top: 6rem;
  }

  h3 {
    margin: 1.6rem 0 0.4rem;
    font-size: 1.05rem;
    color: var(--ink-soft);
  }

  /* How each kind is drawn: the body's own type, a little smaller, above its groups, the page's full width */
  .note {
    max-width: none;
    font-size: 0.92rem;
    margin-bottom: 0.6rem;
  }

  details {
    border-top: 1px solid var(--line);
  }

  details:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.75rem;
    padding: 0.5rem 0;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::before {
    content: "▸";
    width: 0.8rem;
    color: var(--ink-soft);
  }

  details[open] summary::before {
    content: "▾";
  }

  summary:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .name {
    color: var(--ink);
    font-weight: 600;
  }

  .count {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .members {
    list-style: none;
    columns: 13rem auto;
    column-gap: 1.5rem;
    margin: 0 0 0.9rem 1.55rem;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .members li {
    break-inside: avoid;
  }

  .members a {
    font-weight: 400;
    text-decoration: none;
  }

  .members a:hover {
    text-decoration: underline;
  }
</style>
