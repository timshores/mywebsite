---
import Layout from "../../layouts/Layout.astro";
// Written by the pipeline (timshores/schools, export_explorer_data.py write_groups) and read only here,
// when the site is built, so the explorer itself doesn't carry the member lists
import groups from "../../data/massppe/groups.json";

type Group = { id: string; name: string; scope: string; members: { id: string; name: string }[] };

// The explorer's averages by kind, in the order its menus list them; a kind not named here still shows
const KINDS: Record<"districts" | "towns", [string, string][]> = {
  districts: [["state", "Statewide"], ["region", "Regions"], ["cohort", "Cohorts"], ["region-cohort", "Cohorts by region"],
    ["group", "Gateway Cities"], ["type", "Community types"], ["fifth", "Income fifths"]],
  towns: [["state", "Statewide"], ["region", "Regions"], ["peer", "Peer groups"], ["region-peer", "Peer groups by region"],
    ["group", "Gateway Cities"], ["type", "Community types"], ["fifth", "Income fifths"]],
};
const VIEWS = [
  { key: "districts" as const, title: "School districts", one: "district", many: "districts", href: (id: string) => `/muni-spending/?d=${id}` },
  { key: "towns" as const, title: "Cities and towns", one: "town", many: "towns", href: (id: string) => `/muni-spending/?view=towns&t=${id}` },
];
const sections = VIEWS.map((v) => {
  const all = (groups as Record<string, Group[]>)[v.key];
  const named = new Set(KINDS[v.key].map(([scope]) => scope));
  const kinds = [...KINDS[v.key], ...[...new Set(all.map((g) => g.scope))].filter((s) => !named.has(s)).map((s) => [s, "Other"])]
    .map(([scope, title]) => ({ title, groups: all.filter((g) => g.scope === scope) }))
    .filter((k) => k.groups.length);
  return { ...v, kinds };
});
---

<Layout title="Groups and their members - Tim Shores"
  description="Every average the Massachusetts municipal spending explorer compares with, and the districts and towns in each">
  <p class="back"><a href="/muni-spending/">Municipal spending explorer</a></p>
  <h1>Groups and their members</h1>
  <p class="lede">
    The averages the explorer compares with, and the districts and towns in each. How each group is drawn is in the
    explorer's <a href="/muni-spending/?view=data">Data tab</a>. All of it in one file:
    <a href="/muni-spending/data/groups.csv" download>CSV</a>.
  </p>
  <nav class="jump" aria-label="Sections">
    {sections.map((v) => <a href={`#${v.key}`}>{v.title}</a>)}
  </nav>

  {sections.map((v) => (
    <section id={v.key} class="view">
      <h2>{v.title}</h2>
      {v.kinds.map((k) => (
        <>
          <h3>{k.title}</h3>
          {k.groups.map((g) => (
            <details id={g.id}>
              <summary>
                <span class="name">{g.name}</span>
                <span class="count">{g.members.length} {g.members.length === 1 ? v.one : v.many}</span>
              </summary>
              <ul class="members">
                {g.members.map((m) => <li><a href={v.href(m.id)}>{m.name}</a></li>)}
              </ul>
            </details>
          ))}
        </>
      ))}
    </section>
  ))}
</Layout>

<script is:inline>
  // A link to one group (the explorer's, beside Compare with) opens it
  const openTarget = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
      target.scrollIntoView({ block: "start" });
    }
  };
  openTarget();
  window.addEventListener("hashchange", openTarget);
</script>

<style>
  .back {
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }

  .back a::before {
    content: "← ";
  }

  .lede {
    max-width: 62ch;
  }

  .jump {
    display: flex;
    gap: 1.25rem;
    margin: 0.4rem 0 0.5rem;
    font-size: 0.95rem;
  }

  .view {
    scroll-margin-top: 1rem;
  }

  h3 {
    margin: 1.6rem 0 0.4rem;
    font-size: 1.05rem;
    color: var(--ink-soft);
  }

  details {
    border-top: 1px solid var(--line);
    scroll-margin-top: 1rem;
  }

  details:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.75rem;
    padding: 0.5rem 0;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::before {
    content: "▸";
    width: 0.8rem;
    color: var(--ink-soft);
  }

  details[open] summary::before {
    content: "▾";
  }

  summary:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .name {
    color: var(--ink);
    font-weight: 600;
  }

  .count {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .members {
    list-style: none;
    columns: 13rem auto;
    column-gap: 1.5rem;
    margin: 0 0 0.9rem 1.55rem;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .members li {
    break-inside: avoid;
  }

  .members a {
    font-weight: 400;
    text-decoration: none;
  }

  .members a:hover {
    text-decoration: underline;
  }
</style>
