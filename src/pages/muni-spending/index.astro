  /* Cautions: the pitfalls a pair falls into, under the finding */
  .explorer :global(.cw-cautions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.45rem;
    margin-top: 0.35rem;
    font-size: 0.8rem;
  }

  .explorer :global(.cw-cautions-lead) {
    color: var(--ink-soft);
  }

  .explorer :global(.cw-caution) {
    font: inherit;
    font-size: 0.78rem;
    color: #8a3f22;
    background: #fbf1ec;
    border: 1px solid #ecc8b8;
    border-radius: 999px;
    padding: 0.12rem 0.6rem;
    cursor: pointer;
  }

  .explorer :global(.cw-caution::before) {
    content: "⚠ ";
  }

  .explorer :global(.cw-caution.quiet) {
    color: var(--ink-soft);
    background: #fff;
    border-color: var(--line);
  }

  .explorer :global(.cw-caution.quiet::before) {
    content: "";
  }

  /* A pair that counts the same thing: marked and set back in the Horizontal list */
  .explorer :global(.cw-bar.is-built) {
    color: var(--muted);
  }

  .explorer :global(.cw-built) {
    color: #8a3f22;
  }

  .explorer :global(.cw-bar:disabled) {
    cursor: default;
    color: var(--muted);
  }




  .explorer :global(.cw-sub) {
    width: min(760px, 94vw);
    max-width: none;
    max-height: 86vh;
    margin: auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .explorer :global(.cw-sub[open]) {
    display: flex;
    flex-direction: column;
  }

  .explorer :global(.cw-sub::backdrop) {
    background: rgba(31, 31, 28, 0.35);
  }

  .explorer :global(.cw-sub-body) {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0 1.2rem 1.2rem;
  }

  .explorer :global(.cw-sub-body .cap-steps-table) {
    margin: 0.2rem 0 0.9rem;
    font-size: 0.84rem;
  }

  .explorer :global(.cw-sub-body .cap-steps-table th),
  .explorer :global(.cw-sub-body .cap-steps-table td) {
    padding: 0.22rem 0.6rem;
  }

  .explorer :global(.cw-sub-body h4) {
    font-size: 0.95rem;
    margin: 1rem 0 0.3rem;
  }

  .explorer :global(.cw-sub-body h4:first-child) {
    margin-top: 0.2rem;
  }

  .explorer :global(.cw-sub-body p) {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 0.6rem;
  }

  .explorer :global(.cw-sub-note) {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0 0 0.6rem;
  }




  .explorer :global(.cw-bars-key) {
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
    display: grid;
    gap: 0.15rem;
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--ink-soft);
  }

  .explorer :global(.cw-bars-key li) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .explorer :global(.cw-bars-swatch) {
    flex: none;
    width: 12px;
    height: 6px;
    border-radius: 3px;
    background: #2a78d6;
  }

  .explorer :global(.cw-bars-swatch.neg) {
    background: #eb6834;
  }

  .explorer :global(.cw-help) {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1.05rem;
    height: 1.05rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 50%;
    background: #fff;
    cursor: help;
  }

  .explorer :global(.cw-help:hover::after),
  .explorer :global(.cw-help:focus::after) {
    content: attr(data-tip);
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    /* --tip-dx keeps it inside the window (explorer.ts, placeTip) */
    transform: translateX(calc(-50% + var(--tip-dx, 0px)));
    z-index: 5;
    width: 16rem;
    padding: 0.5rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--ink);
    text-align: left;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 6px 18px var(--shadow);
    white-space: normal;
  }

  /* Measure names stand out wherever text describes them */
  .explorer :global(.cw-var) {
    font-weight: 700;
    color: var(--ink);
  }

  /* In an enlarged chart's window, a note with no room below opens above its "?" (explorer.ts, placeTip) */
  .explorer :global(.cw-help.tip-above:hover::after),
  .explorer :global(.cw-help.tip-above:focus::after) {
    top: auto;
    bottom: calc(100% + 6px);
  }

  /* A longer note: wider, anchored at the "?", paragraphs kept */
  .explorer :global(.cw-help.wide:hover::after),
  .explorer :global(.cw-help.wide:focus::after) {
    left: 0;
    transform: translateX(var(--tip-dx, 0px));
    width: min(28rem, 80vw);
    white-space: pre-line;
  }

  .explorer :global(.cw-chart) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* A legend entry hovered or focused: its marks in the chart stay, the rest fade (explorer.ts, spotlight) */
  .explorer :global(svg [data-key]) {
    transition: opacity 0.12s ease;
  }

  .explorer :global(svg.is-spotlit [data-key]:not(.is-lit)) {
    opacity: 0.15;
  }

  @media (prefers-reduced-motion: reduce) {
    .explorer :global(svg [data-key]) {
      transition: none;
    }
  }

  /* Collapse and Enlarge: a pair at each chart's top right, and the window Enlarge opens (enlarge.ts) */
  .explorer :global(.enlarge-tools) {
    float: right;
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.3rem 0.4rem;
    margin: 0.15rem 0 0.3rem 0.8rem;
  }

  .explorer :global(.enlarge-open),
  .explorer :global(.collapse-toggle) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-soft);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }

  /* Comps and Trends only, chart by chart, together first in the row, the same place on every chart */
  .explorer :global(.chart-dials) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Each in the Detail dial's look (explorer.ts borrows its styles), smaller */
  .explorer :global(.chart-dial) {
    margin: 0 0.15rem 0 0;
    padding: 0 0.2rem;
    gap: 0.35rem;
    font-size: 0.8rem;
  }

  .explorer :global(.chart-dial .dial-face) {
    width: 20px;
    height: 20px;
  }

  .explorer :global(.chart-dial .dial-pointer) {
    top: 1px;
    width: 2.5px;
    height: 7px;
  }

  .explorer :global(.chart-dial[aria-disabled="true"]) {
    opacity: 0.45;
    cursor: default;
  }

  .explorer :global(.chart-dial[aria-disabled="true"]:hover) {
    color: var(--ink-soft);
  }

  /* On a phone the three take a row of their own, above the heading, and fit it */
  @media (max-width: 520px) {
    .explorer :global(.enlarge-tools) {
      float: none;
      display: flex;
      margin: 0 0 0.35rem;
    }

    .explorer :global(.enlarge-open),
    .explorer :global(.collapse-toggle) {
      padding: 0.2rem 0.45rem;
    }

    /* The dials a row of their own, over Collapse and Enlarge */
    .explorer :global(.chart-dials) {
      flex: 1 0 100%;
      justify-content: flex-end;
    }
  }

  .explorer :global(.enlarge-open svg),
  .explorer :global(.collapse-toggle svg) {
    width: 0.85rem;
    height: 0.85rem;
  }

  /* Folded: the heading and the pair stay; everything else in the chart's box goes, and Enlarge with it,
     since there's nothing to enlarge. In the window, there's nothing to fold. */
  .explorer :global(.is-collapsed) {
    display: flow-root;
  }

  .explorer :global(.is-collapsed > :not(h2, h3, h4, .enlarge-tools)),
  .explorer :global(.is-collapsed .enlarge-open),
  .explorer :global(.is-collapsed .chart-dials),
  .explorer :global(.is-enlarged .collapse-toggle) {
    display: none !important;
  }

  /* Nothing to enlarge, or to show the trends of, where a note stands in for the chart */
  .explorer :global(figure.panel:has(> .panel-none:not([hidden])) :is(.enlarge-open, .chart-dials)) {
    display: none;
  }

  .explorer :global(.enlarge-open:hover),
  .explorer :global(.enlarge-open:focus-visible),
  .explorer :global(.collapse-toggle:hover),
  .explorer :global(.collapse-toggle:focus-visible) {
    color: var(--accent);
    border-color: var(--accent);
  }

  .explorer :global(.is-enlarged .enlarge-open) {
    display: none;
  }

  .explorer :global(.enlarge-dialog) {
    width: min(1500px, 96vw);
    max-width: none;
    max-height: 94vh;
    margin: auto;
    padding: 0;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    overflow: hidden;
  }

  .explorer :global(.enlarge-dialog::backdrop) {
    background: rgba(31, 31, 28, 0.35);
  }

  .explorer :global(.enlarge-dialog[open]) {
    display: flex;
    flex-direction: column;
  }

  .explorer :global(.enlarge-body) {
    box-sizing: border-box;
    flex: 1 1 auto;
    min-height: 0;
    padding: 1.3rem 1.8rem 1.4rem;
    overflow: auto;
  }

  /* The tab's controls, brought along across the top of the window, in their docked form */
  .explorer :global(.enlarge-controls) {
    flex: none;
    padding: 0.45rem 3.2rem 0.45rem 1.8rem;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }

  .explorer :global(.enlarge-controls) .controls {
    padding: 0;
  }

  .explorer :global(.enlarge-controls .cap-scen-row) {
    position: static;
    margin: 0;
    padding: 0;
    border: 0;
    box-shadow: none;
    background: none;
  }

  .explorer :global(.enlarge-body > .is-enlarged) {
    margin: 0 auto;
  }

  /* Enlarged, text runs a little wider, leaving the chart more of the height */
  .explorer :global(.enlarge-close) {
    position: absolute;
    top: 0.45rem;
    right: 0.6rem;
    z-index: 2;
    width: 2rem;
    height: 2rem;
    font: inherit;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--ink-soft);
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .explorer :global(.enlarge-close:hover),
  .explorer :global(.enlarge-close:focus-visible) {
    color: var(--accent);
  }

  .explorer :global(.cw-legend) {
    list-style: none;
    padding: 0;
    margin: 0 0 0.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .explorer :global(.cw-legend li) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .explorer :global(.cw-key) {
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--c);
  }

  .explorer :global(.cw-key.circle) {
    border-radius: 50%;
  }

  .explorer :global(.cw-key.triangle) {
    width: 12px;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .explorer :global(.cw-key.smooth) {
    width: 18px;
    height: 2px;
    background: var(--ink);
  }

  .explorer :global(.cw-caption) {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.4rem;
    line-height: 1.45;
  }

  .explorer :global(.cw-tip) {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.45rem 0.6rem;
    font-size: 0.82rem;
    line-height: 1.4;
    box-shadow: 0 6px 18px var(--shadow);
    max-width: 18rem;
    overflow-wrap: anywhere;
  }

  .explorer :global(.cw-tip-towns),
  .explorer :global(.cw-tip-hint) {
    color: var(--muted);
    font-size: 0.76rem;
    margin-top: 0.2rem;
  }

  .explorer :global(.cw-table) {
    font-size: 0.84rem;
  }

  .explorer :global(.cw-table table) {
    border-collapse: collapse;
    width: 100%;
  }

  .explorer :global(.cw-table th),
  .explorer :global(.cw-table td) {
    text-align: left;
    padding: 0.2rem 0.5rem;
    border-bottom: 1px solid var(--grid);
  }

  .explorer :global(.cw-table td) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }




  .explorer :global(.cw-bars) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.05rem;
  }

  .explorer :global(.cw-bar) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 64px 2.6rem;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
    font: inherit;
    font-size: 0.76rem;
    line-height: 1.25;
    text-align: left;
    color: var(--ink);
    background: none;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 0.14rem 0.3rem;
    cursor: pointer;
  }

  .explorer :global(.cw-bar-label) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .explorer :global(.cw-bar:hover) {
    background: #f3eee3;
  }

  .explorer :global(.cw-bar.is-current) {
    border-color: var(--accent);
    background: #fbf1ec;
  }

  .explorer :global(.cw-bar-track) {
    position: relative;
    height: 6px;
    background: #efe9dd;
    border-radius: 4px;
  }

  .explorer :global(.cw-bar-track::after) {
    content: "";
    position: absolute;
    left: 50%;
    top: -2px;
    bottom: -2px;
    width: 1px;
    background: var(--axis);
  }

  .explorer :global(.cw-bar-fill) {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    background: #2a78d6;
    border-radius: 0 4px 4px 0;
  }

  .explorer :global(.cw-bar-fill.neg) {
    left: auto;
    right: 50%;
    background: #eb6834;
    border-radius: 4px 0 0 4px;
  }

  .explorer :global(.cw-bar-value) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }


  @media (max-width: 900px) {
    .explorer :global(.cw-body) {
      padding: 0.5rem 0.8rem 0.6rem;
    }

    .explorer :global(.cw-finding-row) {
      flex-wrap: wrap;
      gap: 0.3rem;
    }

    .explorer :global(.cw-body),
    .explorer :global(.cw-body.picker-closed) {
      grid-template-columns: minmax(0, 1fr);
      overflow-y: auto;
    }

    .explorer :global(.cw-picker-handle) {
      display: none;
    }

    .explorer :global(.cw-picker) {
      overflow: visible;
      border-left: 0;
      border-top: 1px solid var(--line);
      padding: 0.8rem 0 0;
    }

    .explorer :global(.cw-controls) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      padding: 0.3rem 1rem 0.7rem;
    }

    .explorer :global(.cw-controls > :nth-child(-n + 2)),
    .explorer :global(.cw-controls .cw-check),
    .explorer :global(.cw-controls .cw-find) {
      grid-column: 1 / -1;
    }

    .explorer :global(.cw-field select),
    .explorer :global(.cw-field input) {
      width: 100%;
      max-width: 100%;
    }

    .explorer :global(.cw-check) {
      padding-bottom: 0;
    }

    .explorer :global(.cw-dialog) {
      width: 100vw;
      height: 100dvh;
      border-radius: 0;
    }
  }

  /* The 82.5% cap tab */
  .cap-title {
    font-size: 1.6rem;
    margin: 0.4rem 0 0.6rem;
  }

  .cap-lede,
  .cap-method {
    line-height: 1.6;
  }

  .cap-method {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .cap-questions ul {
    padding-left: 1.2rem;
    line-height: 1.55;
  }

  .cap-questions li + li {
    margin-top: 0.6rem;
  }

  .explorer :global(.cap-section) {
    margin: 1.6rem 0;
  }

  .explorer :global(.cap-section h3) {
    font-size: 1.15rem;
    margin: 0 0 0.6rem;
  }

  .explorer :global(.cap-section p) {
    line-height: 1.6;
  }

  .explorer :global(.cap-note) {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .explorer :global(.cap-year) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 1rem 0 0.4rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .explorer :global(.cap-year-btn) {
    font: inherit;
    font-size: 0.85rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    cursor: pointer;
  }

  .explorer :global(.cap-year-btn.is-on) {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }

  .explorer :global(.cap-tiles) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  /* As the explorer's tiles: label, value, and details line up across a row (#182) */
  .explorer :global(.cap-tiles .tile) {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.8rem 0.9rem;
    transition: background-color 0.12s;
  }

  .explorer :global(.cap-tiles .tile-label) {
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .explorer :global(.cap-tiles .tile-value) {
    font-size: 1.45rem;
    font-weight: 700;
    margin: 0.2rem 0 0.15rem;
  }

  .explorer :global(.cap-tiles .tile-detail) {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.35;
  }

  /* The cap to compare with: floats under the tabs as the page scrolls */
  .explorer :global(.cap-scen-row) {
    position: sticky;
    top: calc(var(--tabs-h, 3rem) + 0.4rem);
    z-index: 25;
    box-shadow: 0 6px 16px var(--shadow);
    margin: 1rem 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
  }

  .explorer :global(.cap-scen-lead) {
    font-weight: 600;
  }

  .explorer :global(.cap-radio) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
  }

  .explorer :global(.cap-scen-row input[type="range"]) {
    accent-color: var(--accent);
  }

  .explorer :global(.cap-slider) {
    position: relative;
    display: inline-block;
    width: min(260px, 100%);
    padding-bottom: 1rem;
  }

  .explorer :global(.cap-slider input[type="range"]) {
    width: 100%;
    margin: 0;
  }

  /* The thumb is about 16px wide, so its center runs from 8px to the width less 8px */
  .explorer :global(.cap-slider-mark) {
    position: absolute;
    top: 1.15rem;
    left: calc(8px + (100% - 16px) * var(--at));
    transform: translateX(-0.4em);
    font-size: 0.68rem;
    line-height: 1;
    color: var(--ink-soft);
    white-space: nowrap;
    pointer-events: none;
  }

  /* The floating bar: the year, set off at the left, then the cap, all on one line in small type */
  .explorer :global(.cap-scen-row) {
    gap: 0.4rem 0.7rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.82rem;
  }

  .explorer :global(.cap-scen-row .cap-year) {
    gap: 0.3rem;
    margin: 0;
    padding-right: 0.7rem;
    font-size: 0.78rem;
    border-right: 1px solid var(--line);
  }

  .explorer :global(.cap-scen-row .cap-year-btn) {
    padding: 0.12rem 0.55rem;
    font-size: 0.78rem;
  }

  .explorer :global(.cap-scen-row .cap-radio) {
    gap: 0.25rem;
  }

  .explorer :global(.cap-scen-row .cap-slider) {
    width: 150px;
    padding-bottom: 0.8rem;
  }

  .explorer :global(.cap-scen-row .cap-slider-mark) {
    top: 1.05rem;
    font-size: 0.62rem;
  }

  .explorer :global(.cap-scen-row .cap-level) {
    min-width: 2.8rem;
  }

  .explorer :global(.cap-color-row) {
    display: flex;
    gap: 0.3rem;
  }

  /* The cap chart's plot: its title shows only enlarged; zoom buttons over its top right */
  .explorer :global(.cap-plot) {
    position: relative;
  }

  .explorer :global(.cap-plot-title) {
    display: none;
  }

  .explorer :global(.is-enlarged .cap-plot-title) {
    display: block;
    margin: 0 0 0.5rem;
