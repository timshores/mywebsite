    gap: 0.6rem;
  }

  /* Swap the focus and the comparison: a small pill beside Compare with. Not .swap, which is the intro's
     words that change with the tab */
  .swap-btn {
    padding: 0.05rem 0.55rem;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }

  .swap-btn:hover:not(:disabled) {
    color: var(--ink);
    border-color: var(--ink-soft);
  }

  .swap-btn:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .swap-btn:disabled {
    opacity: 0.45;
    cursor: default;
  }

  /* With no comparison it keeps its place, unseen (and out of reach), so the controls don't shift when it
     comes and goes */
  .swap-btn.is-idle {
    visibility: hidden;
  }

  .entity-note {
    margin: 0.4rem 0 0;
    padding: 0.55rem 0.75rem;
    border-left: 3px solid var(--line);
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .entity-note :global(.note-source) {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.78rem;
  }

  .hist-head {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .detail-dial.hist-dial {
    margin-left: 0;
    align-self: flex-start;
    padding-left: 0;
  }

  .years-slider :global(.years-two) {
    display: block;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .years-slider output {
    min-width: 7.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  .years-ends {
    display: flex;
    justify-content: space-between;
    margin-right: 8.1rem;
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--muted);
  }

  .toggle-options {
    display: flex;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--paper);
  }

  .toggle-options label {
    position: relative;
    cursor: pointer;
  }

  .toggle-options input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }

  .toggle-options span {
    display: block;
    padding: 0.45rem 0.8rem;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--ink-soft);
  }

  .toggle-options span span {
    display: inline;
    padding: 0;
    color: inherit;
  }

  .toggle-options label + label {
    border-left: 1px solid var(--line);
  }

  .toggle-options input:checked + span {
    background: var(--ink);
    color: var(--paper);
  }

  .toggle-options input:checked + span span {
    background: none;
  }

  /* A chart's own choice of what it shows, under its description */
  .panel-views {
    width: fit-content;
    margin: 0.55rem 0 0.35rem;
  }

  .panel-views[hidden] {
    display: none;
  }

  .panel-views span {
    padding: 0.3rem 0.75rem;
    font-size: 0.85rem;
  }

  .toggle-options input:focus-visible + span {
    outline: 2px dashed var(--accent);
    outline-offset: -4px;
  }

  /* View tabs: an underline marks the open view */
  /* The tabs stay at the top of the screen as the page scrolls */
  .view-tabs {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    gap: 0.25rem;
    margin-top: 1.4rem;
    padding-top: 0.35rem;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  /* On a narrow screen the tabs scroll sideways inside the bar, and the dial stays in view */
  .view-tablist {
    display: flex;
    gap: 0.25rem;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .view-tablist::-webkit-scrollbar {
    display: none;
  }

  .view-tablist [role="tab"] {
    flex: none;
  }

  /* The detail dial: a knob turned left for off, right for on */
  .detail-dial {
    margin-left: auto;
    align-self: center;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex: none;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: none;
    border: 0;
    padding: 0.25rem 0.35rem;
    cursor: pointer;
  }

  .detail-dial:hover {
    color: var(--ink);
  }

  .detail-dial:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
    border-radius: 6px;
  }

  .dial-face {
    position: relative;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1.5px solid var(--ink-soft);
    background: radial-gradient(circle at 40% 35%, #fff 0%, #efe8dc 75%);
    box-shadow: 0 1px 2px rgba(31, 31, 28, 0.25);
    transform: rotate(50deg);
    transition: transform 0.25s ease;
  }

  .dial-pointer {
    position: absolute;
    top: 2px;
    left: 50%;
    width: 3px;
    height: 9px;
    border-radius: 2px;
    background: var(--accent);
    transform: translateX(-50%);
  }

  .detail-dial[aria-checked="false"] .dial-face {
    transform: rotate(-50deg);
  }

  .detail-dial[aria-checked="false"] .dial-pointer {
    background: var(--ink-soft);
  }

  .dial-state {
    min-width: 1.6em;
    text-align: left;
  }

  @media (prefers-reduced-motion: reduce) {
    .dial-face {
      transition: none;
    }
  }

  /* Detail off: the controls, tiles, charts and legends stay; the explanations around them go */
  .explorer.detail-off :global(:is(.intro, .panel-sub, .controls-note, .compare-view, .table-open, #entity-meta,
    .relations, .cw-help, .cw-intro, .map-about, .map-source, .map-table, .cap-note, .cap-table-head, .cap-steps,
    .cap-questions, [data-detail])) {
    display: none !important;
  }

  /* A heading that folds an explanation away stops folding when Detail off has taken the explanation: no chevron,
     nothing to click */
  .explorer.detail-off :global(.map-about-fold > summary) {
    cursor: default;
    pointer-events: none;
  }

  .explorer.detail-off :global(.map-about-fold > summary::before) {
    display: none;
  }

  /* The campaign's credit: shown when the intro that names it is hidden, by Detail off or folded shut */
  .cap-credit {
    display: none;
    margin: -0.2rem 0 0.8rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .explorer.detail-off .cap-credit,
  .cap-view:has(#cap-intro:not([open])) .cap-credit {
    display: block;
  }

  .view-tabs [role="tab"] {
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: none;
    border: 0;
    border-radius: 8px 8px 0 0;
    padding: 0.55rem 1rem;
    margin-bottom: -1px;
    cursor: pointer;
  }

  .view-tabs [role="tab"]:hover {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.55);
  }

  .view-tabs [role="tab"][aria-selected="true"] {
    color: var(--ink);
    box-shadow: inset 0 -3px 0 var(--accent);
  }

  .view-tabs [role="tab"]:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: -4px;
  }

  .view-tabs + #view-panel .controls {
    margin-top: 1rem;
  }

  /* Where the tabs would run past the bar's edge, they become a grid of buttons, all in sight,
     with the dial in the grid's sixth cell. The grid is too tall to keep pinned on a phone, so it
     scrolls away with the page; the docked controls pin to the top in its place (explorer.ts). */
  @media (max-width: 860px) {
    .view-tabs {
      position: relative;
      display: block;
      padding: 0.45rem 0;
    }

    .view-tablist {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: 1fr;
      gap: 0.35rem;
      overflow: visible;
    }

    .view-tabs [role="tab"] {
      min-height: 2.6rem;
      margin: 0;
      padding: 0.3rem 0.5rem;
      font-size: 0.92rem;
      line-height: 1.2;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: #fff;
    }

    .view-tabs [role="tab"][aria-selected="true"] {
      color: var(--paper);
      background: var(--ink);
      border-color: var(--ink);
      box-shadow: none;
    }

    .view-tabs [role="tab"]:focus-visible {
      outline-offset: 2px;
    }

    /* One column wide and one row high, bottom right; the bar is its containing block */
    .view-tabs .detail-dial {
      position: absolute;
      right: 0;
      bottom: 0.45rem;
      width: calc((100% - 0.7rem) / 3);
      height: calc((100% - 0.9rem - 0.35rem) / 2);
      justify-content: center;
      gap: 0.3rem;
      padding: 0;
    }

    .view-tabs .dial-face {
      flex: none;
    }
  }

  /* Too narrow for the word beside the knob; the knob's turn still shows on or off */
  @media (max-width: 380px) {
    .view-tabs .dial-state {
      display: none;
    }
  }

  .panels[hidden] {
    display: none;
  }

  .entity h2 {
    margin: 0 0 0.25rem;
  }

  /* Relations outline: the selected district's towns or town's districts, with tree lines */
  .relations {
    flex-basis: 100%;
    margin-top: 0.2rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .relations[hidden] {
    display: none;
  }

  .relations :global(.rel-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.6rem;
    margin-bottom: 0.25rem;
  }

  .relations :global(.rel-head strong) {
    color: var(--ink);
    font-size: 0.95rem;
  }

  .relations :global(.rel-note) {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .relations :global(.rel-tree) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .relations :global(.rel-tree li) {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.9rem;
    padding: 0.2rem 0 0.2rem 1.5rem;
    line-height: 1.45;
  }

  /* Tree lines: a trunk down the left, a branch to each row, the trunk stopping at the last */
  .relations :global(.rel-tree li::before) {
    content: "";
    position: absolute;
    left: 0.45rem;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--axis);
  }

  .relations :global(.rel-tree li:last-child::before) {
    bottom: calc(100% - 0.95rem);
  }

  .relations :global(.rel-tree li::after) {
    content: "";
    position: absolute;
    left: 0.45rem;
    top: 0.95rem;
    width: 0.7rem;
    border-top: 1px solid var(--axis);
  }

  .relations :global(.rel-name) {
    min-width: 11rem;
    color: var(--ink);
    font-weight: 500;
  }

  .relations :global(.rel-kind) {
    min-width: 6.5rem;
  }

  .relations :global(.rel-amt) {
    min-width: 6.5rem;
    font-variant-numeric: tabular-nums;
  }

  .relations :global(.rel-extra) {
    flex: 1 1 18rem;
    color: var(--muted);
  }

  .relations :global(.rel-more) {
    font: inherit;
    color: var(--accent);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .relations :global(.rel-more:focus-visible) {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .entity p {
    margin-bottom: 1rem;
  }

  /* Stat tiles */
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.8rem;
  }

  /* Each tile takes three of the row's tracks, label, value, details, so the values and their pies line up
     card to card however many lines a label wraps to (#182) */
  .tiles :global(.tile) {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.8rem 0.9rem;
    transition: background-color 0.12s;
  }

  /* The tile under the pointer goes white, as the control panel is (#216) */
  .tiles :global(.tile:hover),
  .explorer :global(.cap-tiles .tile:hover) {
    background: #fff;
  }

  .tiles :global(.tile-label) {
    font-size: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.3;
  }

  .tiles :global(.tile-value) {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0.2rem 0 0.15rem;
  }

  .tiles :global(.tile-detail) {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.35;
  }

  /* A small pie of the share a tile names, sized to the value's line so the tile doesn't grow (#181).
     One muted hue: the share 4.5:1 against the rest, 5.6:1 against the page; the ring outlines the whole */
  .tiles :global(.tile-value.has-pie) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .tiles :global(.tile-pie) {
    width: 1em;
    height: 1em;
    flex: none;
  }

  .tiles :global(.tile-pie-rest) {
    fill: #dbe6e4;
  }

  .tiles :global(.tile-pie-share) {
    fill: #3f6e73;
  }

  /* The comparison's pie, in gold beside the town's green */
  .tiles :global(.tile-pie.is-cmp .tile-pie-rest) {
    fill: #f1e6c6;
  }

  .tiles :global(.tile-pie.is-cmp .tile-pie-share) {
    fill: #a87b00;
  }

  .tiles :global(.tile-pie.is-cmp .tile-pie-ring) {
    stroke: #a87b00;
  }

  /* The town's words, on the green of its pie */
  .tiles :global(:is(.tile-figure.is-own, .tile-detail.is-own)) {
    width: fit-content;
    padding: 0 0.3rem;
    margin-left: -0.3rem;
    border-radius: 4px;
    background: #dbe6e4;
  }

  /* The comparison's words, on the gold of its pie */
  .tiles :global(.tile-detail.is-cmp) {
    width: fit-content;
    padding: 0 0.3rem;
    margin-left: -0.3rem;
    border-radius: 4px;
    background: #f4e6bd;
    color: var(--ink);
  }

  .tiles :global(.tile-pies) {
    display: inline-flex;
    gap: 0.3rem;
  }

  .tiles :global(.tile-pie-ring) {
    fill: none;
    stroke: #3f6e73;
    stroke-width: 1;
  }

  /* Panels */
  .panels {
    display: grid;
    /* minmax(0, …) so a wide open table scrolls inside its box instead of
       widening the column (and with it every chart) */
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    transition: opacity 0.2s ease;
  }

  .panel {
    position: relative;
    margin: 0;
    min-width: 0;
  }

  .panel h3 {
    margin-bottom: 0.15rem;
  }

  .panel-sub {
    font-size: 0.88rem;
    margin-bottom: 0.5rem;
  }

  /* In place of a chart the entity has no data for */
  .panel-none {
    font-size: 0.92rem;
    padding: 0.8rem 1rem;
    border: 1px dashed var(--line);
    border-radius: 12px;
    color: var(--ink-soft);
  }

  #rev-body[hidden],
  .panel-none[hidden] {
    display: none;
  }

  /* The trend's yearly rise, beside its legend entry */
  .legend :global(.legend-detail) {
    margin-left: 0.1rem;
    color: var(--ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* A size down from the charts' other text (0.82rem), so more of each legend fits on its first row. It clears
     Collapse and Enlarge, which float at the panel's top right: with Detail off there's no subtitle between, and
     a legend beside the float lost the buttons' width on every row (#186) */
  .legend {
    clear: right;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.76rem;
    color: var(--ink-soft);
    margin-bottom: 0.4rem;
  }

  .legend :global(li) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* A line's entry (its trend, or a comparison) can run long. Where one would drop to a new row, the explorer
     starts it in the room left on this one (explorer.ts, fitLegend), and its name and figure flow as text there,
     a word at a time, so a row runs the chart's full width before the next begins (#185) */
  .legend :global(li:has(.legend-line)) {
    min-width: 0;
  }

  /* The chart's trend, then the comparison, each on a row of its own (#220) */
  .legend :global(li.legend-row) {
    flex-basis: 100%;
  }

  .legend :global(.legend-btn.legend-line) {
    display: block;
    min-width: 0;
    text-align: left;
  }

  .legend :global(.legend-line .key) {
    margin-right: 0.4rem;
    vertical-align: middle;
  }

  /* A trend's name stays on one line with its swatch, "-- Leverett trend" (#187) */
  .legend :global(.legend-keep) {
    white-space: nowrap;
  }

  /* On a phone the figure may break once, between the amount and "a year", each half whole */
  .legend :global(.legend-whole) {
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .legend :global(.legend-detail) {
      white-space: normal;
    }
  }

  /* Stacked-chart legends are toggle buttons that isolate segments */
  .legend :global(.legend-btn),
  .legend :global(.legend-reset) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font: inherit;
    color: var(--ink-soft);
    background: none;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.15rem 0.55rem 0.15rem 0.45rem;
    margin-left: -0.45rem;
    cursor: pointer;
    transition: background 0.12s ease, border-color 0.12s ease, opacity 0.12s ease;
  }

  .legend :global(.legend-btn:hover) {
    border-color: var(--line);
    background: rgba(255, 255, 255, 0.7);
  }

  .legend :global(.legend-btn[aria-pressed="true"]) {
    color: var(--ink);
    border-color: var(--ink-soft);
    background: #fff;
  }

  .legend :global(.legend-btn.is-off) {
    opacity: 0.5;
  }

  .legend :global(.legend-btn:focus-visible),
  .legend :global(.legend-reset:focus-visible) {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  /* Line entries are on until clicked off; off, they fade and strike through */
  .legend :global(.legend-btn.legend-line[aria-pressed="true"]) {
    color: var(--ink-soft);
    border-color: transparent;
    background: none;
  }

  .legend :global(.legend-btn.legend-line:hover) {
    border-color: var(--line);
    background: rgba(255, 255, 255, 0.7);
  }

  .legend :global(.legend-line.is-off span:last-child) {
    text-decoration: line-through;
  }

  .legend :global(.legend-reset) {
    color: var(--accent);
    font-weight: 500;
    margin-left: 0;
  }

  .legend :global(.legend-reset:hover) {
    border-color: var(--line);
  }

  .panel :global(.key) {
    flex: none;
    display: inline-block;
  }

  .panel :global(.key.rect) {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: var(--c);
  }

  .panel :global(.key.line) {
    width: 16px;
    height: 2px;
    border-radius: 1px;
    background: var(--c);
  }

  .panel :global(.key.dash) {
    width: 16px;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--c) 0 5px, transparent 5px 8px);
  }

  /* The comparison: its line, with the dot it carries at each year */
  .panel :global(.key.linedot) {
    width: 16px;
    height: 8px;
    background: radial-gradient(circle, var(--c) 0 3px, transparent 3.5px) center / 8px 8px no-repeat,
      linear-gradient(var(--c), var(--c)) center / 16px 2px no-repeat;
  }

  .panel :global(.key.hatch) {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: repeating-linear-gradient(45deg, var(--c) 0 1px, transparent 1px 4px);
    box-shadow: inset 0 0 0 1px var(--axis);
  }

  .panel :global(.key.none) {
    width: 16px;
  }

  /* A chart's lines, in a legend of their own under it */
  .legend-below {
    margin: 0.3rem 0 0.2rem;
  }

  /* The votes shown alone: the entry pressed, as a chosen category is */
  .legend :global(.legend-btn.legend-line.is-alone) {
    color: var(--ink);
    border-color: var(--ink-soft);
    background: #fff;
  }

  /* The bond rating under the debt chart */
  .rating-box {
    margin-top: 0.6rem;
    border-top: 1px solid var(--grid);
    padding-top: 0.5rem;
  }

  .rating-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .rating-title {
    color: var(--ink);
    font-weight: 600;
  }

  .rating-legend {
    margin: 0;
  }

  .rating-box svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Actual vs. budget: the zero line where spending met the budget, and the comparison's dots ringed */
  .panel :global(.gap-zero) {
    stroke: var(--ink-soft);
    stroke-width: 1.2;
  }

  .panel :global(.gap-dot) {
    stroke: var(--surface);
    stroke-width: 1.5;
  }

  /* A Prop 2½ vote: the diamond its chart marks the year with */
  .panel :global(.key.diamond) {
    width: 9px;
    height: 9px;
    margin: 0 3.5px;
    background: var(--c);
    transform: rotate(45deg);
  }

  .panel svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: "Karla", sans-serif;
    touch-action: pan-y;
  }

  .panel svg:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .panel :global(.gridline) {
    stroke: var(--grid);
    stroke-width: 1;
  }

  .panel :global(.baseline) {
    stroke: var(--axis);
    stroke-width: 1;
  }

  .panel :global(.tick) {
    font-size: 12px;
    fill: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .panel :global(.cap),
  .panel :global(.end-label) {
    font-size: 12px;
    font-weight: 500;
    fill: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* A halo, so the latest value stays readable where a line passes behind it */
  .panel :global(.cap) {
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .panel :global(.band) {
    fill: var(--ink);
    opacity: 0.045;
  }

  .panel :global(.hit) {
    fill: transparent;
    cursor: crosshair;
  }

  .panel :global(.col) {
    transition: opacity 0.12s ease;
  }

  .panel :global(svg.has-hover .col:not(.is-hover)) {
    opacity: 0.55;
  }

  .panel :global(svg .col.faded),
  .panel :global(svg.has-hover .col.faded:not(.is-hover)) {
    opacity: 0.35;
  }

  .panel :global(.hatch-bg) {
    fill: var(--surface);
  }

  .panel :global(.hatch-line) {
    stroke: var(--ink-soft);
    stroke-width: 1.5;
  }

  /* Trend: dashed, on a paper-colored halo that keeps it legible across the columns */
  .panel :global(.trend-halo) {
    fill: none;
    stroke: var(--surface);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.85;
  }

  .panel :global(.trend-line) {
    fill: none;
    stroke-width: 2.25;
    stroke-dasharray: 7 5;
    stroke-linecap: round;
  }

  /* The census estimates' bands, joining each group's columns */
  .panel :global(.stack-area) {
    opacity: 0.16;
  }

  /* Prop 2½ votes: a stem to the year's amount with an open head, haloed against the columns it crosses, and a diamond
     on the baseline */
  .panel :global(.mark-halo) {
    stroke: var(--surface);
    stroke-width: 4.5;
    opacity: 0.85;
  }

  .panel :global(.mark-stem) {
    stroke-width: 1.75;
  }

  .panel :global(.mark-head) {
    fill: var(--surface);
    stroke-width: 2;
  }

  .panel :global(.mark-diamond) {
    stroke: var(--surface);
    stroke-width: 1.5;
  }

  /* The older measure, beside the columns rather than in them */
  .panel :global(.extra-line) {
    fill: none;
    stroke-width: 2.25;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .panel :global(.overlay-line),
  .panel :global(.series-line) {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  /* With only the trends shown, each trend's name at its end, in its color */
  /* With only the trends shown, the years far apart (the census's estimates): a dot where each estimate is */
  .panel :global(.trend-dot) {
    stroke: var(--surface);
    stroke-width: 1.5;
  }

  .panel :global(.trend-label) {
    font-size: 12px;
    font-weight: 600;
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  /* The comparison: near-black, a little thicker than the rest */
  .panel :global(.overlay-line),
  .panel :global([data-key="cmp"] > .series-line) {
    stroke-width: 2.75;
  }

  .panel :global(.dot) {
    stroke: var(--surface);
    stroke-width: 2;
  }

  .panel :global(.crosshair) {
    stroke: var(--axis);
    stroke-width: 1;
  }

  .panel :global(.hit),
  .panel :global(.overlay),
  .panel :global(.trend),
  .panel :global(.lines) {
    pointer-events: none;
  }

  .panel :global(.hit) {
    pointer-events: all;
  }

  /* Tooltip: value first, label after, line keys */
  /* The hover cards (the charts', the map's, the plots'): white, as the control boxes are, so they stand apart */
  .tooltip {
    position: absolute;
    z-index: 3;
    min-width: 13rem;
    max-width: min(25rem, calc(100% - 8px));
    padding: 0.6rem 0.75rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 8px 22px var(--shadow);
    pointer-events: none;
    font-size: 0.82rem;
  }

  .tooltip :global(.tip-title) {
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.3rem;
  }

  .tooltip :global(.tip-row) {
    display: grid;
    grid-template-columns: 16px auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5rem;
    line-height: 1.5;
  }

  .tooltip :global(.tip-value) {
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    text-align: right;
    min-width: 4.6rem;
  }

  .tooltip :global(.tip-label),
  .tooltip :global(.tip-title),
  .tooltip :global(.tip-note) {
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .tooltip :global(.tip-title) {
    color: var(--ink);
  }

  /* Keys sit beside the first line of a wrapped label */
  .tooltip :global(.tip-row .key) {
    align-self: start;
    margin-top: 0.55em;
  }

  .tooltip :global(.tip-row.strong) {
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.2rem;
    margin-bottom: 0.2rem;
  }

  .tooltip :global(.tip-note) {
    margin-top: 0.3rem;
    color: var(--muted);
  }

  /* Table view */
  .table-view {
    margin-top: 0.6rem;
    font-size: 0.85rem;
  }

  .table-view summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 500;
    width: max-content;
  }

  /* Full data table: a button that opens the overlay */
  .table-open {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.35rem;
    padding: 0;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .table-open:hover {
    color: var(--accent-2);
  }

  .table-open:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 3px;
  }

  .table-open-icon {
    font-size: 0.8rem;
    line-height: 1;
  }

  /* The overlay sizes to the table, past the page's central column, up to the
     viewport less a 16px margin; only very narrow screens still scroll */
  .table-dialog {
    margin: auto;
    width: fit-content;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 32px);
    padding: 0;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(31, 31, 28, 0.28);
  }

  .table-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .table-dialog::backdrop {
    background: rgba(31, 31, 28, 0.4);
  }

  .dialog-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 1.1rem 0.7rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .dialog-head h3 {
    margin: 0;
    font-size: 1.05rem;
    max-width: 60ch;
  }

  .dialog-close {
    flex: none;
    width: 2rem;
    height: 2rem;
    font: inherit;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--ink-soft);
    background: none;
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
  }

  .dialog-close:hover {
    border-color: var(--line);
    color: var(--ink);
  }

  .dialog-close:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .dialog-body.table-scroll {
    margin: 0;
    padding: 0 1.25rem 1rem;
    overflow: auto;
  }

  .table-dialog .dialog-body :global(table) {
    font-size: 0.82rem;
  }

  .table-dialog .dialog-body :global(thead th) {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--paper);
    min-width: 0;
    padding-top: 0.7rem;
    box-shadow: inset 0 -1px 0 var(--line);
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .table-dialog .dialog-body :global(th),
  .table-dialog .dialog-body :global(td) {
    padding: 0.3rem 0.4rem;
  }

  /* Comparison table: the report's layout and amber/teal shading */
  .compare-view :global(td.swatch-col),
  .compare-view :global(th.swatch-col) {
    width: 1.4rem;
    min-width: 0;
    padding-right: 0;
    text-align: center;
  }

  .compare-view :global(thead th.label-col) {
    text-align: left;
  }

  .compare-view :global(tr.total th),
  .compare-view :global(tr.total td) {
    border-top: 1px solid var(--ink-soft);
    font-weight: 600;
  }

  .compare-view :global(tbody th) {
    white-space: normal;
    min-width: 11rem;
  }

  .compare-view :global(td[title]) {
    cursor: help;
  }

  /* The note spans the table's width: it adds nothing to the box's width
     (width: 0) and stretches to fill it (min-width), but never past the
     visible scroll area (100cqw), where it stays put as the table scrolls. */
  .compare-view .table-scroll {
    container-type: inline-size;
  }

  .compare-view :global(.compare-box) {
    display: inline-block;
    vertical-align: top;
  }

  .compare-view :global(.compare-legend) {
    margin-top: 0.6rem;
    width: 0;
    min-width: min(100%, 100cqw);
    position: sticky;
    left: 0;
  }

  .compare-view :global(.compare-legend p) {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0.35rem 0 0;
  }

  /* Above and Below, at the table's right edge, under the columns they shade most */
  .compare-view :global(.chips) {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.3rem 1rem;
    /* A little room at the right, where the scrolling table's edge would otherwise clip the last letter */
    padding-right: 3px;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .compare-view :global(.chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .compare-view :global(.chip-box) {
    width: 1.6rem;
    height: 0.9rem;
    border-radius: 3px;
    box-shadow: inset 0 0 0 1px rgba(31, 31, 28, 0.08);
  }

  .explorer :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .table-scroll {
    overflow-x: auto;
    margin-top: 0.5rem;
  }

  .table-scroll :global(table) {
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .table-scroll :global(caption) {
    text-align: left;
    color: var(--ink-soft);
    padding-bottom: 0.4rem;
  }

  .table-scroll :global(th),
  .table-scroll :global(td) {
    padding: 0.25rem 0.6rem;
    border-bottom: 1px solid var(--grid);
    text-align: right;
  }

  .table-scroll :global(thead th) {
    color: var(--ink-soft);
    font-weight: 500;
    vertical-align: bottom;
    white-space: normal;
    min-width: 5.5rem;
  }

  .table-scroll :global(tbody th) {
    text-align: left;
    font-weight: 500;
  }

  /* The levy chart's Proposition 2½ votes: purposes wrap; the result is said in words */
  .votes-view :global(td),
  .votes-view :global(thead th) {
    text-align: left;
  }

  .votes-view :global(td.vote-what) {
    white-space: normal;
    min-width: 14rem;
  }

  .votes-view :global(td.vote-lost) {
    color: var(--ink-soft);
  }

  /* Asks once, after the first change, whether to remember choices; never blocks the page */
  .remember-prompt {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 20;
    max-width: min(24rem, calc(100vw - 32px));
    padding: 1rem 1.1rem;
    font-size: 0.9rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 16px 40px rgba(31, 31, 28, 0.22);
  }

  .remember-prompt[hidden] {
    display: none;
  }

  .remember-prompt p {
    margin: 0 0 0.4rem;
  }

  .remember-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.7rem;
  }

  .remember-actions button {
    font: inherit;
    padding: 0.45rem 0.95rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
  }

  .remember-actions #remember-yes {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }

  .remember-actions button:focus-visible,
  .remember-note :global(.link-button:focus-visible) {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .remember-note :global(.link-button) {
    font: inherit;
    padding: 0;
    color: var(--accent);
    background: none;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  /* The notes have the Data tab to themselves, so no rule above them */
  .notes {
    margin-top: 1rem;
  }

  /* About the data: its contents in a column beside the notes, held under the tabs as the page scrolls, the
     part in view marked (notes.ts, #216). --notes-jump is how far below the top of the screen a part lands
     when its link is followed, clear of the tabs. */
  .notes-layout {
    --notes-jump: calc(var(--tabs-h, 3rem) + 1rem);
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 2.25rem;
    align-items: start;
  }

  .notes-body > :first-child {
    margin-top: 0;
  }

  .notes-body > p,
  .notes-body > p > strong,
  .notes-body > h3 {
    scroll-margin-top: var(--notes-jump);
  }

  /* A block, not the site's flex nav */
  .notes-toc {
    display: block;
    position: sticky;
    top: var(--notes-jump);
    max-height: calc(100vh - var(--notes-jump) - 1rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    font-size: 0.84rem;
    line-height: 1.3;
  }

  .notes-toc-toggle {
    display: none;
  }

  .notes-toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }

  .notes-toc :global(a) {
    display: block;
    margin-left: -1px;
    padding: 0.2rem 0 0.2rem 0.75rem;
    border-left: 2px solid transparent;
    color: var(--ink-soft);
    font-weight: 400;
    text-decoration: none;
  }

  .notes-toc :global(li.is-sub a) {
    padding-left: 1.6rem;
  }

  .notes-toc :global(a:hover) {
    color: var(--ink);
    text-decoration: underline;
  }

  .notes-toc :global(a[aria-current]) {
    color: var(--ink);
    font-weight: 600;
    border-left-color: var(--accent);
  }

  /* A narrow screen: the contents fold into a bar under the tabs, naming the part in view, that opens them */
  @media (max-width: 860px) {
    .notes-layout {
      --notes-jump: calc(var(--tabs-h, 3rem) + 3.4rem);
      display: block;
    }

    .notes-toc {
      top: var(--tabs-h, 3rem);
      z-index: 20;
      max-height: none;
      overflow: visible;
      margin: 0 0 1rem;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 10px;
    }

    .notes-toc-toggle {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      width: 100%;
      min-height: 2.75rem;
      padding: 0.6rem 0.85rem;
      font: inherit;
      text-align: left;
      color: var(--ink);
      background: none;
      border: 0;
      border-radius: 10px;
      cursor: pointer;
    }

    .notes-toc-label {
      font-weight: 700;
    }

    .notes-toc-label::after {
      content: " ▾";
      color: var(--ink-soft);
    }

    .notes-toc.is-open .notes-toc-label::after {
      content: " ▴";
    }

    .notes-toc-current {
      min-width: 0;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      color: var(--ink-soft);
    }

    .notes-toc ol {
      display: none;
      max-height: min(60vh, 28rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      margin: 0 0.85rem 0.6rem;
    }

    .notes-toc.is-open ol {
      display: block;
    }

    .notes-toc :global(a) {
      padding-top: 0.45rem;
      padding-bottom: 0.45rem;
    }
  }

  /* "above" rings the comparison menu: it pulses in and out, then stays, until the reader goes back */
  .control select:global(.beckon) {
    animation: beckon 1.4s ease-in-out 0.35s both;
  }

  @keyframes beckon {
    0%, 36%, 72% {
      box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px rgba(182, 92, 61, 0);
    }
    18%, 54%, 100% {
      box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px var(--accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .control select:global(.beckon) {
      animation: none;
      box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px var(--accent);
    }
  }

  /* Under the comparison menu, back to the table that sent the reader up; out of the flow, so the
     menu stays put */
  .control :global(.go-back) {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0;
    white-space: nowrap;
    font: inherit;
    font-size: 0.82rem;
    padding: 0;
    color: var(--accent);
    background: none;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }

  .explorer-footer {
    margin-top: 2.5rem;
    border-top: 1px solid var(--line);
    padding-top: 0.6rem;
  }

  .explorer-footer .remember-note {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0;
  }

  .notes p {
    font-size: 0.92rem;
  }

  .notes strong {
    color: var(--ink);
  }

  .source-files-title {
    margin: 1.6rem 0 0.4rem;
    font-size: 1.1rem;
  }

  .source-files {
    border-collapse: collapse;
    font-size: 0.84rem;
    margin: 0.4rem 0 1rem;
    background: #fff;
  }

  /* Prose cells wrap, unlike the number tables' */
  .table-scroll .source-files {
    width: 100%;
    white-space: normal;
  }

  .source-files th,
  .source-files td {
    text-align: left;
    vertical-align: top;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--line);
  }

  .source-files thead th {
    font-weight: 600;
    color: var(--ink);
    border-bottom: 2px solid var(--line);
  }

  .source-files .source-group th {
    padding-top: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    border-bottom: 1px solid var(--line);
  }

  .source-files td:first-child {
    white-space: nowrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
  }

  .source-files .source-date {
    white-space: nowrap;
  }

  .explorer :global(.load-error) {
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .controls {
      padding: 0.75rem;
    }

    /* Under the menu, which takes the width */
    .cmp-name {
      width: auto;
      height: auto;
    }

    .control,
    .control select,
    .explorer :global(.control .picker-button) {
      width: 100%;
      min-width: 0;
    }

    .explorer :global(.control .picker-panel) {
      width: 100%;
    }

    .tiles :global(.tile-value) {
      font-size: 1.3rem;
    }

  }

  /* Commonwealth tab: a gallery of plots, each opening full screen */
  .cw-intro {
    color: var(--ink-soft);
    margin: 0.4rem 0 1.2rem;
  }

  /* The Commonwealth tab's map (map.ts) */
  .explorer :global(.map-section) {
    position: relative;
    padding-top: 1.4rem;
    margin-bottom: 2.2rem;
  }

  .explorer :global(.map-title),
  .explorer .cw-plots-title {
    margin: 0 0 0.6rem;
  }

  .explorer :global(.map-controls) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.4rem;
    margin-bottom: 0.7rem;
    padding: 0.55rem 0.9rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .explorer :global(.map-seg) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .explorer :global(.map-seg-label),
  .explorer :global(.map-measure > span) {
    font-weight: 500;
    margin-right: 0.2rem;
  }

  .explorer :global(.map-seg-btn) {
    font: inherit;
    font-size: 0.82rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    cursor: pointer;
  }

  .explorer :global(.map-seg-btn[aria-pressed="true"]) {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }

  /* The Dollars switch, idle for a measure that isn't growth in dollars */
  .explorer :global(.map-seg.is-idle) {
    opacity: 0.45;
  }

