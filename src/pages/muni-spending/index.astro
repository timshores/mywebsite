---
import Layout from "../../layouts/Layout.astro";
import GroupMembers from "../../components/massppe/GroupMembers.astro";
import capData from "../../data/massppe/cap.json";
// The explorer's styles, a plain stylesheet anchored on .explorer rather than this page's scoped <style> (#237)
import "../../lib/massppe/explorer.css";

// The agencies' files behind the explorer, as kept in the public pipeline repository
// About the data's FY2025 count of towns at the 82.5% cap, from DESE's history as the cap tab counts it (#242: it was
// typed by hand)
const cappedFy2025 = capData.history.capped[capData.history.years.indexOf(2025)];
const REPO_DATA = "https://github.com/timshores/schools/blob/main/ppe_report/data/";
const SOURCE_FILES: { group: string; files: { file: string; holds: string; source: string; url: string; retrieved: string }[] }[] = [
  { group: "School districts", files: [
    { file: "dese_expenditures.csv", holds: "Spending per pupil by category, and enrollment, for every district, FY2009 on",
      source: "DESE, District Expenditures by Spending Category", url: "https://educationtocareer.data.mass.gov/d/er3w-dyti", retrieved: "Oct 18, 2026" },
    { file: "dese_expenditures_fy2005_2008.csv", holds: "The same, FY2005 to FY2008",
      source: "DESE, Office of School Finance workbooks, public records request P004939-101625", url: `${REPO_DATA}dese_archive/README.md`, retrieved: "Oct 28, 2026" },
    { file: "dese_c70_profile.csv", holds: "Foundation enrollment and budget, required local contribution, Chapter 70 aid, and required and actual net school spending, by district and year",
      source: "DESE, Chapter 70 district profiles", url: "https://www.doe.mass.edu/finance/chapter70/default.html", retrieved: "Oct 18, 2026" },
    { file: "dese_c70_fy2023_reference.csv", holds: "FY2023 required and actual net school spending for every district, which replace the current profiles' misassigned FY2023 figures",
      source: "DESE, Chapter 70 district profiles, as downloaded in August 2025", url: "https://www.doe.mass.edu/finance/chapter70/default.html", retrieved: "Aug 2025" },
    { file: "dese_c70_regional_members.csv", holds: "Each regional district's member towns and their FY2025 required contributions",
      source: "DESE, FY2025 Chapter 70 regional district summary", url: "https://www.doe.mass.edu/finance/chapter70/fy2025/chapter-2025.html", retrieved: "Oct 21, 2026" },
    { file: "census_f33_ma.csv", holds: "Revenue by source for every Massachusetts school system, FY2009 to FY2024",
      source: "Census Bureau, Annual Survey of School System Finances", url: "https://www.census.gov/programs-surveys/school-finances.html", retrieved: "Oct 21, 2026" },
    { file: "dese_sped_expenditures.csv", holds: "Special education spending in eight categories, and all spending, for every district, FY2008 on",
      source: "DESE, Special Education Direct Expenditure Trends (RADAR)", url: "https://www.doe.mass.edu/research/radar/", retrieved: "Nov 3, 2026" },
    { file: "dese_circuit_breaker.csv", holds: "Circuit Breaker payments to every district, with the students and costs it claimed, FY2006 on",
      source: "DESE, Special Education Circuit Breaker Reimbursements", url: "https://educationtocareer.data.mass.gov/d/ab34-d3ma", retrieved: "Nov 3, 2026" },
    { file: "dese_nss_budgets.csv", holds: "Every district's budgeted, actual, and required net school spending, budgets FY2011 to FY2026",
      source: "DESE, net school spending compliance summaries (FY2010 to FY2020 from the Internet Archive)", url: "https://www.doe.mass.edu/finance/chapter70/compliance.html", retrieved: "Nov 5, 2026" },
    { file: "dese_enrollment.csv", holds: "Every district's students by race and ethnicity, gender, and selected groups, each October 1 from 1991",
      source: "DESE, Enrollment: Grade, Race/Ethnicity, Gender, and Selected Populations", url: "https://educationtocareer.data.mass.gov/d/t8td-gens", retrieved: "Nov 5, 2026" },
    { file: "nces_ma_districts.csv", holds: "The crosswalk from federal district IDs to DESE's district codes",
      source: "NCES Common Core of Data, through the Urban Institute's Education Data Portal", url: "https://educationdata.urban.org/", retrieved: "Oct 21, 2026" },
  ] },
  { group: "School districts before FY2005", files: [
    { file: "dese_day_program_fy1990_2006.csv", holds: "DESE's older, narrower day-program spending per pupil, by program and in total, for every district, FY1990 to FY2006",
      source: "DESE, Per Pupil Expenditures reports and workbooks, the same request", url: `${REPO_DATA}dese_archive/README.md`, retrieved: "Oct 28, 2026" },
    { file: "dese_archive/README.md", holds: "The 25 files DESE sent, as received, and how the scanned reports were read and checked",
      source: "DESE, Public Records Center", url: "https://www.doe.mass.edu/", retrieved: "Oct 28, 2026" },
    { file: "nces_ma_enrollment_fy1990_2006.csv", holds: "Each district's fall enrollment, FY1990 to FY2006, which weights the older measure's averages before FY1997",
      source: "NCES Common Core of Data, through the Urban Institute's Education Data Portal", url: "https://educationdata.urban.org/", retrieved: "Oct 30, 2026" },
  ] },
  { group: "Chapter 70 formula", files: [
    { file: "dese_c70_townwide.csv", holds: "Every town's FY2026 and FY2027 local contribution calculation, before and after the 82.5% cap",
      source: "DESE, complete Chapter 70 formula spreadsheets", url: "https://www.doe.mass.edu/finance/chapter70/fy2027/chapter-2027.xlsm", retrieved: "Oct 21, 2026" },
    { file: "dese_c70_town_history.csv", holds: "Every town's yield, foundation budget, target and required contribution, FY2007 on",
      source: "DESE, Chapter 70 Trends in Aid and Local Contribution", url: "https://www.doe.mass.edu/finance/chapter70/keyfactors.xlsx", retrieved: "Oct 21, 2026" },
  ] },
  { group: "Cities and towns", files: [
    { file: "dls_schedule_a_general_fund.csv", holds: "General fund revenue by source and spending by function, FY2002 on",
      source: "Division of Local Services, Schedule A", url: "https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=ScheduleA.GenFund_MAIN", retrieved: "Oct 21, 2026" },
    { file: "dls_la4_parcels.csv", holds: "Parcels and assessed values by property use, FY2003 on",
      source: "Division of Local Services, LA-4", url: "https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=PropertyTaxInformation.LA4.Parcel_counts_vals", retrieved: "Oct 21, 2026" },
    { file: "dls_eqv.csv", holds: "Equalized valuations, 1970 on",
      source: "Division of Local Services, Equalized Valuations", url: "https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=PropertyTaxInformation.EQV.EQV", retrieved: "Oct 21, 2026" },
    { file: "dls_single_family_tax_bill.csv", holds: "Average single-family value and tax bill, and income per capita, 1988 on",
      source: "Division of Local Services, Average Single Family Tax Bill", url: "https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=AverageSingleTaxBill.SingleFamTaxBill_wRange", retrieved: "Oct 21, 2026" },
    { file: "dls_levy_capacity.csv", holds: "Proposition 2½ levy limit, levy, excess capacity and ceiling, FY2007 on",
      source: "Division of Local Services, Excess Levy Capacity and Overrides", url: "https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=Prop2.5.ExcessLevyCapandOverride_10_pres", retrieved: "Oct 21, 2026" },
    { file: "dls_free_cash.csv", holds: "Free cash certified as of July 1, and the prior year's operating budget, FY2002 on",
      source: "Division of Local Services, Certified Free Cash as a % of Budget", url: "https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=Dashboard.Cat_1_Reports.CertifiedFreeCashBudget351", retrieved: "Nov 3, 2026" },
    { file: "dls_free_cash_proof.csv", holds: "What each year's free cash was made of: revenue above its estimates, appropriations left unspent, the year before's free cash not spent, and adjustments, FY2021 on",
      source: "Division of Local Services, Bureau of Accounts, Free Cash Proof Comparison", url: "https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=BalanceSheet.FreecashProofComp", retrieved: "Nov 4, 2026" },
    { file: "dls_stabilization.csv", holds: "Stabilization and special-purpose stabilization fund balances at June 30, and the operating budget, FY2002 on",
      source: "Division of Local Services, Stabilization Funds as a % of Budget", url: "https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=Dashboard.Cat_1_Reports.StablPerBudget351", retrieved: "Nov 3, 2026" },
    { file: "dls_long_term_debt.csv", holds: "Long-term debt outstanding, general fund debt service, and the budget, FY2003 on",
      source: "Division of Local Services, Long-Term Debt", url: "https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=Dashboard.Cat_6_Reports.LongTermDebt351", retrieved: "Nov 3, 2026" },
    { file: "dls_authorized_debt.csv", holds: "Debt authorized, issued, retired or rescinded, and not yet issued, FY2003 on",
      source: "Division of Local Services, Total Authorized and Unissued Debt", url: "https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=Dashboard.Cat_6_Reports.TotalAuthUnisDebt351", retrieved: "Nov 3, 2026" },
    { file: "dls_bond_ratings.csv", holds: "Moody's and S&P ratings of each town's bonds, 2001 on",
      source: "Division of Local Services, Bond Ratings", url: "https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=DLS_Bond_Ratings", retrieved: "Nov 3, 2026" },
    { file: "dls_prop25_votes.csv", holds: "Every override, underride, debt and capital exclusion, and stabilization fund vote the state records, with results and amounts",
      source: "Division of Local Services, Proposition 2½ votes", url: "https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=Votes.Prop2_5.OverrideUnderride", retrieved: "Nov 3, 2026" },
    { file: "dls_capital_projects.csv", holds: "Capital projects fund revenue and spending by purpose, FY2002 on",
      source: "Division of Local Services, Schedule A Part 4", url: "https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=ScheduleA.CapitalProjects.CapitalProjects", retrieved: "Nov 3, 2026" },
    { file: "dls_labor_force.csv", holds: "Labor force, employed, unemployed, and the unemployment rate, 1990 to 2022",
      source: "Division of Local Services, Labor Force", url: "https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=Dashboard.TrendAnalysisReports.LaborForce", retrieved: "Nov 3, 2026" },
    { file: "census_town_population.csv", holds: "Population on July 1 at the start of each fiscal year, FY2005 on",
      source: "Census Bureau, subcounty population estimates", url: "https://www.census.gov/programs-surveys/popest.html", retrieved: "Oct 21, 2026" },
    { file: "census_town_demographics.csv", holds: "Population by sex, age, race and Hispanic or Latino origin, and disability, in the five-year releases that don't overlap: 2005–2009, 2010–2014, 2015–2019, 2020–2024",
      source: "Census Bureau, American Community Survey, tables B01001, B03002 and B18101", url: "https://www.census.gov/programs-surveys/acs", retrieved: "Nov 3, 2026" },
    { file: "census_town_households.csv", holds: "Households, each five-year release from 2005–2009 on",
      source: "Census Bureau, American Community Survey, table B11001", url: "https://www.census.gov/programs-surveys/acs", retrieved: "Oct 21, 2026" },
    { file: "town_boundaries.json", holds: "Town outlines for the map, and each town's land area",
      source: "Census Bureau, 2023 cartographic boundary file", url: "https://www2.census.gov/geo/tiger/GENZ2023/shp/cb_2023_25_cousub_500k.zip", retrieved: "Oct 22, 2026" },
  ] },
  { group: "Prices", files: [
    { file: "inflation_indices.csv", holds: "Fiscal-year averages of the Northeast consumer price index",
      source: "Bureau of Labor Statistics, CPI-U Northeast", url: "https://data.bls.gov/timeseries/CUUR0100SA0", retrieved: "Oct 18, 2026" },
  ] },
];

// The charts of the School districts and Towns tabs, one figure each, built here from this list (#237). explorer.ts
// draws into the elements their ids name: fig-, svg- and legend- with the key, the key with -sub (and -none and
// -body), the cmp- boxes of the comparison table, the button's data-table. {dper} and {per} stand where a title or
// a chart's description names the amounts, per pupil or per resident until the reader picks others: explorer.ts
// rewrites the headings' spans, and the descriptions from data-aria-dper and data-aria-per.
type Chart = {
  key: string;
  /** The parts of About the data the chart draws on, which explorer.ts links under it */
  about: string;
  title: string;
  /** What the chart draws, for a screen reader */
  svg: string;
  /** The legend's name, where its entries are buttons */
  legend?: string;
  /** A note can stand in for the chart, in {key}-none; the rest is in {key}-body, to go with it */
  none?: boolean;
  /** The chart's own choice of what it shows, over its legend; the first option is the one shown */
  views?: { label: string; note: string; options: { value: string; text: string }[] };
  /** A small chart under the chart, its title and legend in a row above it; box, the id of one explorer.ts shows only
   * when it has something to draw, which starts hidden */
  rating?: { title: string; legend: string; legendLabel?: string; svg: string; label: string; box?: string; hidden?: boolean;
    note?: string };
  /** The comparison table's boxes: cmp- and each of these */
  compare?: string[];
  /** A table of its own under the button, folded */
  votes?: { id: string; summary: string };
};
const DISTRICT_CHARTS: Chart[] = [
  { key: "ppe", about: "spending-per-pupil since-1990", title: "Spending{dper} by category",
    legend: "Spending categories. Select one or more to show only those.",
    svg: "Stacked columns of spending{dper} by category for each fiscal year.", compare: ["ppe", "day"] },
  { key: "sped", about: "special-education", title: "Special education spending{dper} by category", none: true,
    legend: "Special education spending categories. Select one or more to show only those.",
    svg: "Stacked columns of special education spending{dper} by category for each fiscal year.", compare: ["sped"] },
  { key: "enroll", about: "enrollment", title: "Enrollment",
    svg: "Lines of in-district, foundation, and out-of-district enrollment for each fiscal year.", compare: ["enroll"] },
  { key: "ood", about: "spending-on-out-of-district-fte", title: "Spending on out-of-district FTE",
    svg: "Columns of what the district pays to educate its pupils elsewhere, for each fiscal year.", compare: ["ood"] },
  { key: "srace", about: "students", title: "Students by race and ethnicity",
    legend: "Race and ethnicity groups. Select one or more to show only those.",
    svg: "Stacked columns of students' shares by race and Hispanic or Latino origin for each fiscal year." },
  { key: "sgroups", about: "students", title: "Students in selected groups",
    svg: "Lines of the shares of students with disabilities, English learners, low income students, and students with high needs for each fiscal year." },
  { key: "nss", about: "chapter-70-aid-and-net-school-spending", title: "Chapter 70 aid and net school spending",
    legend: "Net school spending components. Select one or more to show only those.",
    svg: "Stacked columns of Chapter 70 aid, required local contribution, and local contribution above required{dper} for each fiscal year.",
    compare: ["nss"] },
  { key: "nssb", about: "budgets", title: "Budgeted and actual net school spending{dper}", none: true,
    svg: "Lines of budgeted, actual, and required net school spending{dper} for each fiscal year.",
    rating: { title: "Actual vs. budget", legend: "nssb-gap-legend", svg: "svg-nssb-gap", label: "Actual vs. budget by year",
      note: "Actual vs. budget: each year's spending against its budget, in percent, the comparison's as dots" } },
  { key: "rev", about: "revenue-by-source", title: "Revenue{dper} by source", none: true,
    legend: "Revenue sources. Select one or more to show only those.",
    svg: "Stacked columns of revenue{dper} by source for each fiscal year.", compare: ["rev"] },
];
const TOWN_CHARTS: Chart[] = [
  { key: "tspend", about: "town-budgets town-and-school-budgets-overlap-without-lining-up", title: "General fund spending{per} by function",
    legend: "Spending functions. Select one or more to show only those.",
    svg: "Stacked columns of general fund spending{per} by function for each fiscal year.", compare: ["tspend"] },
  { key: "trev", about: "town-budgets revenue-groups", title: "General fund revenue{per} by source",
    legend: "Revenue sources. Select one or more to show only those.",
    svg: "Stacked columns of general fund revenue{per} by source for each fiscal year.", compare: ["trev"] },
  { key: "tres", about: "reserves", title: "Reserves{per}", legend: "Reserves. Select one or more to show only those.",
    svg: "Stacked columns of stabilization funds and free cash{per} at each fiscal year's end.", compare: ["tres"] },
  { key: "tfc", about: "where-free-cash-comes-from", title: "Where free cash comes from{per}",
    svg: "Stacked columns of what each year's free cash was made of: the year before's free cash not spent, appropriations left unspent, and revenue above its estimates, less shortfalls and adjustments." },
  { key: "tlevy", about: "the-property-tax-levy proposition-2-votes", title: "Property tax levy and its limit{per}",
    legend: "Levy and unused capacity. Select one to show only it.",
    svg: "Stacked columns of the property tax levy and unused levy capacity{per} for each fiscal year.", compare: ["tlevy"],
    votes: { id: "tvotes", summary: "Proposition 2½ votes" } },
  { key: "tbill", about: "property", title: "Average single-family tax bill",
    svg: "Line of the average single-family tax bill for each fiscal year." },
  { key: "tdebt", about: "long-term-debt", title: "Long-term debt{per}", legend: "Debt outstanding and authorized. Select one to show only it.",
    svg: "Stacked columns of long-term debt outstanding and debt authorized but not yet borrowed{per} at each fiscal year's end.",
    rating: { title: "Bond ratings", legend: "trating-legend", legendLabel: "Rating agencies", svg: "svg-trating", label: "Bond rating by year",
      box: "trating", hidden: true },
    compare: ["tdebt"] },
  { key: "tcap", about: "capital-projects", title: "Capital projects spending{per} by purpose",
    legend: "Capital project purposes. Select one or more to show only those.",
    svg: "Stacked columns of capital projects fund spending{per} by purpose for each fiscal year.", compare: ["tcap"] },
  { key: "tval", about: "property", title: "Assessed value{per} by property type", legend: "Property types. Select one or more to show only those.",
    svg: "Stacked columns of assessed property value{per} by property type for each fiscal year.", compare: ["tval"] },
  { key: "tpar", about: "property", title: "Parcels by property type", legend: "Property types. Select one or more to show only those.",
    svg: "Stacked columns of parcels by property type for each fiscal year.", compare: ["tpar"] },
  { key: "teqv", about: "equalized-valuation-eqv", title: "Equalized valuation{per}",
    svg: "Line of equalized valuation{per}, every other fiscal year." },
  { key: "tpop", about: "population-estimates labor-force", title: "Population and labor force",
    views: { label: "What the chart shows", note: "The unemployment rate first; the residents, labor force and employed behind it a click away",
      options: [{ value: "rate", text: "Unemployment rate" }, { value: "people", text: "Population and labor force" }] },
    svg: "Lines of population, labor force, and employment for each fiscal year." },
  { key: "tage", about: "population-by-age-race-and-ethnicity", title: "Population by age",
    legend: "Age groups. Select one or more to show only those.",
    svg: "Stacked columns of residents' shares by age for each of the Census Bureau's five-year estimates." },
  { key: "trace", about: "population-by-age-race-and-ethnicity", title: "Population by race and ethnicity",
    legend: "Race and ethnicity groups. Select one or more to show only those.",
    svg: "Stacked columns of residents' shares by race and Hispanic or Latino origin for each of the Census Bureau's five-year estimates." },
  { key: "tsex", about: "population-by-age-race-and-ethnicity", title: "Women in the population",
    legend: "Women, with its trend and the comparison",
    svg: "Columns of the share of residents who are women for each of the Census Bureau's five-year estimates." },
  { key: "tdis", about: "population-by-age-race-and-ethnicity", title: "Population with a disability",
    legend: "Population with a disability, with the trend and the comparison",
    svg: "Columns of the share of residents with a disability for each of the Census Bureau's five-year estimates." },
];
// The two tabs' sets of charts, each in a box the explorer shows with its tab
const PANELS = [
  { id: "panels", view: "districts", charts: DISTRICT_CHARTS },
  { id: "town-panels", view: "towns", charts: TOWN_CHARTS, hidden: true },
];
// Every chart's description ends the same way: it reads year by year, and its table has the rest
const KEYS = " Use the arrow keys to read each year; the data table below has every value.";
// The description with the amounts explorer.ts first fills in: per pupil (per foundation pupil on the two net school
// spending charts), per resident
const asFirst = (c: Chart) => (c.svg + KEYS)
  .replace("{dper}", ["nss", "nssb"].includes(c.key) ? " per foundation pupil" : " per pupil").replace("{per}", " per resident");
---

<Layout
  title="Massachusetts municipal spending explorer - Tim Shores"
  description="Per-pupil spending, enrollment, Chapter 70 aid, and revenue for every Massachusetts school district, and the general fund budgets of all 351 cities and towns, FY2005 to FY2025"
>
  <section id="explorer" class="explorer is-loading">
    <p class="eyebrow">Massachusetts</p>
    <h1>Municipal spending explorer</h1>
    <details class="intro" id="intro" data-remember="intro">
    <summary>About this explorer</summary>
    <p class="lede">
      Why do our <span class="swap" data-districts="schools" data-towns="municipal services">schools</span> cost so
      much? Or are we not spending enough tax dollars on our
      <span class="swap" data-districts="schools" data-towns="towns">schools</span>? These are difficult questions to
      answer because it depends on your basis of comparison. Use this Explorer to discover the cost of your
      <span class="swap" data-districts="school" data-towns="town">school</span>.
    </p>
    <p class="lede">
      This explorer continues the work of my report on
      <a href="/artifacts/western-ma-ppe-report-fy2025.pdf">per-pupil expenditure in Western Massachusetts</a>.
    </p>
    <p class="lede"><em>You'll probably have a better experience exploring on a desktop than a mobile browser. I'll work on making that better.</em></p>
    </details>
    <script is:inline>
      // Open unless this browser remembers it closed; decided here, before the page paints, so it
      // never flashes. The section is the element just before this script (explorer.ts remembers changes).
      (function () {
        var d = document.currentScript.previousElementSibling;
        var closed = false;
        try {
          closed = localStorage.getItem("mass-school-spending:remember") === "yes" &&
            localStorage.getItem("mass-school-spending:" + d.dataset.remember) === "closed";
        } catch (e) {}
        if (!closed) d.open = true;
      })();
    </script>

    <div class="view-tabs">
      <div class="view-tablist" role="tablist" aria-label="Explorer view">
      <button type="button" role="tab" id="tab-districts" data-view="districts" aria-controls="view-panel" aria-selected="true">School districts</button>
      <button type="button" role="tab" id="tab-towns" data-view="towns" aria-controls="view-panel" aria-selected="false" tabindex="-1">Towns</button>
      <button type="button" role="tab" id="tab-commonwealth" data-view="commonwealth" aria-controls="view-panel" aria-selected="false" tabindex="-1">Common&shy;wealth</button>
      <button type="button" role="tab" id="tab-cap" data-view="cap" aria-controls="view-panel" aria-selected="false" tabindex="-1">The 82.5% cap</button>
      <button type="button" role="tab" id="tab-data" data-view="data" aria-controls="view-panel" aria-selected="false" tabindex="-1">Data</button>
      </div>
      <!-- Extra detail on or off: off leaves the controls, tiles, charts and legends -->
      <button type="button" class="detail-dial" id="detail-dial" role="switch" aria-checked="true">
        <span class="dial-label">Detail</span>
        <span class="dial-face" aria-hidden="true"><span class="dial-pointer"></span></span>
        <span class="dial-state" aria-hidden="true">On</span>
      </button>
    </div>

    <div id="view-panel" role="tabpanel" aria-labelledby="tab-districts">
    <form class="controls" onsubmit="return false" data-view-only="districts towns">
      <div class="control" data-view-only="districts">
        <!-- Districts that no longer exist: a link at the foot of this menu lists them (explorer.ts, switchMenu) -->
        <span id="pick-district-label">District</span>
        <select id="pick-district" aria-labelledby="pick-district-label"></select>
      </div>
      <div class="control" data-view-only="districts">
        <span class="district-head">
          <span id="pick-compare-label">Compare with</span>
          <!-- Swap: the comparison takes the focus, and this becomes the comparison (explorer.ts, swapButton) -->
          <button type="button" class="swap-btn is-idle" id="swap-district">⇄ Swap</button>
        </span>
        <div class="cmp-row">
          <select id="pick-compare" aria-labelledby="pick-compare-label" aria-describedby="cmp-name">
            <option value="none">No comparison</option>
            <option value="cohort">Its enrollment group in its region</option>
            <option value="cohort-state">Its enrollment group statewide</option>
            <option value="region">Its region</option>
            <option value="state-all">Statewide</option>
            <option value="state">Statewide, without the 10 very large districts</option>
