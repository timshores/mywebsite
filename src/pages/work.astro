---
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/profile";
---

<Layout title={`Work - ${profile.name}`} description="Detailed work history">
  <h1>Work History</h1>
  <p class="subtitle">
    Detailed experience across technical communication, knowledge architecture, data,
    operations, policy research, and community work.
  </p>

  <div class="timeline">
    {profile.experience.map((item) => (
      <article class="timeline-item">
        <h3>{item.role}</h3>
        <p class="company">
          {item.company} | {item.period}
        </p>
        <p class="lead">{item.highlights[0]}</p>
        {item.highlights.length > 1 && (
          <details class="more">
            <summary>{item.highlights.length - 1} more {item.highlights.length === 2 ? "detail" : "details"}</summary>
            <ul>
              {item.highlights.slice(1).map((line) => <li>{line}</li>)}
            </ul>
          </details>
        )}
      </article>
    ))}
  </div>
</Layout>

<style>
  .subtitle {
    font-size: 1.08rem;
    margin-bottom: 1.45rem;
  }

  .timeline {
    display: grid;
    gap: 0.75rem;
  }

  .timeline-item {
    border-left: 4px solid var(--accent-2);
    border-radius: 0 0.75rem 0.75rem 0;
    border-top: 1px solid var(--line);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--card);
    padding: 0.82rem 0.95rem;
  }

  .timeline-item ul {
    margin-left: 1rem;
    color: var(--ink-soft);
  }

  .lead {
    max-width: none;
    margin-bottom: 0.4rem;
  }

  .more summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 500;
    font-size: 0.92rem;
  }

  .more[open] summary {
    margin-bottom: 0.45rem;
  }

  .company {
    color: var(--ink-soft);
    font-size: 0.88rem;
    margin-bottom: 0.45rem;
  }
</style>
