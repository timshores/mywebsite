---
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/profile";
---

<Layout title={`Work - ${profile.name}`} description="Detailed work history">
  <h1>Work History</h1>
  <p class="subtitle">
    Detailed experience across technical communication, knowledge architecture, data,
    operations, policy research, and community work.
  </p>

  <div class="timeline">
    {profile.experience.map((item) => (
      <article class="timeline-item" data-expandable data-keep-left-rail>
        <h3>{item.role}</h3>
        <p class="company">
          {item.company} | {item.period}
        </p>
        <ul>
          {item.highlights.map((line) => <li>{line}</li>)}
        </ul>
      </article>
    ))}
  </div>
</Layout>

<style>
  .subtitle {
    font-size: 1.08rem;
    margin-bottom: 1.45rem;
  }

  .timeline {
    display: grid;
    gap: 0.75rem;
  }

  .timeline-item {
    border-left: 4px solid var(--accent-2);
    border-radius: 0 0.75rem 0.75rem 0;
    border-top: 1px solid var(--line);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--card);
    padding: 0.82rem 0.95rem;
  }

  .timeline-item ul {
    margin-left: 1rem;
    color: var(--ink-soft);
  }

  .company {
    color: var(--ink-soft);
    font-size: 0.88rem;
    margin-bottom: 0.45rem;
  }
</style>
