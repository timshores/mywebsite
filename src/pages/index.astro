---
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/profile";
import { resume } from "../data/resume";
---

<Layout title={`${profile.name} - Portfolio`} description={profile.headline}>
  <section class="hero-section">
    <div class="hero-text">
      <p class="kicker">Portfolio / Resume / Who I Am</p>
      <h1>{profile.name}</h1>
      <p class="headline">
        {profile.headlineLines[0]}
        <br>
        {profile.headlineLines[1]}
      </p>
      <p class="location">{profile.location}</p>
      <div class="hero-actions">
        <a href={resume.href} class="button" download={resume.fileName}>Download Resume</a>
      </div>
    </div>
    <div class="portrait-container">
      <img
        src="/portrait-a.png"
        alt="Tim Shores portrait"
        class="portrait-image"
        data-image-swap
        data-dot-matrix-src="/portrait-a.png"
        data-live-src="/portrait-b.png"
      />
    </div>
  </section>

  <h2>About</h2>
  <div class="about-card" data-expandable>
    {profile.summary.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <h2>Core Focus</h2>
  <div class="focus-groups">
    <section class="focus-group" data-expandable>
      <h3>Practice Areas</h3>
      <ul class="focus-list">
        {profile.focusAreas.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <section class="focus-group" data-expandable>
      <h3>Working Skills</h3>
      <ul class="focus-list">
        {profile.topSkills.map((skill) => <li>{skill}</li>)}
      </ul>
    </section>
  </div>

  <h2>Selected Work</h2>
  <div class="experience-grid">
    {profile.selectedWork.map((project) => (
      <article class="experience-item" data-expandable data-keep-left-rail>
        <span class="project-tag">{project.domain}</span>
        <h3>{project.title}</h3>
        <p>{project.description}</p>
        <p class="impact">{project.impact}</p>
        <div class="project-details">
          {project.skills.map((skill) => <span data-expandable>{skill}</span>)}
        </div>
      </article>
    ))}
  </div>

  <h2>Credentials</h2>
  <div class="credentials-grid">
    <section class="credential-card" data-expandable>
      <h3>Certifications</h3>
      <ul>
        {profile.certifications.map((cert) => <li>{cert}</li>)}
      </ul>
    </section>

    <section class="credential-card" data-expandable>
      <h3>Education</h3>
      <ul>
        {profile.education.map((edu) => (
          <li>
            <strong>{edu.school}</strong>
            <span>{edu.credential}</span>
            {edu.period && <small>{edu.period}</small>}
          </li>
        ))}
      </ul>
    </section>
  </div>

  <h2>Community</h2>
  <div class="about-card" data-expandable>
    <p>
      I currently serve in local civic and education leadership roles, where policy,
      budgets, and community needs are translated into decisions people can use.
    </p>
    <ul>
      {profile.civicRoles.map((role) => <li>{role}</li>)}
    </ul>
  </div>
</Layout>

<style>
  .hero-section {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 2.2rem;
  }

  .kicker {
    display: inline-block;
    font-size: 0.77rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    margin-bottom: 0.7rem;
    color: var(--ink-soft);
  }

  .headline {
    font-size: clamp(1.1rem, 2.4vw, 1.45rem);
    color: var(--ink);
    max-width: 35ch;
  }

  .location {
    color: var(--ink-soft);
    margin-top: 0.25rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .button {
    text-decoration: none;
    color: #fff;
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    border: 1px solid transparent;
    border-radius: 0.7rem;
    padding: 0.55rem 0.9rem;
    font-size: 0.92rem;
  }

  .button-light {
    color: var(--ink);
    background: #fff;
    border-color: var(--line);
  }

  .portrait-container {
    position: relative;
    justify-self: end;
    width: min(320px, 100%);
    border-radius: 1.4rem;
    border: 1px solid var(--line);
    box-shadow: 0 14px 35px var(--shadow);
    overflow: hidden;
    background: #e9e3d7;
  }

  .portrait-image {
    display: block;
    width: 100%;
    height: auto;
    cursor: pointer;
    transition: filter 0.12s ease;
    will-change: transform, filter;
  }

  .portrait-image:hover {
    filter: contrast(1.03);
  }

  .portrait-image.is-dotmatrix {
    image-rendering: pixelated;
    filter: contrast(1.08) saturate(0.82);
  }

  .portrait-image.is-live {
    filter:
      sepia(0.2)
      saturate(0.86)
      hue-rotate(-8deg)
      contrast(1.04)
      brightness(1.02);
  }

  .about-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: 1rem;
    backdrop-filter: blur(4px);
  }

  .about-card ul {
    margin-left: 1rem;
    color: var(--ink-soft);
  }

  .focus-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .focus-group {
    border: 1px solid var(--line);
    border-radius: 0.8rem;
    background: var(--card);
    padding: 0.95rem 1rem;
  }

  .focus-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    list-style: none;
    margin-top: 0.35rem;
  }

  .focus-list li {
    border: 1px solid var(--line);
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: #fff;
    font-size: 0.9rem;
  }

  .experience-grid {
    display: grid;
    gap: 0.85rem;
    margin-top: 0.2rem;
  }

  .experience-item {
    border-top: 1px solid var(--line);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    border-left: 4px solid var(--accent-2);
    border-radius: 0 0.8rem 0.8rem 0;
    background: var(--card);
    padding: 0.95rem 1rem;
  }

  .experience-item ul {
    margin-left: 1rem;
    color: var(--ink-soft);
  }

  .experience-item p {
    max-width: none;
  }

  .project-tag {
    display: inline-block;
    margin-bottom: 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.22rem 0.62rem;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .impact {
    color: var(--ink);
  }

  .project-details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.55rem;
  }

  .project-details span {
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 0.5rem;
    padding: 0.2rem 0.48rem;
    font-size: 0.85rem;
  }

  .company {
    font-size: 0.88rem;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }

  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .credential-card {
    border: 1px solid var(--line);
    border-radius: 0.8rem;
    background: var(--card);
    padding: 0.95rem 1rem;
  }

  .credential-card ul {
    margin-left: 1rem;
    color: var(--ink-soft);
  }

  .credential-card.full {
    grid-column: 1 / -1;
  }

  .credential-card li {
    margin-bottom: 0.45rem;
  }

  .credential-card span,
  .credential-card small {
    display: block;
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .hero-section {
      grid-template-columns: 1fr;
    }

    .portrait-container {
      justify-self: start;
      width: min(280px, 75%);
    }

    .focus-groups,
    .credentials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
