---
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/profile";
---

<Layout title={`Contact - ${profile.name}`} description="Contact and collaboration details">
  <h1>Get In Touch</h1>
  <p class="subtitle">
    Best for work where complex systems need to become legible to the people
    living with them: technical teams, civic groups, community organizations,
    and cross-functional partners trying to make better decisions together.
  </p>

  <div class="contact-grid">
    <article class="contact-item" data-expandable>
      <div class="contact-label">Email</div>
      <a href={`mailto:${profile.email}`} class="contact-value">{profile.email}</a>
    </article>

    <article class="contact-item" data-expandable>
      <div class="contact-label">LinkedIn</div>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="contact-value">
        linkedin.com/in/timshores
      </a>
    </article>

    <article class="contact-item" data-expandable>
      <div class="contact-label">Location</div>
      <span class="contact-value">{profile.location}</span>
    </article>
  </div>

  <div class="contact-note" data-expandable data-keep-left-rail>
    <h2>Great Fit For</h2>
    <ul>
      <li>Community-based participatory research that turns local experience into usable evidence</li>
      <li>Community building around policy, planning, budgets, and shared decisions</li>
      <li>Technical content strategy and knowledge architecture for complex products</li>
      <li>Data storytelling for civic, nonprofit, product, and policy work</li>
      <li>Facilitation and communication that help experts and communities understand each other</li>
    </ul>
  </div>

</Layout>

<style>
  .subtitle {
    font-size: 1.05rem;
    margin-bottom: 1.5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    margin-bottom: 1.4rem;
  }

  .contact-item {
    border: 1px solid var(--line);
    background: var(--card);
    border-radius: 0.9rem;
    padding: 0.9rem;
  }

  .contact-label {
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.28rem;
    color: var(--ink-soft);
  }

  .contact-value {
    color: var(--ink);
    word-break: break-word;
  }

  .contact-note {
    border-top: 1px solid var(--line);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    border-left: 4px solid var(--accent-2);
    border-radius: 0 0.8rem 0.8rem 0;
    background: var(--card);
    padding: 0.95rem 1rem;
  }

  .contact-note h2 {
    margin-top: 0;
  }

  .contact-note ul {
    margin-left: 1rem;
    color: var(--ink-soft);
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
