---
// The explorer moved to /mass-school-spending/ on 2026-10-21, the day it first went
// live, and to /muni-spending/ on 2026-11-01. This keeps links to the first address
// working, with their ?d= or ?view= selection; the meta refresh covers browsers
// without JavaScript.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Moved: Massachusetts municipal spending explorer</title>
    <link rel="canonical" href="https://timshores.com/muni-spending/" />
    <script is:inline>location.replace("/muni-spending/" + location.search + location.hash);</script>
    <meta http-equiv="refresh" content="0; url=/muni-spending/" />
  </head>
  <body>
    <p>The municipal spending explorer has moved to <a href="/muni-spending/">timshores.com/muni-spending</a>.</p>
  </body>
</html>
