---
// The explorer moved to /mass-school-spending/ on 2026-10-21, the day it first went
// live. This keeps links to the old address working, with their ?d= or ?view=
// selection; the meta refresh covers browsers without JavaScript.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Moved: Western MA school spending explorer</title>
    <link rel="canonical" href="https://timshores.com/mass-school-spending/" />
    <script is:inline>location.replace("/mass-school-spending/" + location.search + location.hash);</script>
    <meta http-equiv="refresh" content="0; url=/mass-school-spending/" />
  </head>
  <body>
    <p>The school spending explorer has moved to <a href="/mass-school-spending/">timshores.com/mass-school-spending</a>.</p>
  </body>
</html>
