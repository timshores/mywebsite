  .panel :global(.key.none) {
    width: 16px;
  }

  .panel svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: "Space Grotesk", sans-serif;
    touch-action: pan-y;
  }

  .panel svg:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .panel :global(.gridline) {
    stroke: var(--grid);
    stroke-width: 1;
  }

  .panel :global(.baseline) {
    stroke: var(--axis);
    stroke-width: 1;
  }

  .panel :global(.tick) {
    font-size: 12px;
    fill: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .panel :global(.cap),
  .panel :global(.end-label) {
    font-size: 12px;
    font-weight: 500;
    fill: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* A halo, so the latest value stays readable where a line passes behind it */
  .panel :global(.cap) {
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .panel :global(.band) {
    fill: var(--ink);
    opacity: 0.045;
  }

  .panel :global(.hit) {
    fill: transparent;
    cursor: crosshair;
  }

  .panel :global(.col) {
    transition: opacity 0.12s ease;
  }

  .panel :global(svg.has-hover .col:not(.is-hover)) {
    opacity: 0.55;
  }

  .panel :global(svg .col.faded),
  .panel :global(svg.has-hover .col.faded:not(.is-hover)) {
    opacity: 0.35;
  }

  .panel :global(.hatch-bg) {
    fill: var(--surface);
  }

  .panel :global(.hatch-line) {
    stroke: var(--ink-soft);
    stroke-width: 1.5;
  }

  /* Trend: dashed, on a paper-colored halo that keeps it legible across the columns */
  .panel :global(.trend-halo) {
    fill: none;
    stroke: var(--surface);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.85;
  }

  .panel :global(.trend-line) {
    fill: none;
    stroke-width: 2.25;
    stroke-dasharray: 7 5;
    stroke-linecap: round;
  }

  .panel :global(.overlay-line),
  .panel :global(.series-line) {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .panel :global(.dot) {
    stroke: var(--surface);
    stroke-width: 2;
  }

  .panel :global(.crosshair) {
    stroke: var(--axis);
    stroke-width: 1;
  }

  .panel :global(.hit),
  .panel :global(.overlay),
  .panel :global(.trend),
  .panel :global(.lines) {
    pointer-events: none;
  }

  .panel :global(.hit) {
    pointer-events: all;
  }

  /* Tooltip: value first, label after, line keys */
  .tooltip {
    position: absolute;
    z-index: 3;
    min-width: 13rem;
    max-width: min(25rem, calc(100% - 8px));
    padding: 0.6rem 0.75rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 8px 22px var(--shadow);
    pointer-events: none;
    font-size: 0.82rem;
  }

  .tooltip :global(.tip-title) {
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.3rem;
  }

  .tooltip :global(.tip-row) {
    display: grid;
    grid-template-columns: 16px auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5rem;
    line-height: 1.5;
  }

  .tooltip :global(.tip-value) {
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    text-align: right;
    min-width: 4.6rem;
  }

  .tooltip :global(.tip-label),
  .tooltip :global(.tip-title),
  .tooltip :global(.tip-note) {
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .tooltip :global(.tip-title) {
    color: var(--ink);
  }

  /* Keys sit beside the first line of a wrapped label */
  .tooltip :global(.tip-row .key) {
    align-self: start;
    margin-top: 0.55em;
  }

  .tooltip :global(.tip-row.strong) {
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.2rem;
    margin-bottom: 0.2rem;
  }

  .tooltip :global(.tip-note) {
    margin-top: 0.3rem;
    color: var(--muted);
  }

  /* Table view */
  .table-view {
    margin-top: 0.6rem;
    font-size: 0.85rem;
  }

  .table-view summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 500;
    width: max-content;
  }

  /* Full data table: a button that opens the overlay */
  .table-open {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.35rem;
    padding: 0;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .table-open:hover {
    color: var(--accent-2);
  }

  .table-open:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 3px;
  }

  .table-open-icon {
    font-size: 0.8rem;
    line-height: 1;
  }

  /* The overlay sizes to the table, past the page's central column, up to the
     viewport less a 16px margin; only very narrow screens still scroll */
  .table-dialog {
    margin: auto;
    width: fit-content;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 32px);
    padding: 0;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(31, 31, 28, 0.28);
  }

  .table-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .table-dialog::backdrop {
    background: rgba(31, 31, 28, 0.4);
  }

  .dialog-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 1.1rem 0.7rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .dialog-head h3 {
    margin: 0;
    font-size: 1.05rem;
    max-width: 60ch;
  }

  .dialog-close {
    flex: none;
    width: 2rem;
    height: 2rem;
    font: inherit;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--ink-soft);
    background: none;
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
  }

  .dialog-close:hover {
    border-color: var(--line);
    color: var(--ink);
  }

  .dialog-close:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .dialog-body.table-scroll {
    margin: 0;
    padding: 0 1.25rem 1rem;
    overflow: auto;
  }

  .table-dialog .dialog-body :global(table) {
    font-size: 0.82rem;
  }

  .table-dialog .dialog-body :global(thead th) {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--paper);
    min-width: 0;
    padding-top: 0.7rem;
    box-shadow: inset 0 -1px 0 var(--line);
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .table-dialog .dialog-body :global(th),
  .table-dialog .dialog-body :global(td) {
    padding: 0.3rem 0.4rem;
  }

  /* Comparison table: the report's layout and amber/teal shading */
  .compare-view :global(td.swatch-col),
  .compare-view :global(th.swatch-col) {
    width: 1.4rem;
    min-width: 0;
    padding-right: 0;
    text-align: center;
  }

  .compare-view :global(thead th.label-col) {
    text-align: left;
  }

  .compare-view :global(tr.total th),
  .compare-view :global(tr.total td) {
    border-top: 1px solid var(--ink-soft);
    font-weight: 600;
  }

  .compare-view :global(tbody th) {
    white-space: normal;
    min-width: 11rem;
  }

  .compare-view :global(td[title]) {
    cursor: help;
  }

  /* The note spans the table's width: it adds nothing to the box's width
     (width: 0) and stretches to fill it (min-width), but never past the
     visible scroll area (100cqw), where it stays put as the table scrolls. */
  .compare-view .table-scroll {
    container-type: inline-size;
  }

  .compare-view :global(.compare-box) {
    display: inline-block;
    vertical-align: top;
  }

  .compare-view :global(.compare-legend) {
    margin-top: 0.6rem;
    width: 0;
    min-width: min(100%, 100cqw);
    position: sticky;
    left: 0;
  }

  .compare-view :global(.compare-legend p) {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0.35rem 0 0;
    max-width: none;
  }

  .compare-view :global(.chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .compare-view :global(.chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .compare-view :global(.chip-box) {
    width: 1.6rem;
    height: 0.9rem;
    border-radius: 3px;
    box-shadow: inset 0 0 0 1px rgba(31, 31, 28, 0.08);
  }

  .explorer :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .table-scroll {
    overflow-x: auto;
    margin-top: 0.5rem;
  }

  .table-scroll :global(table) {
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .table-scroll :global(caption) {
    text-align: left;
    color: var(--ink-soft);
    padding-bottom: 0.4rem;
  }

  .table-scroll :global(th),
  .table-scroll :global(td) {
    padding: 0.25rem 0.6rem;
    border-bottom: 1px solid var(--grid);
    text-align: right;
  }

  .table-scroll :global(thead th) {
    color: var(--ink-soft);
    font-weight: 500;
    vertical-align: bottom;
    white-space: normal;
    min-width: 5.5rem;
  }

  .table-scroll :global(tbody th) {
    text-align: left;
    font-weight: 500;
  }

  /* Asks once, after the first change, whether to remember choices; never blocks the page */
  .remember-prompt {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 20;
    max-width: min(24rem, calc(100vw - 32px));
    padding: 1rem 1.1rem;
    font-size: 0.9rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 16px 40px rgba(31, 31, 28, 0.22);
  }

  .remember-prompt[hidden] {
    display: none;
  }

  .remember-prompt p {
    margin: 0 0 0.4rem;
  }

  .remember-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.7rem;
  }

  .remember-actions button {
    font: inherit;
    padding: 0.45rem 0.95rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
  }

  .remember-actions #remember-yes {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }

  .remember-actions button:focus-visible,
  .remember-note :global(.link-button:focus-visible) {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .remember-note :global(.link-button) {
    font: inherit;
    padding: 0;
    color: var(--accent);
    background: none;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  .notes {
    margin-top: 2.5rem;
    border-top: 1px solid var(--line);
    padding-top: 0.5rem;
  }

  .notes p {
    font-size: 0.92rem;
  }

  .notes strong {
    color: var(--ink);
  }

  .explorer :global(.load-error) {
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .controls {
      padding: 0.75rem;
    }

    .control,
    .control select,
    .explorer :global(.control .picker-button) {
      width: 100%;
      min-width: 0;
    }

    .explorer :global(.control .picker-panel) {
      width: 100%;
    }

    .tiles :global(.tile-value) {
      font-size: 1.3rem;
    }

  }

  /* Commonwealth tab: a gallery of plots, each opening full screen */
  .cw-intro {
    max-width: 68ch;
    color: var(--ink-soft);
    margin: 0.4rem 0 1.2rem;
  }

  .explorer :global(.cw-gallery) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .explorer :global(.cw-card) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-align: left;
    font: inherit;
    color: inherit;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.8rem;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .explorer :global(.cw-card:hover),
  .explorer :global(.cw-card:focus-visible) {
    border-color: var(--accent);
    box-shadow: 0 6px 18px var(--shadow);
    transform: translateY(-1px);
  }

  .explorer :global(.cw-thumb) {
    width: 100%;
    height: auto;
    aspect-ratio: 320 / 190;
    background: #fbf8f1;
    border-radius: 8px;
  }

  .explorer :global(.cw-card-title) {
    font-weight: 700;
    font-size: 1.02rem;
  }

  .explorer :global(.cw-card-blurb) {
    font-size: 0.86rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .explorer :global(.cw-card-axes) {
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: auto;
    padding-top: 0.2rem;
  }

  .explorer :global(.sc-grid line) {
    stroke: var(--grid);
  }

  .explorer :global(.sc-tick) {
    font-size: 11px;
    fill: var(--muted);
  }

  .explorer :global(.sc-title) {
    font-size: 12px;
    fill: var(--ink-soft);
  }

  .explorer :global(.sc-pt) {
    stroke: #fff;
    stroke-width: 0.6;
  }

  .explorer :global(.sc-smooth) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
  }

  .explorer :global(.sc-smooth.mini) {
    stroke-width: 1.5;
  }

  .explorer :global(.sc-label) {
    font-size: 11.5px;
    font-weight: 700;
    fill: #8a3f22;
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 3px;
  }

  .explorer :global(.sc-leader) {
    stroke: #8a3f22;
    stroke-width: 0.8;
  }

  .explorer :global(.sc-ring) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    pointer-events: none;
  }

  .explorer :global(.cw-dialog) {
    width: min(1400px, 96vw);
    max-width: none;
    height: 94vh;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }

  .explorer :global(.cw-dialog[open]) {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .explorer :global(.cw-dialog::backdrop) {
    background: rgba(31, 31, 28, 0.45);
  }

  .explorer :global(.cw-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.2rem 0.4rem;
  }

  .explorer :global(.cw-title) {
    font-size: 1.35rem;
    margin: 0;
  }

  .explorer :global(.cw-close) {
    font-size: 1.6rem;
    line-height: 1;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--ink-soft);
    padding: 0.2rem 0.5rem;
  }

  .explorer :global(.cw-controls) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    align-items: end;
    padding: 0 1.2rem 0.8rem;
  }

  .explorer :global(.cw-field) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .explorer :global(.cw-field select),
  .explorer :global(.cw-field input) {
    font: inherit;
    font-size: 0.88rem;
    color: var(--ink);
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    max-width: min(30rem, 100%);
  }

  .explorer :global(.cw-check) {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    font-size: 0.84rem;
    color: var(--ink-soft);
    padding-bottom: 0.4rem;
  }

  .explorer :global(.cw-body) {
    position: relative;
    flex: 1;
    min-height: 0;
    padding: 0.6rem 1.2rem 0.8rem;
    overflow: hidden;
  }

  .explorer :global(.cw-figure) {
    position: relative;
    margin: 0;
    min-width: 0;
  }

  .explorer :global(.cw-head-tools) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .explorer :global(.cw-drawer-toggle),
  .explorer :global(.cw-more) {
    font: inherit;
    font-size: 0.85rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .explorer :global(.cw-drawer-toggle[aria-expanded="true"]) {
    border-color: var(--accent);
    background: #fbf1ec;
  }

  .explorer :global(.cw-settings) {
    border-bottom: 1px solid var(--line);
  }

  .explorer :global(.cw-settings > summary) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0 1.2rem 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    cursor: pointer;
    list-style: none;
  }

  .explorer :global(.cw-settings > summary::-webkit-details-marker) {
    display: none;
  }

  .explorer :global(.cw-settings > summary::before) {
    content: "";
    width: 6px;
    height: 6px;
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(-45deg);
    transition: transform 0.12s ease;
  }

  .explorer :global(.cw-settings[open] > summary::before) {
    transform: rotate(45deg);
  }

  .explorer :global(.cw-finding-row) {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-top: 0.3rem;
  }

  .explorer :global(.cw-finding) {
    flex: 1;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .explorer :global(.cw-drawer) {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    width: min(380px, 100%);
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border-left: 1px solid var(--line);
    box-shadow: -10px 0 24px var(--shadow);
  }

  .explorer :global(.cw-drawer-head) {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.6rem 0.6rem 0.4rem 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .explorer :global(.cw-drawer-head .cw-close) {
    margin-left: auto;
  }

  .explorer :global(.cw-drawer-tab) {
    font: inherit;
    font-size: 0.85rem;
    color: var(--ink-soft);
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 0.3rem 0.4rem;
    cursor: pointer;
  }

  .explorer :global(.cw-drawer-tab.is-on) {
    color: var(--ink);
    font-weight: 600;
    border-bottom-color: var(--accent);
  }

  .explorer :global(.cw-drawer-panel) {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0.8rem 0.9rem 1rem;
  }

  .explorer :global(.cw-bars-key) {
    list-style: none;
    padding: 0;
    margin: 0 0 0.6rem;
    display: grid;
    gap: 0.2rem;
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  .explorer :global(.cw-bars-key li) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .explorer :global(.cw-bars-swatch) {
    width: 18px;
    height: 8px;
    border-radius: 4px;
    background: #2a78d6;
  }

  .explorer :global(.cw-bars-swatch.neg) {
    background: #eb6834;
  }

  .explorer :global(.cw-help) {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1.05rem;
    height: 1.05rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 50%;
    background: #fff;
    cursor: help;
  }

  .explorer :global(.cw-help:hover::after),
  .explorer :global(.cw-help:focus::after) {
    content: attr(data-tip);
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    width: 16rem;
    padding: 0.5rem 0.65rem;
