---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Western MA school spending explorer - Tim Shores"
  description="Per-pupil spending, enrollment, Chapter 70 aid, and revenue by source for Western Massachusetts school districts, and the general fund budgets of their towns, FY2009 to FY2025"
>
  <section id="explorer" class="explorer is-loading">
    <p class="eyebrow">Western Massachusetts · FY2009–FY<span data-latest>2025</span></p>
    <h1>School spending explorer</h1>
    <p class="lede">
      Per-pupil spending, enrollment, and state aid for 65 Western Massachusetts school districts, from the
      data behind my report on
      <a href="/artifacts/western-ma-ppe-report.pdf">per-pupil expenditure in Western Massachusetts</a>,
      and revenue by source for the 19 regional districts. The Towns tab shows the general fund budgets of the 97
      towns those districts serve.
    </p>

    <div class="view-tabs" role="tablist" aria-label="Explorer view">
      <button type="button" role="tab" id="tab-districts" data-view="districts" aria-controls="view-panel" aria-selected="true">School districts</button>
      <button type="button" role="tab" id="tab-towns" data-view="towns" aria-controls="view-panel" aria-selected="false" tabindex="-1">Towns</button>
    </div>

    <div id="view-panel" role="tabpanel" aria-labelledby="tab-districts">
    <form class="controls" onsubmit="return false">
      <label class="control" data-view-only="districts">
        <span>District</span>
        <select id="pick-district"></select>
      </label>
      <label class="control" data-view-only="districts">
        <span>Compare with</span>
        <select id="pick-compare">
          <option value="cohort">Its cohort average</option>
          <option value="western">Western MA average</option>
          <option value="other">Another district or average</option>
          <option value="none">No comparison</option>
        </select>
      </label>
      <label class="control" id="vs-control" hidden>
        <span>Comparison district</span>
        <select id="pick-vs"></select>
      </label>
      <label class="control" data-view-only="towns" hidden>
        <span>Town</span>
        <select id="pick-town"></select>
      </label>
      <label class="control" data-view-only="towns" hidden>
        <span>Compare with</span>
        <select id="pick-town-compare">
          <option value="peer">Its peer group average</option>
          <option value="western">Western MA towns average</option>
          <option value="other">Another town or average</option>
          <option value="none">No comparison</option>
        </select>
      </label>
      <label class="control" id="town-vs-control" hidden>
        <span>Comparison town or average</span>
        <select id="pick-town-vs"></select>
      </label>
      <fieldset class="control toggle">
        <legend>Dollars</legend>
        <div class="toggle-options">
          <label><input type="radio" name="dollars" value="nominal" checked /><span>Nominal</span></label>
          <label><input type="radio" name="dollars" value="real" /><span>FY<span data-latest>2025</span> dollars</span></label>
        </div>
      </fieldset>
      <p class="controls-note" id="dollars-note"></p>
      <div class="relations" id="relations" hidden></div>
    </form>

    <header class="entity">
      <h2 id="entity-name">Loading…</h2>
      <p id="entity-meta"></p>
    </header>

    <div id="tiles" class="tiles"></div>

    <div id="panels" class="panels" data-view-only="districts">
      <figure id="fig-ppe" class="panel">
        <h3>Spending per pupil by category</h3>
        <p class="panel-sub" id="ppe-sub"></p>
        <ul class="legend" id="legend-ppe" aria-label="Spending categories. Select one or more to show only those."></ul>
        <svg id="svg-ppe" tabindex="0" role="img" aria-label="Stacked columns of spending per pupil by category for each fiscal year. Use the arrow keys to read each year; the data table below has every value."></svg>
        <div class="tooltip" role="status" hidden></div>
        <details class="table-view compare-view">
          <summary>Comparison table</summary>
          <div class="table-scroll" id="cmp-ppe"></div>
        </details>
        <button type="button" class="table-open" data-table="ppe" aria-haspopup="dialog">
          <span class="table-open-icon" aria-hidden="true">⤢</span> Full data table
        </button>
      </figure>

      <figure id="fig-enroll" class="panel">
        <h3>Enrollment</h3>
        <p class="panel-sub" id="enroll-sub"></p>
        <ul class="legend" id="legend-enroll"></ul>
        <svg id="svg-enroll" tabindex="0" role="img" aria-label="Lines of in-district, foundation, and out-of-district enrollment for each fiscal year. Use the arrow keys to read each year; the data table below has every value."></svg>
        <div class="tooltip" role="status" hidden></div>
        <details class="table-view compare-view">
          <summary>Comparison table</summary>
          <div class="table-scroll" id="cmp-enroll"></div>
        </details>
        <button type="button" class="table-open" data-table="enroll" aria-haspopup="dialog">
          <span class="table-open-icon" aria-hidden="true">⤢</span> Full data table
        </button>
      </figure>

      <figure id="fig-nss" class="panel">
        <h3>Chapter 70 aid and net school spending</h3>
        <p class="panel-sub" id="nss-sub"></p>
        <ul class="legend" id="legend-nss" aria-label="Net school spending components. Select one or more to show only those."></ul>
        <svg id="svg-nss" tabindex="0" role="img" aria-label="Stacked columns of Chapter 70 aid, required local contribution, and spending above the requirement per foundation pupil for each fiscal year. Use the arrow keys to read each year; the data table below has every value."></svg>
        <div class="tooltip" role="status" hidden></div>
        <details class="table-view compare-view">
          <summary>Comparison table</summary>
          <div class="table-scroll" id="cmp-nss"></div>
        </details>
        <button type="button" class="table-open" data-table="nss" aria-haspopup="dialog">
          <span class="table-open-icon" aria-hidden="true">⤢</span> Full data table
        </button>
      </figure>

      <figure id="fig-rev" class="panel">
        <h3>Revenue per pupil by source</h3>
        <p class="panel-sub" id="rev-sub"></p>
        <p class="panel-none" id="rev-none" hidden></p>
        <div id="rev-body">
          <ul class="legend" id="legend-rev" aria-label="Revenue sources. Select one or more to show only those."></ul>
          <svg id="svg-rev" tabindex="0" role="img" aria-label="Stacked columns of revenue per pupil by source for each fiscal year. Use the arrow keys to read each year; the data table below has every value."></svg>
          <div class="tooltip" role="status" hidden></div>
          <details class="table-view compare-view">
            <summary>Comparison table</summary>
            <div class="table-scroll" id="cmp-rev"></div>
          </details>
          <button type="button" class="table-open" data-table="rev" aria-haspopup="dialog">
            <span class="table-open-icon" aria-hidden="true">⤢</span> Full data table
          </button>
        </div>
      </figure>
    </div>

    <div id="town-panels" class="panels" data-view-only="towns" hidden>
      <figure id="fig-tspend" class="panel">
        <h3>General fund spending per resident by function</h3>
        <p class="panel-sub" id="tspend-sub"></p>
        <ul class="legend" id="legend-tspend" aria-label="Spending functions. Select one or more to show only those."></ul>
        <svg id="svg-tspend" tabindex="0" role="img" aria-label="Stacked columns of general fund spending per resident by function for each fiscal year. Use the arrow keys to read each year; the data table below has every value."></svg>
        <div class="tooltip" role="status" hidden></div>
        <details class="table-view compare-view">
          <summary>Comparison table</summary>
          <div class="table-scroll" id="cmp-tspend"></div>
        </details>
        <button type="button" class="table-open" data-table="tspend" aria-haspopup="dialog">
          <span class="table-open-icon" aria-hidden="true">⤢</span> Full data table
        </button>
      </figure>

      <figure id="fig-trev" class="panel">
        <h3>General fund revenue per resident by source</h3>
        <p class="panel-sub" id="trev-sub"></p>
        <ul class="legend" id="legend-trev" aria-label="Revenue sources. Select one or more to show only those."></ul>
        <svg id="svg-trev" tabindex="0" role="img" aria-label="Stacked columns of general fund revenue per resident by source for each fiscal year. Use the arrow keys to read each year; the data table below has every value."></svg>
        <div class="tooltip" role="status" hidden></div>
        <details class="table-view compare-view">
          <summary>Comparison table</summary>
          <div class="table-scroll" id="cmp-trev"></div>
        </details>
        <button type="button" class="table-open" data-table="trev" aria-haspopup="dialog">
          <span class="table-open-icon" aria-hidden="true">⤢</span> Full data table
        </button>
      </figure>

      <figure id="fig-tpop" class="panel">
        <h3>Population</h3>
        <p class="panel-sub" id="tpop-sub"></p>
        <ul class="legend" id="legend-tpop"></ul>
        <svg id="svg-tpop" tabindex="0" role="img" aria-label="Line of population for each fiscal year. Use the arrow keys to read each year; the data table below has every value."></svg>
        <div class="tooltip" role="status" hidden></div>
        <button type="button" class="table-open" data-table="tpop" aria-haspopup="dialog">
          <span class="table-open-icon" aria-hidden="true">⤢</span> Full data table
        </button>
      </figure>
    </div>
    </div>

    <dialog id="table-dialog" class="table-dialog" aria-labelledby="table-dialog-title">
      <div class="dialog-head">
        <h3 id="table-dialog-title"></h3>
        <button type="button" class="dialog-close" aria-label="Close the table">×</button>
      </div>
      <div class="dialog-body table-scroll" id="table-dialog-body"></div>
    </dialog>

    <section class="notes">
      <h2>About the data</h2>
      <p>
        <strong>Spending per pupil</strong> is the Massachusetts Department of Elementary and Secondary Education's
        (DESE) <a href="https://educationtocareer.data.mass.gov/d/er3w-dyti">per-pupil expenditure</a>
        (<a href="/mass-school-spending/data/districts-spending-per-pupil.csv" download>CSV</a>) from each district's end-of-year report, divided by in-district FTE and grouped
        into the report's nine categories; its Other combines DESE's professional development and instructional
        materials, equipment, and technology. It leaves out tuition for pupils educated elsewhere, because, as DESE puts
        it, those costs "vary greatly depending on the reason for going out of district."
      </p>
      <p>
        <strong>Enrollment</strong> comes in three measures. In-district FTE is full-year enrollment of students who
        live in the district or are choiced or tuitioned into it. Foundation enrollment counts the residents the
        district is financially responsible for on October 1 of the prior year. Out-of-district FTE counts the
        district's pupils educated elsewhere. In-district and out-of-district FTE come from
        <a href="https://educationtocareer.data.mass.gov/d/er3w-dyti">DESE's expenditure data</a>
        (<a href="/mass-school-spending/data/districts-spending-per-pupil.csv" download>CSV</a>), foundation enrollment from its
        <a href="https://www.doe.mass.edu/finance/chapter70/default.html">Chapter 70 district profiles</a>
        (<a href="/mass-school-spending/data/districts-chapter70.csv" download>CSV</a>).
      </p>
      <p>
        <strong>Chapter 70 aid and net school spending</strong> are per foundation pupil, from DESE's
        <a href="https://www.doe.mass.edu/finance/chapter70/default.html">Chapter 70 district profiles</a>
        (<a href="/mass-school-spending/data/districts-chapter70.csv" download>CSV</a>). The state sets a required
        level of net school spending for each district each year. Chapter 70 aid pays part of it, and the town, or a
        regional district's member towns, pays the required local contribution. Anything above that is a local choice. Because spending per pupil and
        net school spending use different denominators, the two charts are not the same measure: they are a picture
        of apples in the morning compared with a picture of apples in the evening. Both dollar charts share one scale.
      </p>
      <p>
        <strong>Cohorts</strong> group districts by FY<span data-latest>2025</span> in-district FTE, using the
        boundaries <a href="/artifacts/western-ma-ppe-report.pdf">the report</a> set from FY2024 enrollment: Tiny up to 200 FTE, Small 201–800, Medium 801–1,600, and
        Large 1,601–10,000. Springfield stands apart. Cohort and Western MA spending averages are weighted by
        in-district FTE, Chapter 70 averages by foundation enrollment, and enrollment averages are per district. The
        Western MA average covers the 64 districts other than Springfield.
      </p>
      <p>
        <strong>Revenue by source</strong> comes from the Census Bureau's
        <a href="https://www.census.gov/programs-surveys/school-finances.html">Annual Survey of School System Finances</a>
        (<a href="/mass-school-spending/data/districts-revenue.csv" download>CSV</a>, in dollars, each column naming the Census items it adds up),
        divided by in-district FTE like spending. It covers the 19 regional districts only: for many town-run
        districts, Census's local revenue is only part of what the town spends on its schools (for Amherst in FY2024,
        $18.4 million of revenue against $37.6 million of spending). Payments from towns include a regional
        district's member-town assessments; payments from other school districts include tuition for pupils they
        send. Revenue per pupil usually runs about a third above spending per pupil, because it also pays for what
        the spending measure leaves out, such as tuition for pupils educated elsewhere, school buildings, and the
        teachers' pensions the state pays into the teachers' retirement system on districts' behalf. School building
        aid can arrive in one large payment. In FY2009 the state paid $412 million of Chapter 70 aid with federal
        stimulus money, so Census counts about a tenth of that year's Chapter 70 aid as federal. Census publishes
        each year's figures more than a year after it ends.
      </p>
      <p>
        <strong>Town budgets</strong> come from each town's <a href="https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=ScheduleA.GenFund_MAIN">Schedule A</a>
        (CSVs: <a href="/mass-school-spending/data/towns-spending.csv" download>spending</a>, <a href="/mass-school-spending/data/towns-revenue.csv" download>revenue</a>, each with population), the year-end report of general fund revenue and
        spending that town accountants file with the state Division of Local Services. Enterprise, capital, and other
        funds are not included. The towns are the 97 that the explorer's districts serve, by DESE's
        <a href="https://www.doe.mass.edu/finance/chapter70/fy2025/chapter-2025.html">FY2025 membership lists</a>
        (<a href="/mass-school-spending/data/towns-school-districts.csv" download>CSV</a>, with each town's required contributions), and the Western MA towns average pools them per resident, without Springfield. Peer groups put each
        town with others its size, by the July 2024 population estimate: under 1,000 residents (20 towns),
        1,000–2,499 (35), 2,500–9,999 (21), and 10,000 or more (20, without Springfield). Half the towns have fewer
        than 1,900 residents, so the groups are narrow at the small end. Peer averages pool their towns per resident,
        like the Western MA average. Dollars are per
        resident, using the Census Bureau's <a href="https://www.census.gov/programs-surveys/popest.html">population estimate</a> for July 1 at the start of each fiscal year. For FY2021
        the April 1, 2020 estimate stands in, because the July 2020 estimate drops by more than a quarter in Amherst
        and recovers a year later.
      </p>
      <p>
        <strong>Town and school budgets overlap without lining up.</strong> Education includes the town's own school
        department and what it pays regional and vocational school districts, so it does not match any one district's
        spending, and health insurance and pensions for a town's own school employees usually sit in fixed costs.
        State aid includes Chapter 70 aid for a town's own school district; aid to a regional district goes to the
        district. Intergovernmental assessments are the state and county charges on each town's Cherry Sheet, such as
        charter school and school choice tuition. Required local contributions are what the
        <a href="https://www.doe.mass.edu/finance/chapter70/fy2025/chapter-2025.html">Chapter 70 formula</a> sets
        for each town and district in FY2025.
      </p>
      <p>
        <strong>Revenue groups</strong> combine <a href="https://dls-gw.dor.state.ma.us/reports/rdPage.aspx?rdReport=ScheduleA.GenFund_MAIN">Schedule A</a>'s eleven sources into six: charges, fees, and fines are
        service charges, licenses and permits, fines and forfeitures, and special assessments; other revenue is
        miscellaneous revenue and revenue from other governments; transfers and other financing are transfers and
        other financing sources. Figures are as each town filed them, and a few look like one-time entries: Lee's
        FY2024 revenue includes $27.3 million of miscellaneous revenue, more than half its total.
      </p>
      <p>
        <strong>FY<span data-latest>2025</span> dollars</strong> adjust for inflation with the Bureau of Labor
        Statistics' <a href="https://data.bls.gov/timeseries/CUUR0100SA0">consumer price index for the Northeast</a>
        (<a href="/mass-school-spending/data/cpi.csv" download>CSV</a>; CPI-U, series CUUR0100SA0), averaged over each July–June
        fiscal year.
      </p>
      <p>
        The CSVs hold the data for these districts and towns as each agency published it, except that the revenue
        file adds Census items up into the chart's sources, and every row links to its source. Built by Tim Shores with Claude Code. The code that prepares the data is at
        <a href="https://github.com/timshores/schools">github.com/timshores/schools</a>.
      </p>
    </section>
  </section>
</Layout>

<script>
  import { startExplorer } from "../../lib/massppe/explorer";
  startExplorer();
</script>

<style>
  .explorer {
    --surface: var(--paper);
    --grid: #e9e3d7;
    --axis: #b9b1a2;
    --muted: #6d695e;
    font-variant-numeric: normal;
  }

  .explorer.is-loading .panels {
    opacity: 0.4;
  }

  .eyebrow {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }

  .lede {
    font-size: 1.05rem;
    max-width: 68ch;
  }

  /* Controls: one row above everything they scope */
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem 1.25rem;
    margin: 1.4rem 0 1.6rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.55);
  }

  .control {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink-soft);
    border: 0;
    min-width: 0;
  }

  .control[hidden] {
    display: none;
  }

  .controls-note {
    flex-basis: 100%;
    max-width: 92ch;
    margin: 0.1rem 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .controls-note :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .control select {
    font: inherit;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.45rem 0.6rem;
    max-width: 100%;
  }

  #pick-district,
  #pick-vs {
    min-width: 15rem;
  }

  .toggle legend {
    padding: 0;
    margin-bottom: 0.3rem;
  }


  .toggle-options {
    display: flex;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--paper);
  }

  .toggle-options label {
    position: relative;
    cursor: pointer;
  }

  .toggle-options input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }

  .toggle-options span {
    display: block;
    padding: 0.45rem 0.8rem;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--ink-soft);
  }

  .toggle-options span span {
    display: inline;
    padding: 0;
    color: inherit;
  }

  .toggle-options label + label {
    border-left: 1px solid var(--line);
  }

  .toggle-options input:checked + span {
    background: var(--ink);
    color: var(--paper);
  }

  .toggle-options input:checked + span span {
    background: none;
  }

  .toggle-options input:focus-visible + span {
    outline: 2px dashed var(--accent);
    outline-offset: -4px;
  }

  /* View tabs: an underline marks the open view */
  .view-tabs {
    display: flex;
    gap: 0.25rem;
    margin-top: 1.4rem;
    border-bottom: 1px solid var(--line);
  }

  .view-tabs [role="tab"] {
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: none;
    border: 0;
    border-radius: 8px 8px 0 0;
    padding: 0.55rem 1rem;
    margin-bottom: -1px;
    cursor: pointer;
  }

  .view-tabs [role="tab"]:hover {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.55);
  }

  .view-tabs [role="tab"][aria-selected="true"] {
    color: var(--ink);
    box-shadow: inset 0 -3px 0 var(--accent);
  }

  .view-tabs [role="tab"]:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: -4px;
  }

  .view-tabs + #view-panel .controls {
    margin-top: 1rem;
  }

  .panels[hidden] {
    display: none;
  }

  .entity h2 {
    margin: 0 0 0.25rem;
  }

  /* Relations outline: the selected district's towns or town's districts, with tree lines */
  .relations {
    flex-basis: 100%;
    margin-top: 0.2rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .relations[hidden] {
    display: none;
  }

  .relations :global(.rel-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.6rem;
    margin-bottom: 0.25rem;
  }

  .relations :global(.rel-head strong) {
    color: var(--ink);
    font-size: 0.95rem;
  }

  .relations :global(.rel-note) {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .relations :global(.rel-tree) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .relations :global(.rel-tree li) {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.9rem;
    padding: 0.2rem 0 0.2rem 1.5rem;
    line-height: 1.45;
  }

  /* Tree lines: a trunk down the left, a branch to each row, the trunk stopping at the last */
  .relations :global(.rel-tree li::before) {
    content: "";
    position: absolute;
    left: 0.45rem;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--axis);
  }

  .relations :global(.rel-tree li:last-child::before) {
    bottom: calc(100% - 0.95rem);
  }

  .relations :global(.rel-tree li::after) {
    content: "";
    position: absolute;
    left: 0.45rem;
    top: 0.95rem;
    width: 0.7rem;
    border-top: 1px solid var(--axis);
  }

  .relations :global(.rel-name) {
    min-width: 11rem;
    color: var(--ink);
    font-weight: 500;
  }

  .relations :global(.rel-kind) {
    min-width: 6.5rem;
  }

  .relations :global(.rel-amt) {
    min-width: 6.5rem;
    font-variant-numeric: tabular-nums;
  }

  .relations :global(.rel-extra) {
    flex: 1 1 18rem;
    color: var(--muted);
  }

  .relations :global(.rel-more) {
    font: inherit;
    color: var(--accent);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .relations :global(.rel-more:focus-visible) {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .entity p {
    margin-bottom: 1rem;
  }

  /* Stat tiles */
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.8rem;
  }

  .tiles :global(.tile) {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.8rem 0.9rem;
  }

