    width: 100%;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--ink);
    text-align: left;
    background: none;
    border: 0;
    border-radius: 6px;
    padding: 0.3rem 0.5rem;
    cursor: pointer;
  }

  .explorer :global(.control .picker-group-head:hover),
  .explorer :global(.control .picker-option:hover) {
    background: rgba(31, 31, 28, 0.05);
  }

  .explorer :global(.control .picker-option.is-current) {
    font-weight: 600;
    color: var(--accent);
  }

  .explorer :global(.control .picker-option:disabled) {
    color: var(--muted);
    opacity: 0.6;
    cursor: default;
  }

  .explorer :global(.control .picker-empty) {
    margin: 0.2rem 1rem 0.8rem;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .toggle legend {
    padding: 0;
    margin-bottom: 0.3rem;
  }


  /* Years: two handles on one track, the first and last years shown (explorer.ts showYears) */
  .years-control {
    min-width: min(22rem, 100%);
  }

  .years-slider {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.2rem;
  }

  .years-track {
    --a: 0;
    --b: 1;
    position: relative;
    flex: 1;
    min-width: 8rem;
    height: 16px;
  }

  .years-track::before,
  .years-fill {
    content: "";
    position: absolute;
    top: 6px;
    height: 4px;
    border-radius: 2px;
  }

  .years-track::before {
    left: 0;
    right: 0;
    background: var(--line);
  }

  .years-fill {
    left: calc(8px + (100% - 16px) * var(--a));
    right: calc(8px + (100% - 16px) * (1 - var(--b)));
    background: var(--accent);
  }

  .years-track input[type="range"] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 16px;
    margin: 0;
    background: none;
    pointer-events: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .years-track input[type="range"]::-webkit-slider-runnable-track {
    height: 16px;
    background: none;
  }

  .years-track input[type="range"]::-moz-range-track {
    background: none;
  }

  .years-track input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    pointer-events: auto;
    width: 16px;
    height: 16px;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
    cursor: pointer;
  }

  .years-track input[type="range"]::-moz-range-thumb {
    pointer-events: auto;
    width: 12px;
    height: 12px;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
    cursor: pointer;
  }

  .years-track input[type="range"]:focus-visible {
    outline: none;
  }

  .years-track input[type="range"]:focus-visible::-webkit-slider-thumb {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .years-track input[type="range"]:focus-visible::-moz-range-thumb {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .years-slider output {
    min-width: 7.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  .years-ends {
    display: flex;
    justify-content: space-between;
    margin-right: 8.1rem;
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--muted);
  }

  .toggle-options {
    display: flex;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--paper);
  }

  .toggle-options label {
    position: relative;
    cursor: pointer;
  }

  .toggle-options input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }

  .toggle-options span {
    display: block;
    padding: 0.45rem 0.8rem;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--ink-soft);
  }

  .toggle-options span span {
    display: inline;
    padding: 0;
    color: inherit;
  }

  .toggle-options label + label {
    border-left: 1px solid var(--line);
  }

  .toggle-options input:checked + span {
    background: var(--ink);
    color: var(--paper);
  }

  .toggle-options input:checked + span span {
    background: none;
  }

  .toggle-options input:focus-visible + span {
    outline: 2px dashed var(--accent);
    outline-offset: -4px;
  }

  /* View tabs: an underline marks the open view */
  /* The tabs stay at the top of the screen as the page scrolls */
  .view-tabs {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    gap: 0.25rem;
    margin-top: 1.4rem;
    padding-top: 0.35rem;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .view-tabs [role="tab"] {
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: none;
    border: 0;
    border-radius: 8px 8px 0 0;
    padding: 0.55rem 1rem;
    margin-bottom: -1px;
    cursor: pointer;
  }

  .view-tabs [role="tab"]:hover {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.55);
  }

  .view-tabs [role="tab"][aria-selected="true"] {
    color: var(--ink);
    box-shadow: inset 0 -3px 0 var(--accent);
  }

  .view-tabs [role="tab"]:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: -4px;
  }

  .view-tabs + #view-panel .controls {
    margin-top: 1rem;
  }

  .panels[hidden] {
    display: none;
  }

  .entity h2 {
    margin: 0 0 0.25rem;
  }

  /* Relations outline: the selected district's towns or town's districts, with tree lines */
  .relations {
    flex-basis: 100%;
    margin-top: 0.2rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .relations[hidden] {
    display: none;
  }

  .relations :global(.rel-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.6rem;
    margin-bottom: 0.25rem;
  }

  .relations :global(.rel-head strong) {
    color: var(--ink);
    font-size: 0.95rem;
  }

  .relations :global(.rel-note) {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .relations :global(.rel-tree) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .relations :global(.rel-tree li) {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.9rem;
    padding: 0.2rem 0 0.2rem 1.5rem;
    line-height: 1.45;
  }

  /* Tree lines: a trunk down the left, a branch to each row, the trunk stopping at the last */
  .relations :global(.rel-tree li::before) {
    content: "";
    position: absolute;
    left: 0.45rem;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--axis);
  }

  .relations :global(.rel-tree li:last-child::before) {
    bottom: calc(100% - 0.95rem);
  }

  .relations :global(.rel-tree li::after) {
    content: "";
    position: absolute;
    left: 0.45rem;
    top: 0.95rem;
    width: 0.7rem;
    border-top: 1px solid var(--axis);
  }

  .relations :global(.rel-name) {
    min-width: 11rem;
    color: var(--ink);
    font-weight: 500;
  }

  .relations :global(.rel-kind) {
    min-width: 6.5rem;
  }

  .relations :global(.rel-amt) {
    min-width: 6.5rem;
    font-variant-numeric: tabular-nums;
  }

  .relations :global(.rel-extra) {
    flex: 1 1 18rem;
    color: var(--muted);
  }

  .relations :global(.rel-more) {
    font: inherit;
    color: var(--accent);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .relations :global(.rel-more:focus-visible) {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .entity p {
    margin-bottom: 1rem;
  }

  /* Stat tiles */
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.8rem;
  }

  .tiles :global(.tile) {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.8rem 0.9rem;
  }

  .tiles :global(.tile-label) {
    font-size: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.3;
  }

  .tiles :global(.tile-value) {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0.2rem 0 0.15rem;
  }

  .tiles :global(.tile-detail) {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.35;
  }

  /* Panels */
  .panels {
    display: grid;
    /* minmax(0, …) so a wide open table scrolls inside its box instead of
       widening the column (and with it every chart) */
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    transition: opacity 0.2s ease;
  }

  .panel {
    position: relative;
    margin: 0;
    min-width: 0;
  }

  .panel h3 {
    margin-bottom: 0.15rem;
  }

  .panel-sub {
    font-size: 0.88rem;
    margin-bottom: 0.5rem;
  }

  /* In place of a chart the entity has no data for */
  .panel-none {
    font-size: 0.92rem;
    max-width: 72ch;
    padding: 0.8rem 1rem;
    border: 1px dashed var(--line);
    border-radius: 12px;
    color: var(--ink-soft);
  }

  #rev-body[hidden],
  .panel-none[hidden] {
    display: none;
  }

  /* The trend's yearly rise, beside its legend entry */
  .legend :global(.legend-detail) {
    margin-left: 0.35rem;
    color: var(--ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
    margin-bottom: 0.4rem;
  }

  .legend :global(li) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Stacked-chart legends are toggle buttons that isolate segments */
  .legend :global(.legend-btn),
  .legend :global(.legend-reset) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font: inherit;
    color: var(--ink-soft);
    background: none;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.15rem 0.55rem 0.15rem 0.45rem;
    margin-left: -0.45rem;
    cursor: pointer;
    transition: background 0.12s ease, border-color 0.12s ease, opacity 0.12s ease;
  }

  .legend :global(.legend-btn:hover) {
    border-color: var(--line);
    background: rgba(255, 255, 255, 0.7);
  }

  .legend :global(.legend-btn[aria-pressed="true"]) {
    color: var(--ink);
    border-color: var(--ink-soft);
    background: #fff;
  }

  .legend :global(.legend-btn.is-off) {
    opacity: 0.5;
  }

  .legend :global(.legend-btn:focus-visible),
  .legend :global(.legend-reset:focus-visible) {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  /* Line entries are on until clicked off; off, they fade and strike through */
  .legend :global(.legend-btn.legend-line[aria-pressed="true"]) {
    color: var(--ink-soft);
    border-color: transparent;
    background: none;
  }

  .legend :global(.legend-btn.legend-line:hover) {
    border-color: var(--line);
    background: rgba(255, 255, 255, 0.7);
  }

  .legend :global(.legend-line.is-off span:last-child) {
    text-decoration: line-through;
  }

  .legend :global(.legend-reset) {
    color: var(--accent);
    font-weight: 500;
    margin-left: 0;
  }

  .legend :global(.legend-reset:hover) {
    border-color: var(--line);
  }

  .panel :global(.key) {
    flex: none;
    display: inline-block;
  }

  .panel :global(.key.rect) {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: var(--c);
  }

  .panel :global(.key.line) {
    width: 16px;
    height: 2px;
    border-radius: 1px;
    background: var(--c);
  }

  .panel :global(.key.dash) {
    width: 16px;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--c) 0 5px, transparent 5px 8px);
  }

  .panel :global(.key.hatch) {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: repeating-linear-gradient(45deg, var(--c) 0 1px, transparent 1px 4px);
    box-shadow: inset 0 0 0 1px var(--axis);
  }

  .panel :global(.key.none) {
    width: 16px;
  }

  .panel svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: "Space Grotesk", sans-serif;
    touch-action: pan-y;
  }

  .panel svg:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .panel :global(.gridline) {
    stroke: var(--grid);
    stroke-width: 1;
  }

  .panel :global(.baseline) {
    stroke: var(--axis);
    stroke-width: 1;
  }

  .panel :global(.tick) {
    font-size: 12px;
    fill: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .panel :global(.cap),
  .panel :global(.end-label) {
    font-size: 12px;
    font-weight: 500;
    fill: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* A halo, so the latest value stays readable where a line passes behind it */
  .panel :global(.cap) {
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .panel :global(.band) {
    fill: var(--ink);
    opacity: 0.045;
  }

  .panel :global(.hit) {
    fill: transparent;
    cursor: crosshair;
  }

  .panel :global(.col) {
    transition: opacity 0.12s ease;
  }

  .panel :global(svg.has-hover .col:not(.is-hover)) {
    opacity: 0.55;
  }

  .panel :global(svg .col.faded),
  .panel :global(svg.has-hover .col.faded:not(.is-hover)) {
    opacity: 0.35;
  }

  .panel :global(.hatch-bg) {
    fill: var(--surface);
  }

  .panel :global(.hatch-line) {
    stroke: var(--ink-soft);
    stroke-width: 1.5;
  }

  /* Trend: dashed, on a paper-colored halo that keeps it legible across the columns */
  .panel :global(.trend-halo) {
    fill: none;
    stroke: var(--surface);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.85;
  }

  .panel :global(.trend-line) {
    fill: none;
    stroke-width: 2.25;
    stroke-dasharray: 7 5;
    stroke-linecap: round;
  }

  .panel :global(.overlay-line),
  .panel :global(.series-line) {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .panel :global(.dot) {
    stroke: var(--surface);
    stroke-width: 2;
  }

  .panel :global(.crosshair) {
    stroke: var(--axis);
    stroke-width: 1;
  }

  .panel :global(.hit),
  .panel :global(.overlay),
  .panel :global(.trend),
  .panel :global(.lines) {
    pointer-events: none;
  }

  .panel :global(.hit) {
    pointer-events: all;
  }

  /* Tooltip: value first, label after, line keys */
  .tooltip {
    position: absolute;
    z-index: 3;
    min-width: 13rem;
    max-width: min(25rem, calc(100% - 8px));
    padding: 0.6rem 0.75rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 8px 22px var(--shadow);
    pointer-events: none;
    font-size: 0.82rem;
  }

  .tooltip :global(.tip-title) {
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.3rem;
  }

  .tooltip :global(.tip-row) {
    display: grid;
    grid-template-columns: 16px auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5rem;
    line-height: 1.5;
  }

  .tooltip :global(.tip-value) {
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    text-align: right;
    min-width: 4.6rem;
  }

  .tooltip :global(.tip-label),
  .tooltip :global(.tip-title),
  .tooltip :global(.tip-note) {
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .tooltip :global(.tip-title) {
    color: var(--ink);
  }

  /* Keys sit beside the first line of a wrapped label */
  .tooltip :global(.tip-row .key) {
    align-self: start;
    margin-top: 0.55em;
  }

  .tooltip :global(.tip-row.strong) {
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.2rem;
    margin-bottom: 0.2rem;
  }

  .tooltip :global(.tip-note) {
    margin-top: 0.3rem;
    color: var(--muted);
  }

  /* Table view */
  .table-view {
    margin-top: 0.6rem;
    font-size: 0.85rem;
  }

  .table-view summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 500;
    width: max-content;
  }

  /* Full data table: a button that opens the overlay */
  .table-open {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.35rem;
    padding: 0;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .table-open:hover {
    color: var(--accent-2);
  }

  .table-open:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 3px;
  }

  .table-open-icon {
    font-size: 0.8rem;
    line-height: 1;
  }

  /* The overlay sizes to the table, past the page's central column, up to the
     viewport less a 16px margin; only very narrow screens still scroll */
  .table-dialog {
    margin: auto;
    width: fit-content;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 32px);
    padding: 0;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(31, 31, 28, 0.28);
  }

  .table-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .table-dialog::backdrop {
    background: rgba(31, 31, 28, 0.4);
  }

  .dialog-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 1.1rem 0.7rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .dialog-head h3 {
    margin: 0;
    font-size: 1.05rem;
    max-width: 60ch;
  }

  .dialog-close {
    flex: none;
    width: 2rem;
    height: 2rem;
    font: inherit;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--ink-soft);
    background: none;
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
  }

  .dialog-close:hover {
    border-color: var(--line);
    color: var(--ink);
  }

  .dialog-close:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .dialog-body.table-scroll {
    margin: 0;
    padding: 0 1.25rem 1rem;
    overflow: auto;
  }

  .table-dialog .dialog-body :global(table) {
    font-size: 0.82rem;
  }

  .table-dialog .dialog-body :global(thead th) {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--paper);
    min-width: 0;
    padding-top: 0.7rem;
    box-shadow: inset 0 -1px 0 var(--line);
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .table-dialog .dialog-body :global(th),
  .table-dialog .dialog-body :global(td) {
    padding: 0.3rem 0.4rem;
  }

  /* Comparison table: the report's layout and amber/teal shading */
  .compare-view :global(td.swatch-col),
  .compare-view :global(th.swatch-col) {
    width: 1.4rem;
    min-width: 0;
    padding-right: 0;
    text-align: center;
  }

  .compare-view :global(thead th.label-col) {
    text-align: left;
  }

  .compare-view :global(tr.total th),
  .compare-view :global(tr.total td) {
    border-top: 1px solid var(--ink-soft);
    font-weight: 600;
  }

  .compare-view :global(tbody th) {
    white-space: normal;
    min-width: 11rem;
  }

  .compare-view :global(td[title]) {
    cursor: help;
  }

  /* The note spans the table's width: it adds nothing to the box's width
     (width: 0) and stretches to fill it (min-width), but never past the
     visible scroll area (100cqw), where it stays put as the table scrolls. */
  .compare-view .table-scroll {
    container-type: inline-size;
  }

  .compare-view :global(.compare-box) {
    display: inline-block;
    vertical-align: top;
  }

  .compare-view :global(.compare-legend) {
    margin-top: 0.6rem;
    width: 0;
    min-width: min(100%, 100cqw);
    position: sticky;
    left: 0;
  }

  .compare-view :global(.compare-legend p) {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0.35rem 0 0;
    max-width: none;
  }

  .compare-view :global(.chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .compare-view :global(.chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .compare-view :global(.chip-box) {
    width: 1.6rem;
    height: 0.9rem;
    border-radius: 3px;
    box-shadow: inset 0 0 0 1px rgba(31, 31, 28, 0.08);
  }

  .explorer :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .table-scroll {
    overflow-x: auto;
    margin-top: 0.5rem;
  }

  .table-scroll :global(table) {
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .table-scroll :global(caption) {
    text-align: left;
    color: var(--ink-soft);
    padding-bottom: 0.4rem;
  }

  .table-scroll :global(th),
  .table-scroll :global(td) {
    padding: 0.25rem 0.6rem;
    border-bottom: 1px solid var(--grid);
    text-align: right;
  }

  .table-scroll :global(thead th) {
    color: var(--ink-soft);
    font-weight: 500;
    vertical-align: bottom;
    white-space: normal;
    min-width: 5.5rem;
  }

  .table-scroll :global(tbody th) {
    text-align: left;
    font-weight: 500;
  }

  /* Asks once, after the first change, whether to remember choices; never blocks the page */
  .remember-prompt {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 20;
    max-width: min(24rem, calc(100vw - 32px));
    padding: 1rem 1.1rem;
    font-size: 0.9rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 16px 40px rgba(31, 31, 28, 0.22);
  }

  .remember-prompt[hidden] {
    display: none;
  }

  .remember-prompt p {
    margin: 0 0 0.4rem;
  }

  .remember-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.7rem;
  }

  .remember-actions button {
    font: inherit;
    padding: 0.45rem 0.95rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
  }

  .remember-actions #remember-yes {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }

  .remember-actions button:focus-visible,
  .remember-note :global(.link-button:focus-visible) {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .remember-note :global(.link-button) {
    font: inherit;
    padding: 0;
    color: var(--accent);
    background: none;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  /* The notes have the Data tab to themselves, so no rule above them */
  .notes {
    margin-top: 1rem;
  }

  /* "above" rings the comparison menu: it pulses in and out, then stays, until the reader goes back */
  .control select:global(.beckon) {
    animation: beckon 1.4s ease-in-out 0.35s both;
  }

  @keyframes beckon {
    0%, 36%, 72% {
      box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px rgba(182, 92, 61, 0);
    }
    18%, 54%, 100% {
      box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px var(--accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .control select:global(.beckon) {
      animation: none;
      box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px var(--accent);
    }
  }

  /* Under the comparison menu, back to the table that sent the reader up; out of the flow, so the
     menu stays put */
  .control :global(.go-back) {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0;
    white-space: nowrap;
    font: inherit;
    font-size: 0.82rem;
    padding: 0;
    color: var(--accent);
    background: none;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }

  .explorer-footer {
    margin-top: 2.5rem;
    border-top: 1px solid var(--line);
    padding-top: 0.6rem;
  }

  .explorer-footer .remember-note {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0;
    max-width: none;
  }

  .notes p {
    font-size: 0.92rem;
  }

  .notes strong {
    color: var(--ink);
  }

  .explorer :global(.load-error) {
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .controls {
      padding: 0.75rem;
    }

    .control,
    .control select,
    .explorer :global(.control .picker-button) {
      width: 100%;
      min-width: 0;
    }

    .explorer :global(.control .picker-panel) {
      width: 100%;
    }

    .tiles :global(.tile-value) {
      font-size: 1.3rem;
    }

  }

  /* Commonwealth tab: a gallery of plots, each opening full screen */
  .cw-intro {
    max-width: 68ch;
    color: var(--ink-soft);
    margin: 0.4rem 0 1.2rem;
  }

  /* The Commonwealth tab's map (map.ts) */
  .explorer :global(.map-section) {
    position: relative;
    padding-top: 1.4rem;
    margin-bottom: 2.2rem;
  }

  .explorer :global(.map-title),
  .explorer .cw-plots-title {
    margin: 0 0 0.6rem;
  }

  .explorer :global(.map-controls) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.4rem;
    margin-bottom: 0.7rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .explorer :global(.map-seg) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .explorer :global(.map-seg-label),
  .explorer :global(.map-measure > span) {
    font-weight: 500;
    margin-right: 0.2rem;
  }

  .explorer :global(.map-seg-btn) {
    font: inherit;
    font-size: 0.82rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    cursor: pointer;
  }

  .explorer :global(.map-seg-btn[aria-pressed="true"]) {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }

  .explorer :global(.map-measure) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .explorer :global(.map-measure select) {
    font: inherit;
    font-size: 0.85rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.3rem 0.5rem;
  }

  .explorer :global(.map-about) {
    max-width: 80ch;
    line-height: 1.6;
    margin: 0 0 0.7rem;
  }

  .explorer :global(.map-figure) {
    position: relative;
    margin: 0;
  }

  .explorer :global(.map-legend) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  .explorer :global(.map-legend li) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .explorer :global(.map-swatch) {
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 3px;
    box-shadow: inset 0 0 0 1px rgba(31, 31, 28, 0.12);
  }

  .explorer :global(.map-swatch.nodata) {
    background: repeating-linear-gradient(45deg, #f4f1e8 0 3px, #bdb7aa 3px 5px);
  }

  .explorer :global(.map-svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .explorer :global(.map-town) {
    stroke: #fff;
    stroke-width: 1.2;
    stroke-linejoin: round;
    fill-rule: evenodd;
    cursor: pointer;
  }

  .explorer :global(.map-svg g:last-of-type .map-town) {
    stroke: var(--ink);
    stroke-width: 2.4;
  }

  .explorer :global(.map-tip) {
    position: absolute;
    z-index: 5;
    min-width: 11rem;
    max-width: 18rem;
    padding: 0.5rem 0.65rem;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 6px 18px var(--shadow);
    pointer-events: none;
  }

  .explorer :global(.map-table) {
    margin-top: 0.6rem;
    font-size: 0.85rem;
  }

  .explorer :global(.map-table summary) {
    color: var(--accent);
    cursor: pointer;
  }

  .explorer :global(.map-table table) {
    border-collapse: collapse;
    margin-top: 0.4rem;
  }

  .explorer :global(.map-table th),
  .explorer :global(.map-table td) {
    text-align: left;
    padding: 0.2rem 0.8rem 0.2rem 0;
    border-bottom: 1px solid var(--grid);
  }

  .explorer :global(.map-table .num) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .explorer :global(.map-source) {
    margin: 0.5rem 0 0;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .explorer :global(.cw-gallery) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 1rem;
  }

  .explorer :global(.cw-card) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-align: left;
    font: inherit;
    color: inherit;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.8rem;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .explorer :global(.cw-card:hover),
  .explorer :global(.cw-card:focus-visible) {
    border-color: var(--accent);
    box-shadow: 0 6px 18px var(--shadow);
    transform: translateY(-1px);
  }

  .explorer :global(.cw-thumb) {
    width: 100%;
    height: auto;
    aspect-ratio: 320 / 190;
    background: #fbf8f1;
    border-radius: 8px;
  }

  .explorer :global(.cw-card-title) {
    font-weight: 700;
    font-size: 1.02rem;
  }

  .explorer :global(.cw-card-blurb) {
    font-size: 0.86rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .explorer :global(.cw-card-axes) {
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: auto;
    padding-top: 0.2rem;
  }

  .explorer :global(.sc-grid line) {
    stroke: var(--grid);
  }

  .explorer :global(.sc-tick) {
    font-size: 11px;
    fill: var(--muted);
  }

  /* Axis titles name the measures: the first place a reader looks (scatter.ts TITLE_PX) */
  .explorer :global(.sc-title) {
    font-size: 15px;
    font-weight: 700;
    fill: var(--ink);
  }

  .explorer :global(.sc-pt) {
    stroke: #fff;
    stroke-width: 0.6;
  }

  .explorer :global(.sc-smooth) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
  }

  .explorer :global(.sc-smooth.mini) {
    stroke-width: 1.5;
  }

  .explorer :global(.sc-label) {
    font-size: 11.5px;
    font-weight: 700;
    fill: #8a3f22;
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 3px;
  }

  .explorer :global(.sc-leader) {
    stroke: #8a3f22;
    stroke-width: 0.8;
  }

  .explorer :global(.sc-ring) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    pointer-events: none;
  }

  .explorer :global(.cw-dialog) {
    width: 90vw;
    max-width: none;
    height: 94vh;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }

  .explorer :global(.cw-dialog[open]) {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .explorer :global(.cw-dialog::backdrop) {
    background: rgba(31, 31, 28, 0.45);
  }

  .explorer :global(.cw-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.2rem 0.4rem;
  }

  .explorer :global(.cw-title) {
    font-size: 1.35rem;
    margin: 0;
  }

  .explorer :global(.cw-close) {
    font-size: 1.6rem;
    line-height: 1;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--ink-soft);
    padding: 0.2rem 0.5rem;
  }

  .explorer :global(.cw-controls) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    align-items: end;
    padding: 0 1.2rem 0.8rem;
  }

  .explorer :global(.cw-field) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .explorer :global(.cw-field select),
  .explorer :global(.cw-field input) {
    font: inherit;
    font-size: 0.88rem;
    color: var(--ink);
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    max-width: min(30rem, 100%);
  }

  .explorer :global(.cw-check) {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    font-size: 0.84rem;
    color: var(--ink-soft);
    padding-bottom: 0.4rem;
  }

  .explorer :global(.cw-body) {
    position: relative;
    flex: 1;
    min-height: 0;
    padding: 0.6rem 1.2rem 0.8rem;
    overflow: hidden;
  }

  .explorer :global(.cw-figure) {
    position: relative;
    margin: 0;
    min-width: 0;
  }

  .explorer :global(.cw-head-tools) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .explorer :global(.cw-drawer-toggle),
  .explorer :global(.cw-more) {
    font: inherit;
    font-size: 0.85rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .explorer :global(.cw-drawer-toggle[aria-expanded="true"]) {
    border-color: var(--accent);
    background: #fbf1ec;
  }

  .explorer :global(.cw-settings) {
    border-bottom: 1px solid var(--line);
  }

  .explorer :global(.cw-settings > summary) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0 1.2rem 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    cursor: pointer;
    list-style: none;
  }

  .explorer :global(.cw-settings > summary::-webkit-details-marker) {
    display: none;
  }

  .explorer :global(.cw-settings > summary::before) {
    content: "";
    width: 6px;
    height: 6px;
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(-45deg);
    transition: transform 0.12s ease;
  }

  .explorer :global(.cw-settings[open] > summary::before) {
    transform: rotate(45deg);
  }

  .explorer :global(.cw-finding-row) {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-top: 0.3rem;
  }

  .explorer :global(.cw-finding) {
    flex: 1;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  /* The horizontal picker beside the chart, while the settings are open */
  /* The chart, the picker's edge (a handle to drag), and the picker at its chosen width */
  .explorer :global(.cw-body) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14px var(--picker-w, 330px);
    column-gap: 0.6rem;
  }

  .explorer :global(.cw-body.picker-closed) {
    grid-template-columns: minmax(0, 1fr) 14px 0;
  }

  .explorer :global(.cw-picker-handle) {
    position: relative;
    align-self: stretch;
    width: 14px;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: transparent;
    cursor: col-resize;
    touch-action: none;
  }

  /* A grip: two short bars, and a chevron when the list is shut */
  .explorer :global(.cw-picker-handle::before) {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4px;
    height: 36px;
    transform: translate(-50%, -50%);
    border-left: 1.5px solid var(--axis);
    border-right: 1.5px solid var(--axis);
  }

  .explorer :global(.cw-body.picker-closed .cw-picker-handle) {
    cursor: pointer;
    background: #f3eee3;
  }

  .explorer :global(.cw-body.picker-closed .cw-picker-handle::before) {
    width: 7px;
    height: 7px;
    border: solid var(--ink-soft);
    border-width: 0 0 1.5px 1.5px;
    transform: translate(-30%, -50%) rotate(45deg);
  }

  .explorer :global(.cw-picker-handle:hover),
  .explorer :global(.cw-picker-handle:focus-visible) {
    background: #efe7d8;
  }

  .explorer :global(.cw-picker) {
    min-height: 0;
    min-width: 0;
    overflow-y: auto;
    border-left: 1px solid var(--line);
    padding-left: 1rem;
  }

  .explorer :global(.cw-picker h3) {
    font-size: 1rem;
    margin: 0 0 0.2rem;
  }

  .explorer :global(.cw-picker-sub) {
    font-size: 0.74rem;
    line-height: 1.4;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }

  /* The Vertical label reads as a heading, like the Horizontal list's */
  .explorer :global(.cw-field-axis > span) {
    font-family: "Fraunces", serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
  }

  /* Cautions: the pitfalls a pair falls into, under the finding */
  .explorer :global(.cw-cautions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.45rem;
    margin-top: 0.35rem;
    font-size: 0.8rem;
  }

  .explorer :global(.cw-cautions-lead) {
    color: var(--ink-soft);
  }

  .explorer :global(.cw-caution) {
    font: inherit;
    font-size: 0.78rem;
    color: #8a3f22;
    background: #fbf1ec;
    border: 1px solid #ecc8b8;
    border-radius: 999px;
    padding: 0.12rem 0.6rem;
    cursor: pointer;
  }

  .explorer :global(.cw-caution::before) {
    content: "⚠ ";
  }

  .explorer :global(.cw-caution.quiet) {
    color: var(--ink-soft);
    background: #fff;
    border-color: var(--line);
  }

  .explorer :global(.cw-caution.quiet::before) {
    content: "";
  }

  /* A pair that counts the same thing: marked and set back in the Horizontal list */
  .explorer :global(.cw-bar.is-built) {
    color: var(--muted);
  }

  .explorer :global(.cw-built) {
    color: #8a3f22;
  }

  .explorer :global(.cw-bar:disabled) {
    cursor: default;
    color: var(--muted);
  }




  .explorer :global(.cw-sub) {
    width: min(760px, 94vw);
    max-width: none;
    max-height: 86vh;
    margin: auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .explorer :global(.cw-sub[open]) {
    display: flex;
    flex-direction: column;
  }

  .explorer :global(.cw-sub::backdrop) {
    background: rgba(31, 31, 28, 0.35);
  }

  .explorer :global(.cw-sub-body) {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0 1.2rem 1.2rem;
  }

  .explorer :global(.cw-sub-body .cap-steps-table) {
    margin: 0.2rem 0 0.9rem;
    font-size: 0.84rem;
  }

  .explorer :global(.cw-sub-body .cap-steps-table th),
  .explorer :global(.cw-sub-body .cap-steps-table td) {
    padding: 0.22rem 0.6rem;
  }

  .explorer :global(.cw-sub-body h4) {
    font-size: 0.95rem;
    margin: 1rem 0 0.3rem;
  }

  .explorer :global(.cw-sub-body h4:first-child) {
    margin-top: 0.2rem;
  }

  .explorer :global(.cw-sub-body p) {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 0.6rem;
  }

  .explorer :global(.cw-sub-note) {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0 0 0.6rem;
  }




  .explorer :global(.cw-bars-key) {
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
    display: grid;
    gap: 0.15rem;
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--ink-soft);
  }

  .explorer :global(.cw-bars-key li) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .explorer :global(.cw-bars-swatch) {
    flex: none;
    width: 12px;
    height: 6px;
    border-radius: 3px;
    background: #2a78d6;
  }

  .explorer :global(.cw-bars-swatch.neg) {
    background: #eb6834;
  }

