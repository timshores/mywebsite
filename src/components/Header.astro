---
const currentPath = Astro.url.pathname;
---

<header>
	<nav>
		<div class="nav-container">
			<a href="/" class="logo">Tim Shores</a>
			<ul class="nav-links">
				<li><a href="/" class={currentPath === '/' ? 'active' : ''}>About</a></li>
				<li><a href="/work" class={currentPath === '/work' ? 'active' : ''}>Work</a></li>
				<li><a href="/contact" class={currentPath === '/contact' ? 'active' : ''}>Contact</a></li>
			</ul>
		</div>
	</nav>
</header>

<style>
	header {
		border-bottom: 2px solid var(--color-border);
		background-color: var(--color-card);
		position: sticky;
		top: 0;
		z-index: 100;
		box-shadow: 0 2px 8px rgba(61, 50, 38, 0.08);
	}

	.nav-container {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 1.5rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-text);
		text-decoration: none;
	}

	.logo:hover {
		text-decoration: none;
		color: var(--color-accent);
	}

	.nav-links {
		list-style: none;
		display: flex;
		gap: 2rem;
		align-items: center;
	}

	.nav-links a {
		color: var(--color-text);
		font-weight: 500;
		text-decoration: none;
		transition: color 0.2s;
	}

	.nav-links a:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.nav-links a.active {
		color: var(--color-accent);
	}

	@media (max-width: 768px) {
		.nav-container {
			flex-direction: column;
			gap: 1rem;
			padding: 1rem;
		}

		.nav-links {
			gap: 1.5rem;
		}
	}
</style>
