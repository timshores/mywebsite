---
// A cartoon sash on the page card, linking to the school spending explorer: flat colour in three
// tones, a bold ink outline, chunky stitches, and outlined tabs where it folds over the card's
// edges. One set of definitions serves two drawings of it:
//
// - Across the card's top-right corner, where there is room for it. Drawn in the card's own
//   coordinates: the card's top-right corner is (0, 0), and the sash enters the top edge 370px
//   left of the corner and leaves the right edge 262px below it. The cloth is drawn flat along
//   the x axis, then turned onto that line, so its stripes and stitching run with the sash.
// - On a phone, where the name and headline fill the card's width, straight across the top of
//   the card instead, in the page's flow so it covers nothing.
const href = "/mass-school-spending/";
const label = "Now live: Mass. School Spending Explorer";
const words = "Now Live — Mass. School Spending Explorer";
// Lobster, a retro sign-painter script, loaded for these letters only
const font = `https://fonts.googleapis.com/css2?family=Lobster&display=swap&text=${encodeURIComponent(words)}`;
// The diagonal's centre line runs from (-A, 0) on the top edge to (0, B) on the right edge
const A = 370;
const B = 262;
const THICK = 68;
const angle = (Math.atan2(B, A) * 180) / Math.PI;
const mid = `translate(${-A / 2} ${B / 2}) rotate(${angle.toFixed(2)})`;
const half = THICK / 2;
// How far the folded tabs show past the card's edges
const WRAP = 9;
// The phone's straight sash
const FLAT = 50;
// Room around the corner for the tabs and the shadow
const PAD = 16;
const W = 450;
const H = 330;
---

<link rel="stylesheet" href={font} />

<svg class="sash-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <!-- A sticker's hard shadow, offset down and right -->
    <filter id="sash-shadow" x="-5%" y="-5%" width="115%" height="125%">
      <feDropShadow dx="3" dy="4" stdDeviation="0" flood-color="#3b1a10" flood-opacity="0.22" />
    </filter>
  </defs>
</svg>

<svg class="live-sash" viewBox={`${-W} ${-PAD} ${W + PAD} ${H + PAD}`} width={W + PAD} height={H + PAD}>
  <defs>
    <clipPath id="sash-card"><rect x={-W} y="0" width={W} height={H} /></clipPath>
    <clipPath id="sash-band"><rect transform={mid} x="-340" y={-half} width="680" height={THICK} /></clipPath>
    <clipPath id="sash-wrap">
      <rect x={-W} y={-WRAP} width={W} height={WRAP} />
      <rect x="0" y="0" width={WRAP} height={H} />
    </clipPath>
  </defs>
  <g filter="url(#sash-shadow)">
    <!-- The tabs where the sash folds over the card's top and right edges -->
    <g clip-path="url(#sash-band)">
      <g clip-path="url(#sash-wrap)">
        <rect x={-W} y={-PAD} width={W + PAD} height={H + PAD} class="sash-tab" />
      </g>
      <line x1={-W} x2="0" y1={-WRAP} y2={-WRAP} class="sash-ink" />
      <line x1={WRAP} x2={WRAP} y1="0" y2={H} class="sash-ink" />
    </g>
    <g clip-path="url(#sash-wrap)">
      <g transform={mid}>
        <line x1="-340" x2="340" y1={-half} y2={-half} class="sash-ink" />
        <line x1="-340" x2="340" y1={half} y2={half} class="sash-ink" />
      </g>
    </g>
    <a href={href} aria-label={label}>
      <g clip-path="url(#sash-card)">
        <g transform={mid}>
          <rect x="-340" y={-half} width="680" height={THICK} class="sash-base" />
          <rect x="-340" y={-half} width="680" height="15" class="sash-light" />
          <rect x="-340" y={half - 13} width="680" height="13" class="sash-dark" />
          <line x1="-340" x2="340" y1={-half + 8} y2={-half + 8} class="sash-stitch" />
          <line x1="-340" x2="340" y1={half - 8} y2={half - 8} class="sash-stitch" />
          <!-- Two gloss marks near the upper end -->
          <line x1="-162" x2="-140" y1={-half + 13} y2={-half + 13} class="sash-gloss" />
          <line x1="-133" x2="-126" y1={-half + 13} y2={-half + 13} class="sash-gloss" />
          <line x1="-340" x2="340" y1={-half} y2={-half} class="sash-ink" />
          <line x1="-340" x2="340" y1={half} y2={half} class="sash-ink" />
          <rect x="-340" y={-half} width="680" height={THICK} class="sash-hover" />
          <text x="0" y="8" text-anchor="middle" class="sash-text">{words}</text>
          <rect x="-205" y={-half + 4} width="410" height={THICK - 8} rx="6" class="sash-focus" />
        </g>
        <!-- The folds along the card's edges -->
        <g clip-path="url(#sash-band)">
          <line x1={-W} x2="0" y1="0" y2="0" class="sash-crease" />
          <line x1="0" x2="0" y1="0" y2={H} class="sash-crease" />
        </g>
      </g>
    </a>
  </g>
</svg>

<a class="live-sash-flat" href={href} aria-label={label}>
  <svg width="100%" height={FLAT + 6} aria-hidden="true" focusable="false">
    <svg x="0" y="0" width="100%" height={FLAT} overflow="visible" filter="url(#sash-shadow)">
      <rect width="100%" height={FLAT} class="sash-base" />
      <rect width="100%" height="11" class="sash-light" />
      <rect y={FLAT - 10} width="100%" height="10" class="sash-dark" />
      <line x1="0" x2="100%" y1="7" y2="7" class="sash-stitch" />
      <line x1="0" x2="100%" y1={FLAT - 7} y2={FLAT - 7} class="sash-stitch" />
      <rect width="100%" height={FLAT} class="sash-hover" />
      <text x="50%" y={FLAT / 2 + 7} text-anchor="middle" class="sash-text">{words}</text>
      <!-- The tabs past each side of the card, folded over its edges -->
      <rect x="0" y="0" width={WRAP} height={FLAT} class="sash-tab" />
      <line x1={WRAP} x2={WRAP} y1="0" y2={FLAT} class="sash-crease" />
      <svg x="100%" y="0" width="1" height={FLAT} overflow="visible">
        <rect x={-WRAP} y="0" width={WRAP} height={FLAT} class="sash-tab" />
        <line x1={-WRAP} x2={-WRAP} y1="0" y2={FLAT} class="sash-crease" />
      </svg>
      <rect width="100%" height={FLAT} class="sash-outline" />
    </svg>
  </svg>
</a>

<style define:vars={{ wrap: `${WRAP}px`, pad: `${PAD}px` }}>
  /* The card the sash sits on */
  :global(main:has(> .live-sash)) {
    position: relative;
  }

  .sash-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .live-sash {
    position: absolute;
    top: calc(-1 * var(--pad));
    right: calc(-1 * var(--pad));
    z-index: 3;
    overflow: visible;
    /* Only the cloth takes clicks; the portrait under the rest of the box stays live */
    pointer-events: none;
  }

  .live-sash a {
    pointer-events: auto;
    cursor: pointer;
  }

  .live-sash a:focus {
    outline: none;
  }

  /* Three flat tones and an ink line */
  .sash-base {
    fill: #d4532f;
  }

  .sash-light {
    fill: #ec7a4d;
  }

  .sash-dark {
    fill: #a93c1f;
  }

  .sash-tab {
    fill: #7d2914;
  }

  .sash-ink,
  .sash-outline {
    stroke: #3b1a10;
    stroke-width: 2.6;
    fill: none;
  }

  .sash-crease {
    stroke: #3b1a10;
    stroke-width: 2;
  }

  .sash-stitch {
    stroke: #fff4e2;
    stroke-width: 2;
    stroke-dasharray: 8 6;
    stroke-linecap: round;
  }

  .sash-gloss {
    stroke: #fff4e2;
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.85;
  }

  .sash-text {
    font-family: "Lobster", "Brush Script MT", cursive;
    font-size: 22px;
    fill: #fff6e6;
    paint-order: stroke;
    stroke: #3b1a10;
    stroke-width: 3.2px;
    stroke-linejoin: round;
  }

  .sash-hover {
    fill: #fff;
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .live-sash a:hover .sash-hover,
  .live-sash-flat:hover .sash-hover {
    opacity: 0.12;
  }

  .sash-focus {
    fill: none;
    stroke: none;
  }

  .live-sash a:focus-visible .sash-focus {
    stroke: #fff6e6;
    stroke-width: 2;
    stroke-dasharray: 4 3;
  }

  .live-sash-flat {
    display: none;
  }

  /* On a narrower card the sash shrinks about the card's corner */
  @media (max-width: 860px) {
    .live-sash {
      transform: scale(0.8);
      transform-origin: calc(100% - var(--pad)) var(--pad);
    }
  }

  /* On a phone it runs straight across the top of the card, over both side edges */
  @media (max-width: 640px) {
    .live-sash {
      display: none;
    }

    .live-sash-flat {
      display: block;
      margin: -0.45rem calc(-1.2rem - var(--wrap)) 0.9rem;
    }

    .live-sash-flat svg {
      display: block;
      overflow: visible;
    }

    .live-sash-flat .sash-text {
      font-size: min(19px, 4.7vw);
    }

    .live-sash-flat:focus-visible {
      outline: 2px dashed var(--accent);
      outline-offset: 2px;
    }
  }

  @media print {
    .live-sash,
    .live-sash-flat {
      display: none;
    }
  }
</style>
